  <diagram id="keyboard-hotkey-zh" name="键盘快捷键">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="k_title" value="键盘快捷键识别和执行流程" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="460" height="40" as="geometry"/></mxCell>
        <mxCell id="k_input" value="键盘 HID 事件&#xa;keytype + keycode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="90" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="k_handle" value="HOTKEY_Handle()&#xa;转入 KM_SYNC 快捷键检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="300" y="90" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="k_check" value="KM_SYNC_KB_Hotkey_Check(keytype, keycode)&#xa;快捷键状态机入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="620" y="90" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="k_mod" value="是否修饰键？&#xa;0xe0..0xe7" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="1030" y="70" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="k_state" value="按状态索引分发&#xa;KM_SYNC_Sync_KB_HotkeyInx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1290" y="90" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="k_s0" value="状态 0&#xa;等待快捷键起始键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="160" y="260" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="k_repeat" value="没有修饰键时&#xa;先检查重复按键逻辑&#xa;KM_SYNC_Repeat_Key_Handle()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="430" y="235" width="240" height="75" as="geometry"/></mxCell>
        <mxCell id="k_start" value="KM_SYNC_KB_Hotkey_Function_0_StartCheck()&#xa;检查是否进入快捷键模式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="430" y="330" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="k_lead" value="起始键 MAKE？&#xa;Pad* / ScrollLock / Pad+ / Pad-" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="800" y="285" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="k_capture" value="记录起始键&#xa;Hotkey_Queue[0]&#xa;Q_Size=1，状态=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="1120" y="295" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="k_s1" value="状态 1&#xa;等待第二个键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="160" y="500" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="k_second" value="KM_SYNC_KB_Hotkey_Function_1_SecondKeyMakeCheck()&#xa;解析第二个键的含义" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="430" y="490" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="k_save2" value="第二键 MAKE&#xa;Hotkey_Queue[1]&#xa;Q_Size++，状态=2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="850" y="485" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="k_leadtype" value="根据起始键分类" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="1160" y="480" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="k_star" value="Pad* 命令组&#xa;Pad1..4：强制跳端口&#xa;O：四屏漫游&#xa;S：单屏漫游&#xa;Pad0：同步模式&#xa;F9/F10：绝对/相对鼠标&#xa;F11：软重启&#xa;M：映射表 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="1450" y="370" width="250" height="165" as="geometry"/></mxCell>
        <mxCell id="k_plus" value="Pad+ + Pad1..4&#xa;添加同步端口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="1450" y="560" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="k_minus" value="Pad- + Pad1..4&#xa;清除同步端口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="1450" y="640" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="k_scroll" value="ScrollLock + 字母/Esc/Tab&#xa;设置重复按键模式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="1450" y="720" width="250" height="60" as="geometry"/></mxCell>
        <mxCell id="k_perform" value="KM_SYNC_KB_Hotkey_Function_Perform()&#xa;执行已经解析出的快捷键功能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1780" y="570" width="310" height="70" as="geometry"/></mxCell>
        <mxCell id="k_exec" value="按 KM_SYNC_Hotkey_Function[0]&#xa;选择具体动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1780" y="690" width="310" height="70" as="geometry"/></mxCell>
        <mxCell id="k_exec_list" value="JUMP：KM_SYNC_Force_Port_Jump()&#xa;ADD/CLEAR：KM_SYNC_Port_Add/Clear()&#xa;SYNC：KM_SYNC_Set_SyncMode()&#xa;ROAMING：API_Set_Roaming_Mode()&#xa;ABS/REL：API_Set_Mouse_Mode()&#xa;RESET：CPU_SoftReboot()&#xa;IAP：KVM_CONSOLE_IAP_Mode()&#xa;REPEAT：KM_SYNC_Handle_SetRepeatKey()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="1740" y="810" width="390" height="180" as="geometry"/></mxCell>
        <mxCell id="k_s2" value="状态 2&#xa;等待按键释放或第三键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="160" y="780" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="k_release" value="KM_SYNC_KB_Hotkey_Function_2_SecondKeyBreakCheck()&#xa;处理起始键/第二键释放，或新的第三键按下" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="460" y="775" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="k_release_detail" value="起始键释放：状态=3&#xa;第二键释放：状态=1&#xa;新按键按下：记录 Hotkey_Queue[2]，状态=3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="920" y="760" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="k_s3" value="状态 &gt;= 3&#xa;等待剩余按键释放并清理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="160" y="960" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="k_third" value="KM_SYNC_KB_Hotkey_Function_3_ThirdKeyCheck()&#xa;维护队列数量并清除已释放按键" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="460" y="955" width="370" height="70" as="geometry"/></mxCell>
        <mxCell id="k_empty" value="Q_Size 是否为 0？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="920" y="940" width="160" height="100" as="geometry"/></mxCell>
        <mxCell id="k_clear" value="KM_SYNC_KB_Hotkey_Clear()&#xa;状态回到 0&#xa;清空功能参数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="1180" y="950" width="230" height="80" as="geometry"/></mxCell>
