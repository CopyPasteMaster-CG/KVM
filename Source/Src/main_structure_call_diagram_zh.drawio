        <mxCell id="m_single" value="单端口模式&#xa;PORT0/1/2/3_ACTIVE&#xa;关闭漫游和同步&#xa;跳到映射端口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="780" y="430" width="240" height="90" as="geometry"/></mxCell>
