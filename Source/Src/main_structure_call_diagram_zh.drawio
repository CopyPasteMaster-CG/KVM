        <mxCell id="m_gpio" value="Check_Devcie_Gpio_Setting()&#xa;根据 GPIO/宏设置音频和存储能力" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="760" y="175" width="230" height="65" as="geometry"/></mxCell>
