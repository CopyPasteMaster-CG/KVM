        <mxCell id="m_isr" value="ISR_Init()&#xa;清空 ISR_FIFO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="760" y="35" width="170" height="55" as="geometry"/></mxCell>
