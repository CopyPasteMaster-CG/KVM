        <mxCell id="m_main" value="main/main.c&#xa;main() 入口函数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="90" width="170" height="70" as="geometry"/></mxCell>
