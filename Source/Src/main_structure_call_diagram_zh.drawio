  <diagram id="mouse-roaming-zh" name="鼠标位置和漫游">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p_title" value="鼠标当前位置判断和漫游跳转流程" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="520" height="40" as="geometry"/></mxCell>
        <mxCell id="p_input" value="USB 鼠标报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="100" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="p_ds" value="data_stream_generic.c&#xa;收到鼠标数据后调用&#xa;KM_SYNC_Abs_Mouse_Coordinate_Convert(mbuf)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="300" y="80" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="p_convert" value="KM_SYNC_Abs_Mouse_Coordinate_Convert(datacode)&#xa;把相对位移转换为绝对坐标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="670" y="90" width="310" height="70" as="geometry"/></mxCell>
        <mxCell id="p_x" value="X 位移为负？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="1100" y="70" width="130" height="90" as="geometry"/></mxCell>
        <mxCell id="p_y" value="Y 位移为负？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="1100" y="220" width="130" height="90" as="geometry"/></mxCell>
        <mxCell id="p_xleft" value="向左移动&#xa;设置 X_LEFT_MASK&#xa;MouseX 减小并限制到 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="1320" y="45" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="p_xright" value="向右移动&#xa;设置 X_RIGHT_MASK&#xa;MouseX 增加并限制到 X_MAX" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="1320" y="140" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="p_ytop" value="向上移动&#xa;设置 Y_TOP_MASK&#xa;MouseY 减小并限制到 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="1320" y="235" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="p_ybottom" value="向下移动&#xa;设置 Y_BOTTOM_MASK&#xa;MouseY 增加并限制到 Y_MAX" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="1320" y="330" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="p_send" value="API_Send_Mouse_Absolute()&#xa;把当前 MouseX/MouseY 提供给 API 回调" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="670" y="250" width="310" height="70" as="geometry"/></mxCell>
        <mxCell id="p_enabled" value="是否允许漫游？&#xa;MPASS_ACROSS_MODE&#xa;且 SYSTEM_MOUSE_SW_MASK 有效" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="700" y="390" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="p_pack" value="写回绝对鼠标报告&#xa;datacode[2..5] = MouseX/MouseY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="710" y="1090" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="p_edges" value="检查允许的边缘方向&#xa;由 KM_SYNC_Roaming_Edge 控制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1070" y="430" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="p_left" value="左边缘触发条件&#xa;MouseX == X_LEFT_EDGE&#xa;Coordinate_Cnt[0] 达到 Left.Latency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="1400" y="420" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="p_right" value="右边缘触发条件&#xa;MouseX == X_RIGHT_EDGE&#xa;Coordinate_Cnt[1] 达到 Right.Latency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="1400" y="510" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="p_top" value="上边缘触发条件&#xa;MouseY == Y_TOP_EDGE&#xa;Coordinate_Cnt[2] 达到 Up.Latency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="1400" y="600" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="p_bottom" value="下边缘触发条件&#xa;MouseY == Y_BOTTOM_EDGE&#xa;Coordinate_Cnt[3] 达到 Down.Latency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="1400" y="690" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="p_jump" value="KM_SYNC_Port_Jump_Power(current, direction, 1)&#xa;准备执行端口跳转" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1070" y="780" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="p_power" value="KM_SYNC_Power_Status_Check()&#xa;按方向查找可跳转端口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="710" y="780" width="260" height="65" as="geometry"/></mxCell>
        <mxCell id="p_portmap" value="KM_SYNC_Port()&#xa;根据 Roaming 映射表取得下一端口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="380" y="730" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="p_one3" value="是否一大三小模式？&#xa;且从主屏上下跳转" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="380" y="850" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p_attach" value="目标端口已连接？&#xa;检查 USBDC_UpPortState[nextport]" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="710" y="900" width="220" height="105" as="geometry"/></mxCell>
