              /*******************************************************************************
              * void USBHC_MSC_Port_Switch(U8_T devinx,U8_T newport)
              * Description    : Switch the MSC device
              * Input          :  
              * Output         : None.
              * Return         : None
              *******************************************************************************/ 
              void USBHC_MSC_Port_Switch(U8_T devinx, U8_T newport)
              {
                if (USBHC_MSC_Devinx == 0xff) 
                {
                  //printf("NO MSC Device found\n\r");
                  USBHC_MSC_Active_State = 0;
                  return;
                }
                
                if (KVM_CurrentMSC != newport)
                {
                  KVM_CurrentMSC_Next = newport;
                  USBHC_MSC_Active_State |= MSC_ACTIVE_SWITCH_START;  //stage 1 switch=>wiat for 3 seconds, check msc devi
             -ce status
                                              //if go into test unit ready status, then switch                              
                  if ((USBHC_MSC_Active_State & MSC_ACTIVE_START) == 0x00) //if the task is not start, prevent user change
             - again during the waitting time.
                  {
                    USBHC_MSC_Active_State |= MSC_ACTIVE_START; //task running
                    TASK_USBHC_MSC_Idle_Check_Active_ID = TASK_Active(TASK_TYPE_INTERVAL_MS,TASK_USBHC_MSC_Idle_Check_ID,0x
             -00,devinx,3000,3000);  //every 3 seconds check the idle state
                  }
                  
                  USBHC_MSC_Active_State &= ~(MSC_ACTIVE_BUSY|MSC_ACTIVE_TEST_UNIT_READY); // clear the busy flag first
                  USBHC_MSC_Active_State |= MSC_ACTIVE_SWITCH_WAIT1;
                }
              } 
              
              /*******************************************************************************
              * void TASK_USBHC_MSC_Idle_Check()
              * Description    : This task will check the MSC device condition every 3 seconds
              * Input          :  
              * Output         : None.
              * Return         : None
              *******************************************************************************/ 
              void TASK_USBHC_MSC_Idle_Check(void)
              {
                //U8_T  upper_devinx, hubportnumber;
                U8_T  devinx;
                
                devinx = TASK_Register0;
              
                //1.Check Device is valid to used
                if (USBHC_MSC_Devinx == 0xff) //no msc storage device dis-attached
                {
                  //printf("NO MSC Devcie, Switch Skip\n\r");
                  TASK_Destory_Current();
                  USBHC_MSC_Active_State = 0; //reset the start flag
                  return;
                }
                
C51 COMPILER V9.60.7.0   USBHC_MSC_BURST                                                   06/18/2026 10:50:20 PAGE 7   

                //2.if there is any read or write happenied during in last 3 seconds, then recheck again
                if (USBHC_MSC_Active_State & MSC_ACTIVE_BUSY)
                {
                  USBHC_MSC_Active_State &= ~(MSC_ACTIVE_BUSY|MSC_ACTIVE_TEST_UNIT_READY);
                  USB_PDevice[devinx].MSC->Switch_ErrCnt++; // switch control & state
                  if (USB_PDevice[devinx].MSC->Switch_ErrCnt > 2) // retry 3 times
                  {
                    //printf("MSC Switch ERROR\n\r");
                    TASK_Destory_Current();
                    USB_PDevice[devinx].MSC->Switch_ErrCnt=0; // switch control & state
                    USBHC_MSC_Active_State = 0;
                    //Error Message to Buffer
              #if (KVM_BUZZER_SUPPORT)
                    BUZZER_Script_Active(MSC_Switch_Error);
              #endif
                  }
                  //Wait for next 3000 ms or 250ms
                  return;
                }
              
                //3.Get into stage 2(if no test unit ready command happenied?)
                if (USBHC_MSC_Active_State & MSC_ACTIVE_SWITCH_WAIT1)
                {
                  if ((USBHC_MSC_Active_State & MSC_ACTIVE_BUSY) == 0x00) // possible the msc has been remove by user,
                  {
              #if (KVM_BUZZER_SUPPORT)
                    BUZZER_Script_Active(MSC_Switch_Sound);
              #endif
                    //start switch:
                    if ((USBHC_MSC_Active_State & MSC_ACTIVE_TEST_UNIT_READY) == 0x00) // possible the msc has been remove 
             -by user,
                    {       
                      USBHC_MSC_Switch_Stage_1();
                      TASK_Destory_Current();
                      USBHC_MSC_Active_State = 0;
                      USBHC_MSC_Bulk_State_Reset(USBHC_MSC_Devinx);
                    }
                    else
                    {       
                      USBHC_MSC_Active_State &= ~MSC_ACTIVE_TEST_UNIT_READY; // possible the msc has been remove by user,
                      USBHC_MSC_Active_State |= MSC_ACTIVE_TIME_UP; // time is up inform the MSC UNIT
                    }
                  }
                  else
                  {
                    USBHC_MSC_Active_State &= ~(MSC_ACTIVE_TEST_UNIT_READY|MSC_ACTIVE_BUSY); // possible the msc has been r
             -emove by user,
                  }
                  return;
                }
              }
              
              /*******************************************************************************
              * void USBHC_MSC_Switch_Stage_1(void)
              * Description    : Stage 1 for switch the kvm port
              * Input          :  
              * Output         : None.
              * Return         : None
              *******************************************************************************/ 
              void USBHC_MSC_Switch_Stage_1(void)
              {
                //1.Get releative information.
C51 COMPILER V9.60.7.0   USBHC_MSC_BURST                                                   06/18/2026 10:50:20 PAGE 8   

                
                //2.Clean the DC register
                USBDC_REGS_Device_Reset(KVM_CurrentMSC, USBHC_MSC_Devinx);
                
                //2.Dismount the device from virtual DC
              #if (SYSTEM_EXTENDER_RECEIVER)
                if (KVM_CurrentMSC == REMOTE_HOST_PORT)
                {
                  Externder_Receiver_DeviceMount_Control(USBHC_MSC_Devinx, VDEV_UNMOUNT, EXTENDER_USB_UNMOUNT);
                }
              #endif //#if (SYSTEM_EXTENDER_RECEIVER)
                
                USBHC_MSC_Umount_Report();
              
                //4.Set the HD ATL TD Skip Map    
                USBHC_CORE_SetBit(TD_ATL_Skip_Map,USB_HC_MSC_BURST_OUT_TD0,0x01); 
                USBHC_CORE_SetBit(TD_ATL_Skip_Map,USB_HC_MSC_BURST_OUT_TD1,0x01);
                USBHC_CORE_SetBit(TD_ATL_Skip_Map,USB_HC_MSC_BURST_IN_TD0,0x01);  
                USBHC_CORE_SetBit(TD_ATL_Skip_Map,USB_HC_MSC_BURST_IN_TD1,0x01);  
                USBHC_Write_Regs(HC_ATL_TDSKIP_MAP_REG,TD_ATL_Skip_Map,4);
                
                //5.Reset the control flag
                USBHC_MSC_Active_State &= ~MSC_ACTIVE_SWITCH_WAIT1; //no wait 1 stage
                USBHC_MSC_Active_State |= MSC_ACTIVE_SWITCH_WAIT2;  //wait for another 250ms then switch
                
                //6.Wait another 250ms, then switch to new port   
                Task_Active_Table[TASK_USBHC_MSC_Idle_Check_Active_ID].Task_Interval.w  = 250;
                Task_Active_Table[TASK_USBHC_MSC_Idle_Check_Active_ID].Task_Reload.w  = 250;
              }
              
              /*******************************************************************************
              * void USBHC_MSC_Umount_Report(void)
              * Description    : Report to PC, device has been remove
              * Input          :  
              * Output         : None.
              * Return         : None
              *******************************************************************************/ 
              void USBHC_MSC_Umount_Report(void)
              {
                U8_T upper_devinx;
                U8_T hubportnumber;
              
                //1.Get releative information.
              #if (SYSTEM_EXTENDER_RECEIVER)
                if (KVM_CurrentMSC != REMOTE_HOST_PORT)     
              #endif  /*  #if (SYSTEM_EXTENDER_RECEIVER) */ 
                {
                  USBHC_Get_Upper_Device_Info(USBHC_MSC_Devinx,&upper_devinx,&hubportnumber);
                
                  if (hubportnumber >= USBDC_VHUB_PORT_NUM)
                  {
                    //printf("Umount:Target Port(%d) Error, Fixed with%d\n\r",(U16_T)hubportnumber,(U16_T)USBHC_HubPortNumb
             -er);
                    USBDC_Device[USBHC_MSC_Devinx].VirHubNum[KVM_CurrentMSC] = USBHC_HubPortNumber + 1;
                    hubportnumber = USBDC_VHUB_PORT_NUM - 1;
                  }   
                  //2.Dismount the device from virtual DC
                  USBDC_Virtual_Hub_DeviceMount_Control(upper_devinx, hubportnumber, VDEV_UNMOUNT, MOUNT_PORT[KVM_CurrentM
             -SC], USBHC_MSC_Devinx);     
                }
              
                if (KVM_CurrentMSC != KVM_CurrentMSC_Next)
C51 COMPILER V9.60.7.0   USBHC_MSC_BURST                                                   06/18/2026 10:50:20 PAGE 9   

                {
                  KVM_CurrentMSC = KVM_CurrentMSC_Next;
                  KVM_CurrentMSC_Next |= BIT7;
                  USBDC_Maintain_MSC_PDevice(KVM_CurrentMSC);
                }
                
              }  
              
              /*******************************************************************************
              * U8_T USBHC_MSC_DC_Burst_Out_Handle(U8_T devinx)
              * Description    : Handle the MSC DC Burst Out Event
              * Input          :  
              * Output         : None.
              * Return         : None
              *******************************************************************************/ 
              U8_T USBHC_MSC_DC_Burst_Out_Handle(U8_T devinx)
              {
                //Check the Error Condition
                if (USBHC_MSC_Device_Error_Condition_Check(devinx))
                {
                  return 1; //clear the DC complete state
                }
              
                USBHC_MSC_BOT_DC_Data_Out_Handle(devinx);
              
                if (USB_PDevice[devinx].MSC->BURST_Out_State & (BURST_ERROR|BURST_COMPLETE))
                {
                  //if burst handle is error or complete
                  USB_PDevice[devinx].MSC->BURST_Out_State &= ~(BURST_ERROR|BURST_COMPLETE); //clear the complete & error 
             -flag
                  return 1;
                }
                return 0;
              }
              
              /****************************************************************************
               * void USBHC_MSC_DC_Burst_In_Handle(U8_T devinx)
               *
               * @brief  Handle the Data In of BOT in DC side
               * @param  
               * @retval none
               */
              U8_T USBHC_MSC_DC_Burst_In_Handle(U8_T devinx)
              {
                U8_T    bulk_td;
                U8_T    next_td;
                RESULT  Result = USB_SUCCESS;
                U16_T len;
              
                //Handle the Burst Mode IN Event
                bulk_td = USBHC_MSC_UpstreamInTD-USB_HC_MSC_START;
                USB_PDevice[devinx].MSC->BURST_In_State &= ~(USBHC_MSC_Burst_Used[bulk_td]|USBHC_MSC_Burst_Done[bulk_td])
             -; //clear the used and done flag first
              
                if (USB_PDevice[devinx].MSC->BURST_In_State & BURST_IN_WAIT)
                {
                  USB_PDevice[devinx].MSC->BURST_In_State &= ~BURST_IN_WAIT;
                  next_td = USBHC_MSC_GetNext_PingPongIn_TD(bulk_td);   
              
                  if ((USB_PDevice[devinx].MSC->BURST_In_State & USBHC_MSC_Burst_Done[next_td])) //if next is done by HC
                  {
                    USBHC_MSC_BOT_Check_Next_In(devinx, next_td); //This statement must put in here, after assign the right
C51 COMPILER V9.60.7.0   USBHC_MSC_BURST                                                   06/18/2026 10:50:20 PAGE 10  

             - length of next CBW
              
                    if (USB_PDevice[devinx].MSC->BOT_State == MSC_BOT_DATA_IN)
                    { 
                      if (USB_PDevice[devinx].MSC->Control.Total_Length > MSC_Class_Page_Size)
                      {
                        len = MSC_Class_Page_Size;
                      } 
                      else
                      {
                        len = USB_PDevice[devinx].MSC->Control.Total_Length;        
                      }
                      USBHC_MSC_PingPongIn_ID = bulk_td + USB_HC_MSC_START;
                      USBHC_MSC_Bulk_TD_Header(devinx, bulk_td, MSC_BOT_DATA_IN, len);
                      USB_PDevice[devinx].MSC->BURST_In_State |= USBHC_MSC_Burst_Used[bulk_td]; // In TD in Used            
                    }       
                    else if (USB_PDevice[devinx].MSC->BOT_State == MSC_BOT_CSW_REQUEST)
                    {
                      USBHC_MSC_PingPongIn_ID = bulk_td + USB_HC_MSC_START;
                      USBHC_MSC_BOT_Send_CSW_Request(devinx,bulk_td);
                    }
                  }
                }
                return Result;
              }
              
              /*******************************************************************************
              * void USBHC_MSC_EnableCurrentBurstTD(U8_T burst_state,U8_T td_id)
              * Description    : According to the data direction, assing current burst HC TD to DC
              * Input          :  
              * Output         : None.
              * Return         : None
              *******************************************************************************/ 
              void USBHC_MSC_EnableCurrentBurstTD(U8_T burst_state,U8_T td_id)
              {
                U8_T  endpinx;
                U8_T  *buf;
                U32_T iaddr;
              
                //Assign Burst TD Buffer to DC Endp Buffer
                buf = HCTD_Table.BULK[td_id].Buf;
                //Assing Buffer address into DC EPCFGR
                iaddr = buf;
                if (burst_state == MSC_BOT_DATA_OUT)
                {
                  endpinx  = USB_PDevice[USBHC_MSC_Devinx].MSC->Out_Endpinx & 0x0f;
                }
                else
                {
                  endpinx  = USB_PDevice[USBHC_MSC_Devinx].MSC->In_Endpinx & 0x0f;
                }
              
                USBDC_Index[KVM_CurrentMSC][USBHC_MSC_Devinx][endpinx].Endp_Addr_Lsb = iaddr & 0x00ff;  // endpoint addre
             -ss
                USBDC_Index[KVM_CurrentMSC][USBHC_MSC_Devinx][endpinx].Endp_Addr_Msb = (iaddr & 0xff00) >> 8;  // endpoin
             -t address
                USBDC_EndpBufPtr[KVM_CurrentMSC][USBHC_MSC_Devinx][endpinx] = buf;
              }
               
              /*******************************************************************************
              * void USBHC_MSC_EnableNextBurstTD(U8_T burst_state)
              * Description    : According to the data direction, assing next burst HC TD to DC
C51 COMPILER V9.60.7.0   USBHC_MSC_BURST                                                   06/18/2026 10:50:20 PAGE 11  

              * Input          :  
              * Output         : None.
              * Return         : None
              *******************************************************************************/ 
              U8_T USBHC_MSC_EnableNextBurstTD(U8_T burst_state)
              {
                U8_T pingpong;
              
                if (burst_state == MSC_BOT_DATA_OUT)
                {
                  if (USBHC_MSC_PingPongOut_ID == USB_HC_MSC_BURST_OUT_TD0)
                    pingpong = USB_HC_MSC_BURST_OUT_TD1;
                  else
                    pingpong = USB_HC_MSC_BURST_OUT_TD0;
              
                  USBHC_MSC_PingPongOut_ID = pingpong;
              
                  //Assign Burst TD Buffer to DC Endp Buffer
                  USBHC_MSC_EnableCurrentBurstTD(burst_state, USBHC_MSC_PingPongOut_ID -USB_HC_MSC_START);
                }
                else
                {
                  if (USBHC_MSC_PingPongIn_ID == USB_HC_MSC_BURST_IN_TD0)
                    pingpong = USB_HC_MSC_BURST_IN_TD1;
                  else
                    pingpong = USB_HC_MSC_BURST_IN_TD0;
              
                  USBHC_MSC_PingPongIn_ID = pingpong;
              
                  //Assign Burst TD Buffer to DC Endp Buffer
                }
                return (pingpong - USB_HC_MSC_START);
              }
               
              /*******************************************************************************
              * void USBHC_MSC_Get_Burst_Length_From_DC(U8_T bulk_td)
              * Description    : Check DC out buffer byte0,1 to get length
              * Input          :  
              * Output         : None.
              * Return         : None
              *******************************************************************************/ 
              void USBHC_MSC_Get_Burst_Length_From_DC(U8_T devinx,U8_T bulk_td)
              {
                U8_T  package_cnt;
                U16_T len;
              
                /* The first 2 bytes is length */
                len  = ((U16_T)(HCTD_Table.BULK[bulk_td].Buf[1] & 0x03) << 8) + (U16_T)(HCTD_Table.BULK[bulk_td].Buf[0]);
                
                /* Part of high byte is package count */
                package_cnt = (HCTD_Table.BULK[bulk_td].Buf[1] & 0xfc) >> 2;
                
                /* Check package count and re-calculate length */
                if (package_cnt > 1)
                {
                  len = ((package_cnt - 1) * USB_HC_SINGLE_BULK_BUF_SIZE) + len;
                }
              
                USB_PDevice[devinx].MSC->Control.Data_Length = len;
              }
              
              /*******************************************************************************
C51 COMPILER V9.60.7.0   USBHC_MSC_BURST                                                   06/18/2026 10:50:20 PAGE 12  

              * void USBHC_MSC_Set_DC_Burst_Length(U8_T burst_td,U16_T burstlen)
              * Description    : Set correct burst mode length into DC Buffer
              * Input          :  
              * Output         : None.
              * Return         : None
              *******************************************************************************/ 
              void USBHC_MSC_Set_DC_Burst_Length(U8_T burst_td,U16_T burstlen)
              {
                U16_T len;
                
                //For next Burst Mode Data Length
                if (burstlen > MSC_Class_Page_Size)
                {
                  len = MSC_Class_Page_Size;
                }
                else
                {
                  len = burstlen;
                }
                USBHC_MSC_Length_To_Buf(HCTD_Table.BULK[burst_td].Buf,len); 
              }
              
              
              /*******************************************************************************
              * U8_T USBHC_MSC_Device_Error_Condition_Check(U8_T devinx)
              * Description    : Check the msc device error condition
              * Input          :  
              * Output         : None.
              * Return         : None
              *******************************************************************************/ 
              U8_T USBHC_MSC_Device_Error_Condition_Check(U8_T devinx)
              {
                //Check the Error Condition
                if ((USB_PDevice[devinx].Addr & USBHC_DEVICE_USED_MASK) == 0x00)   
                {
                   //printf("MSC ERROR:Device not exist\n\r");
                   return 1;
                } 
                
                //if DC is unplug
                if ((USBDC_UpPortState[KVM_CurrentMSC] & USBDC_ROOTHUB_ATTACHED_MASK) == 0x00)  
                {
                  /*BURST_DEBUG*/
                  //printf("MSC ERROR:Not attached\n\r");
                  return 2;
                }   
              
              #if (SYSTEM_EXTENDER_RECEIVER)    
                if (KVM_CurrentMSC == REMOTE_HOST_PORT)
                { 
                  if ((Remote_Mount_State & BIT_MASK[devinx]) == 0)   
                  {
                    //printf("Mounstate=%02bx,Skip(%bu)\n\r",Remote_Mount_State,devinx);
                    return 3; //have not mount, just skip, but how is the 
                  }
                }
              #endif      
                return 0; 
              }
              
              /*******************************************************************************
              * void USBHC_MSC_Flush_DC_Buffer(U8_T port,U8_T devinx,U8_T endpinx)
C51 COMPILER V9.60.7.0   USBHC_MSC_BURST                                                   06/18/2026 10:50:20 PAGE 13  

              * Description    : Flush DC buffer
              * Input          :  
              * Output         : None.
              * Return         : None
              *******************************************************************************/ 
              void USBHC_MSC_Flush_DC_Buffer(U8_T port,U8_T devinx,U8_T endpinx)
              {
                endpinx = (DA_CR_IN_CLEAR | (endpinx & 0x07));
                USBDC_INT_DISABLE;
                switch (port)
                {
                  case 0:
                    _USBDC_DC0DR_SFR(endpinx);
                    _USBDC_DC0CIR_SFR(DA_CR[devinx]);
                    break;
                  case 1:
                    _USBDC_DC1DR_SFR(endpinx);
                    _USBDC_DC1CIR_SFR(DA_CR[devinx]);
                    break;
                  case 2:
                    _USBDC_DC2DR_SFR(endpinx);
                    _USBDC_DC2CIR_SFR(DA_CR[devinx]);
                    break;
                  case 3:
                    _USBDC_DC3DR_SFR(endpinx);
                    _USBDC_DC3CIR_SFR(DA_CR[devinx]);
                    break;
                }
                USBDC_INT_ENABLE;
              }
              
              /*----------------------------------------------------------------------------
               * void USBHC_MSC_VHUB_ResetUpdate(void)
               * Purpose:
               * Params:  NONE
               * Returns: NONE
               * Note:
               *----------------------------------------------------------------------------
               */
              void USBHC_MSC_VHUB_ResetUpdate(void)
              {
                if (VHUB_MSC_Reset_Flag)
                {           
              #if (SYSTEM_EXTENDER_RECEIVER)          
                  if (KVM_CurrentMSC != REMOTE_HOST_PORT)
              #endif /* #if (SYSTEM_EXTENDER_RECEIVER) */           
                  {
                    USBDC_REGS_Address_Active(VHUB_MSC_Reset_Port, USBHC_MSC_Devinx, RESET);
                    USBDC_REGS_Address_Write(VHUB_MSC_Reset_Port , USBHC_MSC_Devinx, 0x00);
                    USBDC_VIRTUAL_Active_Device(USBHC_MSC_Devinx, MOUNT_PORT[VHUB_MSC_Reset_Port]);
                  } 
                    
                  USBDC_VIRTUAL_Setup_DataStageIn(VHUB_MSC_Reset_HubDevinx,VHUB_MSC_Reset_Port,0);
                  USBDC_Device[VHUB_MSC_Reset_HubDevinx].VHub->PortStatus[VHUB_MSC_Reset_Port][VHUB_MSC_Reset_HubPort].wPo
             -rtChangeL |= L_PortChange_Reset; //report connection change   
                  USBDC_VHub_Update_StatusChange(VHUB_MSC_Reset_HubDevinx,VHUB_MSC_Reset_Port,VHUB_MSC_Reset_Port,0);         
             -    
                  VHUB_MSC_Reset_Flag = 0;      
                }       
              }
              
              /*----------------------------------------------------------------------------
C51 COMPILER V9.60.7.0   USBHC_MSC_BURST                                                   06/18/2026 10:50:20 PAGE 14  

               * void USBHC_MSC_GetNext_PingPongOut(void)
               * Purpose:
               * Params:  NONE
               * Returns: NONE
               * Note:
               *----------------------------------------------------------------------------
               */
              U8_T USBHC_MSC_GetNext_PingPongOut(U8_T current_pingpong)
              {
                U8_T next_pingpong;
                
                if (current_pingpong == USB_HC_MSC_BURST_OUT_TD0)
                  next_pingpong = USB_HC_MSC_BURST_OUT_TD1;
                else
                  next_pingpong = USB_HC_MSC_BURST_OUT_TD0;
                
                return next_pingpong;
              }
              
              /*----------------------------------------------------------------------------
               * U8_T USBHC_MSC_PingPongOut_UseState(U8_T check_td)
               * Purpose:
               * Params:  NONE
               * Returns: NONE
               * Note:
               *----------------------------------------------------------------------------
               */
              U8_T USBHC_MSC_PingPongOut_UseState(U8_T pingpong_id)
              {
                U8_T bulktd;
                
                bulktd = pingpong_id - USB_HC_MSC_START; //Get the BULK TD index
                if (USB_PDevice[USBHC_MSC_Devinx].MSC->BURST_Out_State & USBHC_MSC_Burst_Used[bulktd])
                  return 1; //yes, in used
                return 0; //no, not in used
              }
              
              /*----------------------------------------------------------------------------
               * U8_T USBHC_MSC_Next_PingPongOut_UseState(U8_T check_td)
               * Purpose:
               * Params:  NONE
               * Returns: NONE
               * Note:
               *---------------------------------------------------------------------------*/
              U8_T USBHC_MSC_Next_PingPongOut_UseState(U8_T pingpon_id)
              {
                U8_T next_pingpong; 
                
                next_pingpong = USBHC_MSC_GetNext_PingPongOut(pingpon_id);
                return (USBHC_MSC_PingPongOut_UseState(next_pingpong)); 
              }
              
              /*----------------------------------------------------------------------------
               * U8_T USBHC_MSC_Next_PingPongOut_UseState(U8_T check_td)
               * Purpose:
               * Params:  NONE
               * Returns: NONE
               * Note:
               *---------------------------------------------------------------------------*/
              void USBHC_MSC_Set_CurrentPingPongOut_Used(U8_T devinx)
              {
                U8_T bulk_td; 
C51 COMPILER V9.60.7.0   USBHC_MSC_BURST                                                   06/18/2026 10:50:20 PAGE 15  

                
                bulk_td = USBHC_MSC_PingPongOut_ID - USB_HC_MSC_START; //Get the BULK TD index
                USB_PDevice[devinx].MSC->BURST_Out_State |= (USBHC_MSC_Burst_Used[bulk_td]);  
              }   
              
              /*----------------------------------------------------------------------------
               * void USBHC_MSC_Length_To_Buf(U8_T *buf,U16_T iLen)
               * Purpose:
               * Params:  NONE
               * Returns: NONE
               * Note:
               *---------------------------------------------------------------------------*/
              void USBHC_MSC_Length_To_Buf(U8_T *buf,U16_T iLen)
              {
                buf[0] = (U8_T)(iLen & 0x00FF);
                buf[1] = (U8_T)((iLen & 0x0300) >> 8);
              }
              
              /*----------------------------------------------------------------------------
               * U8_T USBHC_MSC_GetNext_PingPongIn_TD(U8_T pingpong_id)
               * Purpose:
               * Params:  NONE
               * Returns: NONE
               * Note:
               *---------------------------------------------------------------------------*/
              U8_T USBHC_MSC_GetNext_PingPongIn_TD(U8_T bulk_td)
              {
                U8_T next_td;
                
                if (bulk_td == (USB_HC_MSC_BURST_IN_TD0 - USB_HC_MSC_START))
                  next_td = USB_HC_MSC_BURST_IN_TD1 - USB_HC_MSC_START;
                else
                  next_td = USB_HC_MSC_BURST_IN_TD0 - USB_HC_MSC_START;
                
                return next_td;
              }
              
              /*----------------------------------------------------------------------------
               * U8_T USBHC_MSC_GetNext_PingPongOut_TD(U8_T pingpong_id)
               * Purpose:
               * Params:  NONE
               * Returns: NONE
               * Note:
               *---------------------------------------------------------------------------*/
              U8_T USBHC_MSC_GetNext_PingPongOut_TD(U8_T bulk_td)
              {
                U8_T next_td;
                
                if (bulk_td == (USB_HC_MSC_BURST_OUT_TD0 - USB_HC_MSC_START))
                  next_td = USB_HC_MSC_BURST_OUT_TD1 - USB_HC_MSC_START;
                else
                  next_td = USB_HC_MSC_BURST_OUT_TD0 - USB_HC_MSC_START;
                
                return next_td;
              }     
