              /****************************************************************************
               * @brief  USBHC_MSC_Init
               *         Init the USB HC interface MSC Class
               * @param  None
               * @retval None
               */
              void USBHC_MSC_Init(void)
              {
                USBHC_MSC_Device_Cnt = 0;
                USBHC_MSC_Devinx     = 0xff;
                USBHC_MSC_State    = 0;
                USBHC_MSC_Reset_Flag = 0;
              
                TASK_USBHC_MSC_Idle_Check_ID = TASK_Create(TASK_USBHC_MSC_Idle_Check);
              
              #if (SYSTEM_TASK_DUMP_SUPPORT)
                printf("TASK_USBHC_MSC_Idle_Check_ID=%bu\n\r",TASK_USBHC_MSC_Idle_Check_ID);
              #endif  
              }
              
              /*******************************************************************************
              * Function Name  : USBHC_MSC_Class_Verify(U8_T devinx)
              * Description    : Verify the MSC Class Protocol Support
              * Input          :  
              * Output         : None.
              * Return         : None
              *******************************************************************************/
              RESULT USBHC_MSC_Class_Verify(U8_T devinx)
              {
              #if (USB_HC_MSC_BOT_SUPPORT)
                U8_T  inf_inx;
C51 COMPILER V9.60.7.0   USBHC_MSC_BURST                                                   06/18/2026 10:50:20 PAGE 3   

              
                //Check Protcol used
                //2-1 BOT Protocol(Bulk Only)(Assume subclass is scsi)
                for (inf_inx = 0; inf_inx < (USB_PDevice[devinx].InterfaceNum & USBHC_DEVICE_INTERFACENUM_MASK); inf_inx+
             -+)
                {
                  if (USB_PDevice[devinx].InfProtocol[inf_inx] == MSC_BULK_ONLY_TRANSPORT)
                  {
                    return USB_SUCCESS;
                  }
                }
              #endif
                return USB_ERROR; 
              }
              
              /**************************************************************************************************
              * vod USBHC_MSC_Bulk_TD_Header(U8_T devinx,U8_T atl_id,U16_T total_byte)    
              * Description    : Fill up the Bulk TD Header 
              * Input          :  
              * Output         : None.
              * Return         : None
              ***************************************************************************************************/
              void USBHC_MSC_Bulk_TD_Header(U8_T devinx,U8_T atl_id,U8_T direction,U16_T total_byte)
              {
                U8_T  toggle_bit;
                U8_T  endpinx;
              #if (SYSTEM_EXTENDER_RECEIVER)  
                U8_T    active_bit=TD_ACTIVED_MASK;
                U8_T    skip_bit=0x00;
              #endif  
              
                //1.Clear Actual Bytes
                HCTD_Table.BULK[atl_id].TD.Byte0_Actual_Byte = 0;
                HCTD_Table.BULK[atl_id].TD.Byte1 = 0;
              
                //2.(1).Active
                //  (2).Data Toggle 
                //  (3).Endp Direction
                HCTD_Table.BULK[atl_id].TD.Byte5 = 0;
                
                if (direction == MSC_BOT_DATA_OUT) // Data Out
                {
                  if (USB_PDevice[devinx].MSC->Toggle_Out)
                  {
                    toggle_bit = TD_TOGGLE_DATA1;
                    USB_PDevice[devinx].MSC->Toggle_Out = 0;
                  }
                  else
                  {
                    toggle_bit = TD_TOGGLE_DATA0;
                    USB_PDevice[devinx].MSC->Toggle_Out = 1;
                  }
                  HCTD_Table.BULK[atl_id].TD.Byte5 |= TD_DIR_TOKEN_OUT;
                  endpinx = USB_PDevice[devinx].MSC->Out_Endpinx;
                }
                else
                {
                  if (USB_PDevice[devinx].MSC->Toggle_In)
                  {
                    toggle_bit = TD_TOGGLE_DATA1;
                    USB_PDevice[devinx].MSC->Toggle_In = 0;
                  }
C51 COMPILER V9.60.7.0   USBHC_MSC_BURST                                                   06/18/2026 10:50:20 PAGE 4   

                  else
                  {
                    toggle_bit = TD_TOGGLE_DATA0;
                    USB_PDevice[devinx].MSC->Toggle_In = 1;
                  }
                  HCTD_Table.BULK[atl_id].TD.Byte5 |= TD_DIR_TOKEN_IN;
                  endpinx = USB_PDevice[devinx].MSC->In_Endpinx;
                }
                  
                //Adjust the length
                if (total_byte > MSC_Class_Page_Size)
                {
                  total_byte = MSC_Class_Page_Size;
                }
                else
                { 
                  //2015-11-04 add, prevent if host issue a BULK IN, but MSC asnwr CSW mean no data, so need to check if t
             -he last length small than 64, 
                  //then let the lenght equal to 64 to cause DATA under run
                  if (direction == MSC_BOT_DATA_IN) // Data IN
                  { 
                    /*-----------------------------------*/
                    if (total_byte < USB_HC_ATL_BUF_SIZE)
                    { 
                      total_byte = USB_HC_ATL_BUF_SIZE;
                    } 
                    /*-----------------------------------*/ 
                  } 
                } 
                
                HCTD_Table.BULK[atl_id].TD.Byte4_Total_Byte = total_byte & 0x00ff;
                HCTD_Table.BULK[atl_id].TD.Byte5       |= (total_byte & 0x0300) >> 8;
                HCTD_Table.BULK[atl_id].TD.Byte2_MaxPKT_Size = USB_HC_ATL_BUF_SIZE;
                
                //3.(1).Endp address
                //  (2).Speed type(Full Speed)
                HCTD_Table.BULK[atl_id].TD.Byte3 = (USBDC_Device[devinx].EndpAddr[endpinx] & 0x0f) << 4;
                //4.Totaol byte
              
                //5.(1)Error Count(ingore)
                
                //6.Device Address  
                HCTD_Table.BULK[atl_id].TD.Byte6_Function_Address = USB_PDevice[devinx].Addr & USBHC_DEVICE_ADDR_MASK;
                
                //7.NAK counter
                HCTD_Table.BULK[atl_id].TD.Byte7 = 0xFE; //not to pulling foreever
              
                //8.Active
              #if (SYSTEM_EXTENDER_RECEIVER)  
                if (ExtenderR_TD_Skip_Active_Flag)
                {
                  active_bit = 0;   
                  skip_bit   = 1;
                } 
                HCTD_Table.BULK[atl_id].TD.Byte1 = (COMPLETEION_CODE_MASK | active_bit | toggle_bit);
                USBHC_CORE_SetBit(TD_ATL_Skip_Map,(atl_id+USB_HC_MSC_START),skip_bit);
                USBHC_Write_Regs(HC_ATL_TDSKIP_MAP_REG, TD_ATL_Skip_Map, 4);
              #else
                HCTD_Table.BULK[atl_id].TD.Byte1 = (COMPLETEION_CODE_MASK | TD_ACTIVED_MASK | toggle_bit);
                USBHC_CORE_SetBit(TD_ATL_Skip_Map,(atl_id+USB_HC_MSC_START),0x00);
                USBHC_Write_Regs(HC_ATL_TDSKIP_MAP_REG, TD_ATL_Skip_Map, 4);
              #endif        
C51 COMPILER V9.60.7.0   USBHC_MSC_BURST                                                   06/18/2026 10:50:20 PAGE 5   

              }
              
