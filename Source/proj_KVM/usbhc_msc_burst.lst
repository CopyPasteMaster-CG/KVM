              /*******************************************************************************
              * void USBHC_MSC_Bulk_State_Reset(U8_T devinx)
              * Description    : Reset the Bulk Handle status
              * Input          :  
              * Output         : None.
              * Return         : None
              *******************************************************************************/
              void USBHC_MSC_Bulk_State_Reset(U8_T devinx)
              {
                USB_PDevice[devinx].MSC->BOT_State = MSC_BOT_IDLE;
                USB_PDevice[devinx].MSC->BURST_Out_State = 0;
                USB_PDevice[devinx].MSC->BURST_In_State = 0;
              #if (SYSTEM_EXTENDER_RECEIVER)    
                EXTENDER_MSC_BurstOutWait_Flag = 0;
              #endif
                
              #if (SYSTEM_EXTENDER_TRANSMITTER) 
                EXTENDER_MSC_BurstOutWait_Clear_Flag = 0;
              #endif  
                USBHC_MSC_State = 0;  
              }
              
