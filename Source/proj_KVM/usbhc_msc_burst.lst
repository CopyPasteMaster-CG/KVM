                HCTD_Channel_Table[USB_HC_ATL_START+USB_HC_MSC_BURST_OUT_TD1].Used_DeviceID = (USBHC_TD_USED_MASK | devin
             -x);
                HCTD_Channel_Table[USB_HC_ATL_START+USB_HC_MSC_BURST_IN_TD0].Used_DeviceID = (USBHC_TD_USED_MASK | devinx
             -);
                HCTD_Channel_Table[USB_HC_ATL_START+USB_HC_MSC_BURST_IN_TD1].Used_DeviceID = (USBHC_TD_USED_MASK | devinx
