 196          /*******************************************************************************
 197          * Function Name  : USBDC_VHid_Class_GetReport.
 198          * Description    : for SETUP command only support Set Report,Get 
 199          * Input          : None.
 200          * Output         : None.
 201          * Return         : None.
 202          *******************************************************************************/
 203          RESULT USBDC_VHid_Class_GetReport(U8_T devinx,U8_T port)
 204          { 
 205   1        RESULT Result=USB_UNSUPPORT;
 206   1      
 207   1        if (wValue_H==0x03) //EP0_IN
 208   1        {
 209   2          if (wIndex_L == 0x01) // interface 1=>Mouse Interface
 210   2          {
 211   3            USBDC_Device[devinx].Ctrl_TotalByte[port] = 3; // report back 3 byte for standard mouse report
 212   3            USBDC_Device[devinx].Ctrl_CurrentByte[port] = 0;
 213   3            USBDC_Device[devinx].Control_EndpBuf[port] = &DATAST_Generic_USB_MS_Report[1];
 214   3          }
 215   2          Result=USB_SUCCESS;
 216   2        }
 217   1        else if (wValue_H==0x01) //INT_IN
 218   1        {
 219   2          USBDC_Device[devinx].Ctrl_TotalByte[port] = 0; // report back 3 byte for standard mouse report
 220   2          USBDC_Device[devinx].Ctrl_CurrentByte[port] = 0;
 221   2          USBDC_Device[devinx].Control_EndpBuf[port] = &DATAST_Generic_USB_MS_Report[1];
 222   2          Result=USB_SUCCESS; // return nothing
 223   2        }
 224   1        
 225   1        return Result;
 226   1      }
