 228          /*******************************************************************************
C51 COMPILER V9.60.7.0   USBDC_VHID                                                        06/23/2026 16:04:45 PAGE 5   

 229          * Function Name  : USBDC_VHid_Resume_Check(U8_T port,U8_T devinx)
 230          * Description    : Will check the HID device is ready for sending ot data
 231          * Input          :  
 232          * Output         : None.
 233          * Return         : None
 234          *******************************************************************************/
 235          FlagStatus USBDC_VHid_Resume_Check(U8_T port,U8_T devinx)
 236          {
 237   1        if ((USBDC_Device[devinx].Feature[port] & FEATURE_SUSPEND)== FEATURE_SUSPEND)
 238   1        {   
 239   2          if ((USBDC_Device[devinx].Feature[port] &FEATURE_REMOTE)== FEATURE_REMOTE)
 240   2          {
 241   3            USBDC_Port_Resume(port);
 242   3          }
 243   2          return SET;
 244   2        }
 245   1      
 246   1        if (USBDC_Device[devinx].Feature[port] & FEATURE_RESUME)
 247   1        {
 248   2          return SET;
 249   2        }
 250   1      
 251   1        return RESET;
 252   1      }
 253          
 254          /*******************************************************************************
 255          * RESULT USBDC_VHid_Valid_Check(U8_T port,U8_T devinx)
 256          * Description    : Will check the HID device is ready for sending ot data
 257          * Input          :  
 258          * Output         : None.
 259          * Return         : None
 260          *******************************************************************************/
 261          RESULT USBDC_VHid_Valid_Check(U8_T port,U8_T devinx)
 262          {
 263   1        if (USBDC_Device[devinx].DevAddr[port] == 0x00)
 264   1        {
 265   2          return USB_ERROR;
 266   2        }
 267   1        
 268   1        if ((USBDC_Device[devinx].Feature[port] & (FEATURE_SUSPEND|FEATURE_REMOTE)) == FEATURE_SUSPEND)
 269   1        {
 270   2          return USB_ERROR;
 271   2        }
 272   1        
 273   1        return USB_SUCCESS;
 274   1      }
