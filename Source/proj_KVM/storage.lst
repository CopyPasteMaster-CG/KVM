  52          /*
  53           *--------------------------------------------------------------------------------
  54           * void  STORAGE_CRC_Calculate(U8_T *pSource)
  55           * Purpose : Caulate the CRC value for KVM_Flash
  56           * Params  : $pSource : the source buffer pointer
  57           * Returns : Return the checksum.
  58           * Note    : None.
  59           *--------------------------------------------------------------------------------
  60           */
  61          U16_T  STORAGE_CRC_Calculate(U8_T *pSource)
  62          {
  63   1        U32_T cksum = 0;
  64   1        U16_T i, length;
  65   1        U8_T *inChar = pSource;
  66   1        U16_T *point, *pBuf;
  67   1      
  68   1        length = sizeof(KVM_Flash);
  69   1          pBuf = (U16_T *)pSource;
  70   1        for (i = 0; i < (length/2); i++)
  71   1        {
  72   2          point = pBuf;
  73   2          cksum += *pBuf++;
  74   2          if (point > pBuf)
  75   2            (*inChar) = *inChar + 1;
  76   2      
  77   2          if (!(i % 0x8000))
  78   2          {
  79   3            cksum = (cksum >> 16) + (cksum & 0xffff);
  80   3            cksum += (cksum >> 16);
  81   3            cksum &= 0xffff;
  82   3          }
  83   2        }
  84   1          
  85   1        if (length % 2)
  86   1          cksum += (*pBuf & 0xff00);
  87   1      
  88   1        cksum = (cksum >> 16) + (cksum & 0xffff);
  89   1        cksum += (cksum >> 16);
  90   1        cksum &= 0xffff;
  91   1      
  92   1        return ((U16_T)cksum);
  93   1      }
  94          
