 204          void STORAGE_Init_Read(U16_T readlen,U8_T *readbuf,U8_T partition)
 205          {
 206   1        U16_T index;
 207   1        U32_T addr;
 208   1        
 209   1        switch (partition)
 210   1        {
 211   2          case 0:
 212   2            addr = STORAGE_START_PRIMARY_ADDRESS;
 213   2            break;
 214   2          case 1:
 215   2            addr = STORAGE_START_SECONDARY_ADDRESS;
 216   2            break;
 217   2          case 2:
 218   2            addr = STORAGE_START_THIRDARY_ADDRESS;
 219   2            break;
 220   2          case 3:
 221   2            addr = STORAGE_START_FOURTH_ADDRESS;
 222   2            break;
 223   2          default:
 224   2            printf("Wrong partition number!\n\r");
 225   2            return;
 226   2        }
 227   1      
C51 COMPILER V9.60.7.0   STORAGE                                                           06/23/2026 16:04:43 PAGE 5   

 228   1        for (index = 0 ; index < readlen ; index++)
 229   1        {
 230   2          *(readbuf + index) = FCVAR(U8_T, addr + index);
 231   2        }
 232   1      }
