 235          /*
 236           *--------------------------------------------------------------------------------
 237           * void STORAGE_Write(U16_T writelen,U8_T *writebuf) 
 238           * Purpose : Write data into flash
 239           * Params  : $writelen: data length for writting
 240           *           $writebuf: the data buffer for writting
 241           * Returns : None.
 242           * Note    : None.
 243           *--------------------------------------------------------------------------------
 244           */
 245          void STORAGE_Write(U16_T writelen,U8_T *writebuf)
 246          {
 247   1        KVM_Flash.CRC_Check = 0;
 248   1        KVM_Flash.CRC_Check = ~STORAGE_CRC_Calculate(writebuf);
 249   1      
 250   1      #if (SYSTEM_STORAGE_FLASH)
 251   1        if (FLASH_SectorErase())
 252   1        {
 253   2          if (writelen & 0x7)
 254   2          {
 255   3            writelen = (writelen & 0xFFF8) + 8;
 256   3          }
 257   2          DMA_DataToProgram(STORAGE_START_PRIMARY_ADDRESS, (U32_T)writebuf & 0xFFFF, writelen);
 258   2          DMA_DataToProgram(STORAGE_START_SECONDARY_ADDRESS, (U32_T)writebuf & 0xFFFF, writelen);
 259   2          DMA_DataToProgram(STORAGE_START_THIRDARY_ADDRESS, (U32_T)writebuf & 0xFFFF, writelen);
 260   2          DMA_DataToProgram(STORAGE_START_FOURTH_ADDRESS, (U32_T)writebuf & 0xFFFF, writelen);
 261   2          STORAGE_AvailablePartitionMap = 0x0F;
 262   2        }
 263   1      #endif //#if (SYSTEM_STORAGE_FLASH)
 264   1      }
