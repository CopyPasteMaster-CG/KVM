 266          /*
 267           *--------------------------------------------------------------------------------
 268           * void STORAGE_SoftwareConfigurationCheck(U8_T houseKeeping) 
 269           * Purpose : Check all software configuration partitions on flash
 270           * Params  : $houseKeeping : run this routine for house keeping
 271           * Returns : None.
 272           * Note    : None.
 273           *--------------------------------------------------------------------------------
 274           */
 275          void STORAGE_SoftwareConfigurationCheck(U8_T houseKeeping)
 276          {
 277   1        U8_T        partition;
 278   1        U8_T        availableCnt = 0;
 279   1        struct _KVM_Flash *pFlash;
 280   1        
 281   1        if (houseKeeping)
 282   1        {
 283   2          pFlash = &KVM_FlashTemporary;
 284   2        }
 285   1        else
 286   1        {
 287   2          pFlash = &KVM_Flash;
 288   2        }
 289   1        
C51 COMPILER V9.60.7.0   STORAGE                                                           06/23/2026 16:04:43 PAGE 6   

 290   1        for (partition = 0; partition < 4; partition++)
 291   1        {
 292   2          if (STORAGE_AvailablePartitionMap & (0x01 << partition))
 293   2          {
 294   3            STORAGE_Init_Read(sizeof(KVM_Flash),(U8_T *)pFlash, partition);
 295   3            if (0xFFFF != STORAGE_CRC_Calculate((U8_T *)pFlash) || pFlash->Total_Length != sizeof(KVM_Flash))
 296   3            {
 297   4              STORAGE_AvailablePartitionMap &= ~(0x01 << partition);
 298   4            }
 299   3            else if (houseKeeping)
 300   3            {
 301   4              availableCnt++;
 302   4            }
 303   3            else
 304   3            {
 305   4              if (availableCnt == 0)
 306   4              {
 307   5                memcpy((U8_T *)&KVM_FlashTemporary, pFlash, sizeof(KVM_Flash));
 308   5              }
 309   4              availableCnt++;
 310   4            }
 311   3          }
 312   2        }
 313   1      
 314   1        if (houseKeeping == 0)
 315   1        {
 316   2          if ((STORAGE_AvailablePartitionMap & 0x08) == 0)
 317   2          {
 318   3            if (availableCnt)
 319   3            {
 320   4              memcpy(pFlash, (U8_T *)&KVM_FlashTemporary, sizeof(KVM_Flash));
 321   4            }
 322   3            else
 323   3            {
 324   4              STORAGE_Default_Initial();
 325   4            }
 326   3          }
 327   2        }
 328   1        
 329   1        if (availableCnt < 2)
 330   1        {
 331   2          STORAGE_Write(sizeof(KVM_Flash),(U8_T *)&KVM_Flash);
 332   2        }
 333   1      }
