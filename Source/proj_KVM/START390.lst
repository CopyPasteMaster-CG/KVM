                          6     ;  Startup code for CPU, Contigious Mode
                          7     ;------------------------------------------------------------------------------
                          8     ;  START390.A51:  This code is executed after processor reset.
                          9     ;  You may add this file to a uVision2 project.
                         10     ;
                         11     ;  To translate this file use A51 with the following invocation:
                         12     ;
                         13     ;     AX51 START390.A51 MOD_CONT
                         14     ;
                         15     ;  To link the modified STARTUP.OBJ file to your application use the following
                         16     ;  LX51 invocation:
                         17     ;
                         18     ;     LX51 <your object file list>, START390.OBJ <controls>
                         19     ;
                         20     ;------------------------------------------------------------------------------
                         21     ;
                         22     ;------------------------------------------------------------------------------
                         23     ;
                         24     ;  CPU Read Protection Setting
                         25     ;
                         26     ;  Bit7=1 : Disable Flash protection mode ;
                         27     ;  Bit7=0 : Enable Flash protection mode */
 0000                    28     PROG_PROTECTION EQU             00H             ; the CPU program read protection mode.
                         29     ;
                         30     ;------------------------------------------------------------------------------
                         31     ;
                         32     ;  User-defined Power-On Initialization of Memory
                         33     ;
                         34     ;  With the following EQU statements the initialization of memory
                         35     ;  at processor reset can be defined:
                         36     ;
                         37     ;               ; the absolute start-address of IDATA memory is always 0
 0080                    38     IDATALEN        EQU     80H     ; the length of IDATA memory in bytes.
 0030                    39     FLAGADDR0       EQU     30H
                         40     ;
 0000                    41     XDATASTART      EQU     0H      ; the absolute start-address of XDATA memory
 8000                    42     XDATALEN        EQU     8000H   ; the length of XDATA memory in bytes.
                         43     ;
 0000                    44     PDATASTART      EQU     0H      ; the absolute start-address of PDATA memory
 0000                    45     PDATALEN        EQU     0H      ; the length of PDATA memory in bytes.
                         46     ;
                         47     ;  Notes:  The IDATA space overlaps physically the DATA and BIT areas of the
                         48     ;          8051 CPU. At minimum the memory space occupied from the C51 
                         49     ;          run-time routines must be set to zero.
                         50     ;------------------------------------------------------------------------------
                         51     ;
                         52     ;  Reentrant Stack Initilization
                         53     ;
                         54     ;  The following EQU statements define the stack pointer for reentrant
                         55     ;  functions and initialized it:
                         56     ;
AX51 MACRO ASSEMBLER  START390                                                              06/18/26 10:50:16 PAGE     2

                         57     ;  Stack Space for reentrant functions in the SMALL model.
 0000                    58     IBPSTACK                EQU     0       ; set to 1 if small reentrant is used.
 00FF                    59     IBPSTACKTOP             EQU     0FFH    ; set top of stack to highest location+1.
                         60     ;
                         61     ;  Stack Space for reentrant functions in the LARGE model.      
 0001                    62     XBPSTACK                EQU     1       ; set to 1 if large reentrant is used.
 7EFF                    63     XBPSTACKTOP             EQU     07EFFH  ;set top of stack to highest location.
                         64     ;
                         65     ;  Stack Space for reentrant functions in the COMPACT model.    
 0000                    66     PBPSTACK                EQU     0       ; set to 1 if compact reentrant is used.
 7EFF                    67     PBPSTACKTOP             EQU     07EFFH  ; set top of stack to highest location+1.
                         68     ;
                         69     ;------------------------------------------------------------------------------
                         70     ;
                         71     ;  Page Definition for Using the Compact Model with 64 KByte xdata RAM
                         72     ;
                         73     ;  The following EQU statements define the xdata page used for pdata
                         74     ;  variables. The EQU PPAGE must conform with the PPAGE control used
                         75     ;  in the linker invocation.
                         76     ;
 0000                    77     PPAGEENABLE     EQU     0       ; set to 1 if pdata object are used.
 00F4                    78     PPAGE           EQU     0F4H    ; define PPAGE number. 
                         79     ;
                         80     ;------------------------------------------------------------------------------
