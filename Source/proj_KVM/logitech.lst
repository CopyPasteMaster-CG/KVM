  78   1        USBDC_Device[devinx].DevAttr[port] &= ~UNIFYING_RPT_CHECK_MASK;
  79   1        if (memcmp(DataBuffer,UNIFYING_Switch_HID_Command,3)==0) //switch command
  80   1        {
  81   2          if(DataBuffer[3]) //if set to DJ
  82   2          {
  83   3            USBDC_Device[devinx].DevAttr[port] |= UNIFYING_RPT_MODE_MASK; //DJ Mode
  84   3            DJ_mode = UNIFYING_RPT_MODE_MASK;
  85   3          }
  86   2          else
  87   2          {
  88   3            USBDC_Device[devinx].DevAttr[port] &= ~UNIFYING_RPT_MODE_MASK; //HID Mode
  89   3            DJ_mode = 0;
  90   3          }
  91   2          
  92   2          if (USBDC_Device[devinx].PassThroughState[port])
  93   2          {
  94   3            USB_PDevice[devinx].DevAttr &= ~UNIFYING_RPT_MODE_DJ;
  95   3            USB_PDevice[devinx].DevAttr |= DJ_mode; //update HC mode
  96   3          }
  97   2        }
  98   1        else if ((DataBuffer[0]== 0x10)&& (DataBuffer[2]== 0x0f) && ((DataBuffer[3] & 0xf0) == 0x20))
  99   1        {
 100   2          if ((DataBuffer[4] & 0x0f) == 0x09) //=>HIDPP mode
 101   2          {
 102   3            USBDC_Device[devinx].DevAttr[port] |= UNIFYING_RPT_SIZE_MASK; //HIDPP Mode
C51 COMPILER V9.60.7.0   LOGITECH                                                          06/23/2026 16:04:47 PAGE 3   

 103   3            DJ_mode = UNIFYING_RPT_SIZE_MASK;
 104   3          }
