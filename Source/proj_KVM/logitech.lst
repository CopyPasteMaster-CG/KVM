  45          RESULT USBDC_Unifying_SetReport_Cmd_Check(U8_T port,U8_T devinx,U8_T report_id)
  46          {
  47   1        if (report_id == 0x10)
  48   1        {
  49   2          if (USBDC_Device[devinx].Setup[port].b.wLength.w == 7)
  50   2          {
  51   3            USBDC_Device[devinx].DevAttr[port] |= UNIFYING_RPT_CHECK_MASK;
  52   3          }
  53   2        }
  54   1        else if (report_id == 0x20) //DJ Mode
  55   1        {
  56   2          if (USBDC_Device[devinx].Setup[port].b.wLength.w == 15)
  57   2          { 
  58   3            USBDC_Device[devinx].DevAttr[port] |= UNIFYING_RPT_CHECK_MASK;
  59   3            if (port != KVM_CurrentHost)
  60   3            {
  61   4              return USB_SUCCESS;
  62   4            }
  63   3          }
  64   2        }
  65   1        return USB_WAIT;
  66   1      }
