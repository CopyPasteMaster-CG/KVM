                  pid = atoi(&UartStr[1][1]);
                  if (KVM_Flash.cSystemFlag1 & SYSTEM_PLUGIN_JUMP_MODE)
                  { 
                    if (pid ==0)
                    {
                      KVM_Flash.cSystemFlag1 &= ~SYSTEM_PLUGIN_JUMP_MODE;
                      flash_write=1;    
C51 COMPILER V9.60.7.0   UARTX_CONSOLE                                                     06/23/2026 16:04:47 PAGE 12  

                      UARTx_PutStr("Once");       
                    }       
                  }
                  else
                  {
                    if (pid ==1)
                    {
                      flash_write=1;
                      KVM_Flash.cSystemFlag1 |= SYSTEM_PLUGIN_JUMP_MODE;
                      UARTx_PutStr("Always");       
                      if ((USBDC_UpPortState[KVM_CurrentHost] & USBDC_ROOTHUB_ATTACHED_MASK) == 0X00)
                      {
                        KVM_Jump_Next_Power_Port(KVM_CurrentHost);  
                      }         
                    }                 
                  }           
                }
                if (flash_write)
                {
                  STORAGE_Write(sizeof(KVM_Flash),(U8_T *)&KVM_Flash);
                  UartConsole_Ack();
                } 
                UARTx_PutStr("\n\r");       
              }
              
              void UartConsole_AudioCombo_Handle(void)
              {
                U8_T wordcnt; 
                U16_T  pid;
                U8_T   flash_write=0;
                
                UARTx_PutStr("Audio Combo Jump mode:");
                wordcnt=UartConsole_GetParamter(1);
                if (wordcnt == 0)
                {
                  UartConsole_Err();    
                }   
                else
                {
                  pid = atoi(&UartStr[1][1]);   
                  if (KVM_Flash.cSystemFlag1 & SYSTEM_AUDIOCOMBO_MASK)
                  { 
                    if (pid ==0)
                    {
                      KVM_Flash.cSystemFlag1 &= ~SYSTEM_AUDIOCOMBO_MASK;
                      flash_write=1;
                      UARTx_PutStr("OFF");
                    }       
                  }
                  else
                  {
                    if (pid ==1)
                    {
                      KVM_Flash.cSystemFlag1 |= SYSTEM_AUDIOCOMBO_MASK;
                      KVM_Audio_Combo_Switch_Check(KVM_CurrentHost);        
                      flash_write=1;
                      UARTx_PutStr("ON");
                    }                 
                  }           
                }
                if (flash_write)
                {
C51 COMPILER V9.60.7.0   UARTX_CONSOLE                                                     06/23/2026 16:04:47 PAGE 13  

                  STORAGE_Write(sizeof(KVM_Flash),(U8_T *)&KVM_Flash);
                  UartConsole_Ack();
                }
                UARTx_PutStr("\n\r");
              } 
              
              void UartConsole_UsbAudioJump_Handle(void)
              {
              #if (SYSTEM_USBAUDIO_DEVICE_SUPPORT)    
                U8_T wordcnt; 
                U16_T  pid;
              #endif  
                
                UARTx_PutStr("USB Audio Jump:");
              #if (SYSTEM_USBAUDIO_DEVICE_SUPPORT)  
                wordcnt=UartConsole_GetParamter(1);
                if (wordcnt == 0)
                {
                  UartConsole_Err();    
                }   
                else
                {
                  pid = atoi(&UartStr[1][1]);   
                  if ((KVM_Flash.cSystemFlag1 & SYSTEM_AUDIOCOMBO_MASK) == 0)
                  {
                    KVM_NextAudio =  pid;
                    USBHC_Audio_Hotkey_Sw_Flag = 1;
                    USBHC_AUDIO_Switch(KVM_NextAudio);
                    UARTx_PutStr("%bu",KVM_NextAudio);
                    UartConsole_Ack();
                  }
                  
                }
              #else
                UartConsole_Err();    
              #endif  
                UARTx_PutStr("\n\r");
              }   
              
              void UartConsole_BuzzerControl_Handle(void)
              {
                U8_T wordcnt; 
                U16_T  pid;
                U8_T   flash_write=0;
                
                UARTx_PutStr("Buzzer Contorl:");
