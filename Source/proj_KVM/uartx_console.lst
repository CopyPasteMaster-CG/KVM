              /*
               * ----------------------------------------------------------------------------
               * void UartConsole_PortSwitch_Handle(void)
               * Purpose : port switch handle
               * Params  : none
               * Returns : none
               * Note    : none
               * ----------------------------------------------------------------------------
               */
              void UartConsole_PortSwitch_Handle(void)
              {
                U8_T wordcnt;
                U8_T pid;
                
                UARTx_PutStr("Port Switch\n\r");  
                wordcnt=UartConsole_GetParamter(1);
                  
                if (wordcnt == 0)
                {
                  UartConsole_Ack();    
                  KVM_Jump_Next_Power_Port(KVM_CurrentHost);    
                }   
                else
                {
                  pid = atoi(&UartStr[1][1]);
                  if ((pid <= KVM_MAX_PORT) && (pid > 0))
                  { 
                    UartConsole_Ack();    
                    KVM_NextHost = pid-1;
                    KVM_Console_Port_Jump(KVM_NextHost);
                  } 
                  else
                  {
                    UartConsole_Err();    
C51 COMPILER V9.60.7.0   UARTX_CONSOLE                                                     06/23/2026 16:04:47 PAGE 9   

                  }     
                }     
              } 
              
              /*
               * ----------------------------------------------------------------------------
               * void UartConsole_PowerSavingMode_Handle(void)
               * Purpose : Power Saving handle
               *       SYSTEM_POWER_STOP_MODE = 2
               *       SYSTEM_POWER_SLEEP_MODE= 3
               * Params  : none
               * Returns : none
               * Note    : none
               * ----------------------------------------------------------------------------
               */
              void UartConsole_PowerSavingMode_Handle(void)
              {
                U8_T wordcnt; 
                U8_T  pid;
                
                UARTx_PutStr("Power Saving Mode:"); 
                wordcnt=UartConsole_GetParamter(1);
                
                if (wordcnt == 0)
                {
                  UartConsole_Err();    
                }   
                else
                {
                  pid = atoi(&UartStr[1][1]);
                  if (pid == SYSTEM_POWER_STOP_MODE)
                  {
                    UARTx_PutStr("Stop"); 
                    KVM_Flash.PowerSavingMode = SYSTEM_POWER_STOP_MODE;   // Stop Mode
                  }
                  else if (pid == SYSTEM_POWER_SLEEP_MODE)
                  { 
                    UARTx_PutStr("Sleep");  
                    KVM_Flash.PowerSavingMode = SYSTEM_POWER_SLEEP_MODE;  // Deep Sleep Mode
                  } 
                  else      
                  {
                    UartConsole_Err();
                    return;
                  }
                  UartConsole_Ack();        
                }     
                UARTx_PutStr("\n\r"); 
              }
              
              void UartConsole_AutoscanMode_Handle(void)
              {
                U8_T wordcnt; 
                U8_T  pid;
                
                UARTx_PutStr("Autoscan:");  
                wordcnt=UartConsole_GetParamter(1);
                if (wordcnt == 0)
                {
                  UartConsole_Err();    
                }   
                else
C51 COMPILER V9.60.7.0   UARTX_CONSOLE                                                     06/23/2026 16:04:47 PAGE 10  

                {
                  pid = atoi(&UartStr[1][1]);
                  if (pid)
                    UARTx_PutStr("ON"); 
                  else
                    UARTx_PutStr("OFF");  
                  KVM_Autoscan_Mode_Contorl(pid);     
                  UartConsole_Ack();    
                }       
                UARTx_PutStr("\n\r"); 
              }
              
              void UartConsole_AutoscanInterval_Handle(void)
              {
              
              } 
              
              void UartConsole_PowerJump_Handle(void) 
              {
                U8_T wordcnt; 
                U16_T  pid;
                U8_T   flash_write=0;
                
                UARTx_PutStr("PowerJump contorl mode:");
                wordcnt=UartConsole_GetParamter(1);
                if (wordcnt == 0)
                {
                  UartConsole_Err();    
                }   
                else
                {
                  pid = atoi(&UartStr[1][1]);   
                  if (KVM_Flash.cSystemFlag0 & SYSTEM_JUMP_MODE_MASK)
                  { 
                    if (pid ==0)
                    {
                      KVM_Flash.cSystemFlag0 &= ~(SYSTEM_JUMP_MODE_MASK|SYSTEM_AUTOSCAN_MODE_POWER);
                      flash_write = 1;      
                      UARTx_PutStr("OFF");        
                    }       
                  }
                  else
                  {
                    if (pid ==1)
                    {
                      KVM_Flash.cSystemFlag0 |= (SYSTEM_JUMP_MODE_MASK|SYSTEM_AUTOSCAN_MODE_POWER);       
                      KVM_Power_Jump_Check(KVM_CurrentHost,1); 
                      flash_write = 1;    
                      UARTx_PutStr("ON");       
                    }                 
                  }   
                }
              
                if (flash_write)
                {
                  STORAGE_Write(sizeof(KVM_Flash),(U8_T *)&KVM_Flash);
                  UartConsole_Ack();
                } 
                UARTx_PutStr("\n\r");
              }
              
              void UartConsole_PlugJumpMode_Handle(void)
