             ------
              void UartConsole_Ack(void)
              {
                UARTx_PutStr(">OK\n\r"); //responsed command
C51 COMPILER V9.60.7.0   UARTX_CONSOLE                                                     06/23/2026 16:04:47 PAGE 7   

                UartConsole_Prompt();
              }
              
              void UartConsole_Err(void)
              {
                UARTx_PutStr(">ERROR\n\r"); //responsed command
                UartConsole_Prompt();
              }
              
              void UartConsole_Prompt(void)
              {
                UARTx_PutStr(">"); //responsed command
              }
              
              U8_T UartConsole_GetParamter(U8_T para_cnt)
              {
                U8_T wordcnt;
                
                for (wordcnt=0; wordcnt < para_cnt ; wordcnt++)
                {
                  if (UartConsole_GetNextWord() == 0)
                  {
                    break;
                  }       
                }
                
                return wordcnt;
              } 
              
