 193          /*
 194           * ----------------------------------------------------------------------------
 195           * Function Name: BUZZER_Set_Freqency_Time(U8_T frequency,U8_T time)
 196           * Purpose:
 197           * Params:
 198           * Returns:
 199           * Note:
 200           * ----------------------------------------------------------------------------
 201           */
 202          static void BUZZER_Set_Freqency_Time(U8_T frequency,U8_T time)
 203          {
 204   1        U8_T  interrupt4;
 205   1      
 206   1        EXTINT5_DISABLE;
 207   1        interrupt4 = EINT4; // keep the orginal value
 208   1        EXTINT4_DISABLE;
 209   1      
 210   1        BCR_BK &= ~(BUZZER_KHZ_MASK|BUZZER_PERIOD_MASK);
 211   1      
 212   1        BCR_BK |= (frequency| time);
 213   1      
 214   1        _MISC_DR_SFR(BCR_BK);
 215   1        _MISC_CIR_SFR(MISC_BCR);
 216   1      
 217   1        EXTINT5_ENABLE;
 218   1        EINT4 = interrupt4;
 219   1      }
