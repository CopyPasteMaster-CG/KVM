 254          /*
 255           * ----------------------------------------------------------------------------
 256           * Function Name: Buzzer_Script_Parser(U8_T)
 257           * Purpose:
 258           * Params:
 259           * Returns:
 260           * Note:
 261           * ----------------------------------------------------------------------------
 262           */
 263          static void Buzzer_Script_Parser(Buzzer_ControlTypeDef *script,U8_T btn_index)
 264          {
 265   1        if ((script+btn_index)->Frequency == BUZZER_Terminate)
 266   1        {
 267   2          Buzzer_Script_Start = 0;
 268   2          return;
 269   2        }
 270   1        if ((script+btn_index)->Frequency != BUZZER_Silence)
 271   1        {
 272   2          #if (KVM_BUZZER_TYPE_Frequency) 
                    BUZZER_Set_Freqency_Time((script+btn_index)->Frequency,(script+btn_index)->Period); //zbb
                  #else   
 275   2            BUZZER_Set_Freqency_Time(0x00,(script+btn_index)->Period);
 276   2          #endif  
 277   2        
 278   2          BUZZER_Control(BUZZER_ON);
 279   2        }
 280   1        else
 281   1        {
 282   2          BUZZER_Control(BUZZER_OFF);
 283   2        }
 284   1        TASK_Active(TASK_TYPE_INTERVAL_MS,TASK_BUZZER_SCRIPT_ID,0,0,(script+btn_index)->Keeptime,(script+btn_inde
             -x)->Keeptime); // now aticev the process for time out event
 285   1      }
