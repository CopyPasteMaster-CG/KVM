 296          void BUZZER_Script_Active(Buzzer_ControlTypeDef *script)
 297          {
 298   1        //1.Check Buzzer active condition
 299   1        if (bBUZZER_ForceFlag == 0)
 300   1        {
 301   2          if ((KVM_Flash.cSystemFlag0 & SYSTEM_BEEPER_MASK) == 0)
 302   2          {
 303   3            return;
 304   3          }
 305   2        }
 306   1      
 307   1        if (Buzzer_Script_Start)
 308   1        {
 309   2          return;
 310   2        }
 311   1      
 312   1        Buzzer_Index = 0;
 313   1        Buzzer_Current_Script = script;
 314   1      
 315   1        Buzzer_Script_Start = 1;
 316   1        Buzzer_Script_Parser(Buzzer_Current_Script,Buzzer_Index);
 317   1      }
