 229          static void BUZZER_Control(U8_T state)
 230          {
 231   1        U8_T interrupt4;
 232   1      
 233   1        EXTINT5_DISABLE;
 234   1        interrupt4 = EINT4; // keep the orginal value
 235   1        EXTINT4_DISABLE; 
 236   1      
 237   1        if (state == BUZZER_ON)
 238   1        {
 239   2          BCR_BK |= BUZZER_SE_MASK;
 240   2          BCR_BK &= ~BUZZER_TSE_SET;
 241   2        }
 242   1        else
 243   1        {
 244   2          BCR_BK |= BUZZER_TSE_SET;
 245   2          BCR_BK &= ~BUZZER_SE_MASK;
 246   2        }
 247   1        _MISC_DR_SFR(BCR_BK);
 248   1        _MISC_CIR_SFR(MISC_BCR);
 249   1      
 250   1        EXTINT5_ENABLE;
 251   1        EINT4 = interrupt4;
 252   1      }
