 595           * ----------------------------------------------------------------------------
 596           * U8_T TASK_Malloc(U8_T *freeid)
 597           * Purpose: 
 598           * Returns:
C51 COMPILER V9.60.7.0   TASK_MAIN                                                         06/18/2026 10:50:16 PAGE 11  

 599           * Note:
 600           * ----------------------------------------------------------------------------
 601           */
 602          static U8_T TASK_Malloc(U8_T *freeid)
 603          {
 604   1        U8_T index,bidx,bitmap;
 605   1      
 606   1        for(index=0; index < TASK_SEARCH_MAX ; index++)
 607   1        {
 608   2          if (Task_Search[index] != 0xff )
 609   2          {
 610   3            for (bidx=0; bidx < 8 ; bidx++)
 611   3            {
 612   4              bitmap = 0x01 << bidx;
 613   4              if ((Task_Search[index] & bitmap) == 0x00)
 614   4              {
 615   5                Task_Search[index] |= bitmap;
 616   5                *freeid = (index <<3) + bidx;
 617   5                return 1;
 618   5              }
 619   4            }
 620   3          }
 621   2        }
 622   1      
 623   1        return 0;
 624   1      }
