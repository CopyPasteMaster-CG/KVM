 629           * Purpose: Free the task from active table
 630           * Returns: void
 631           * Note:
 632           * ----------------------------------------------------------------------------
 633           */
 634          static void TASK_Free(U8_T freeid)
 635          {
 636   1        U8_T byte_inx,bitmpa;
 637   1      
 638   1        byte_inx = freeid >> 3;
 639   1        bitmpa = 0x01 << (freeid & 0x07);
 640   1        Task_Search[byte_inx] &= ~bitmpa;
 641   1      #if (TaskControlEnable)
                Task_Active_Table[freeid].taskCtrl |= TASK_EVENT_DESTORY;
              #else
 644   1        Task_Active_Table[freeid].Task_Event |= TASK_EVENT_DESTORY;
 645   1      #endif
 646   1      }
