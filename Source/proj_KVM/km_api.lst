             -ive_Data->bPayload[2]);
 878   1        switch(Kbbuf[1])
 879   1        {
 880   2          case 0x07: //normal keyboard data
 881   2            key_type = HID_USAGE_PAGE_07_MAKE + (Kbbuf[0] & 0x01);    
 882   2            //KM_SYNC_Send_VHID_Key(key_type,Kbbuf[2]);
