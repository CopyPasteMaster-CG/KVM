1046          
1047          //-----------------------------------------------
1048          // void API_Roaming_1_3_Call(void)
1049          //     0 
1050          //  |  X  | 
1051          //  2 <-> 3 
1052          //-----------------------------------------------
1053          void API_Roaming_1_3_Call(void)
1054          {
1055   1        U16_T one_quarter;
1056   1        U16_T half;
1057   1        U16_T three_quarter;
1058   1        U8_T i;
1059   1        
1060   1        one_quarter = (Y_MAX >> 2);
1061   1        half = (Y_MAX >> 1);
1062   1        three_quarter = ((Y_MAX * 3) >> 2);
1063   1        
1064   1        if ((KVM_CurrentHost == API_Current_Main_SCREEN) &&
1065   1          (Current_Roaming_Direction == ROAMING_RIGHT))
1066   1        {
1067   2          if (MouseY < one_quarter)
1068   2          {
1069   3            MouseY = half + (MouseY * 2);
1070   3          }
1071   2          else if (MouseY < three_quarter)
1072   2          {
1073   3            MouseY = (MouseY - one_quarter) * 2;
1074   3          }
1075   2          else
1076   2          {
1077   3            MouseY = (MouseY - three_quarter) * 2;
1078   3          }
1079   2          
1080   2          MouseX = X_LEFT_EDGE;
1081   2          if (MouseY > Y_MAX)
1082   2          {
1083   3            MouseY = Y_MAX;
1084   3          }
1085   2        }
1086   1        else if ((KVM_CurrentHost != API_Current_Main_SCREEN) &&
1087   1             (Current_Roaming_Direction == ROAMING_LEFT))
1088   1        {
1089   2          for (i = 1; i < 4; i++)
1090   2          {
1091   3            if (Roaming[Current_Roaming_Table]->Sequence[i] == KVM_CurrentHost)
1092   3            {
C51 COMPILER V9.60.7.0   KM_API                                                            06/23/2026 16:04:48 PAGE 19  

1093   4              if (i == 1)
1094   4              {
