 544          /**----------------------------------------------------------------------------
 545           * Function Name: KM_SYNC_KM_SyncModeLed(void)
 546           * Purpose: 
 547           * Params:
 548           * Returns:
 549           * Note:
 550           * ----------------------------------------------------------------------------*/
 551          void KM_SYNC_KM_SyncModeLed(U8_T led_ctrl)
 552          {
 553   1        U8_T i;
 554   1        U8_T led=led_ctrl;
 555   1        
 556   1        for (i=0; i < KVM_MAX_PORT; i++)
 557   1        {
 558   2          if (led_ctrl == LED_ON)
 559   2          { 
 560   3            if (USBDC_UpPortState[i] & USBDC_ROOTHUB_ATTACHED_MASK)
 561   3            {         
 562   4              if (KVM_Flash.cSystemFlag2 & SYSTEM_ALL_SYNC_MASK)
 563   4              {
 564   5                if (KM_SYNC_PortSetting & BIT_MASK[i])          
 565   5                  led = LED_OFF;
 566   5                else
 567   5                  led = LED_ON;         
 568   5              }
 569   4              else
 570   4              {
 571   5                if (i != KVM_CurrentHost)
 572   5                  led = LED_OFF;
 573   5              }         
 574   4              KVM_Select_Led_Control(i,led);        
 575   4            } 
 576   3            else
 577   3            {
 578   4              if (KVM_Flash.cSystemFlag2 & SYSTEM_ALL_SYNC_MASK)
 579   4                KVM_Select_Led_Control(i,LED_OFF);
 580   4              else
 581   4              {
 582   5                if (i != KVM_CurrentHost)
 583   5                { 
 584   6                  KVM_Select_Led_Control(i,LED_OFF);
 585   6                } 
 586   5                else
 587   5                {
 588   6                  KVM_Select_Led_Control(i,LED_ON);
 589   6                }           
 590   5              }         
 591   4            }       
 592   3          } 
 593   2          else
 594   2          { 
 595   3            KVM_Select_Led_Control(i,led_ctrl);
 596   3          } 
 597   2        }
 598   1      } 
