 772          /**----------------------------------------------------------------------------
 773           * U8_T KM_SYNC_KB_Hotkey_Check_Valid(U8_T keycode)
 774           * Purpose: 
 775           * Params:
 776           * Returns:
 777           * Note:
 778           * ----------------------------------------------------------------------------*/
 779          U8_T KM_SYNC_KB_Hotkey_Check_Valid(U8_T keycode)
 780          {
 781   1        Hotkey_Queue[2] = 0;
 782   1        if ((keycode >= CHAR_PAD_1_END) && (keycode <= CHAR_PAD_9_PGUP))
C51 COMPILER V9.60.7.0   KM_SYNC                                                           06/23/2026 16:04:47 PAGE 14  

 783   1        { 
 784   2          Hotkey_Queue[2] = '1'+(keycode-CHAR_PAD_1_END);           
 785   2        }
 786   1        else if (keycode == CHAR_PAD_0_INSERT)
 787   1        { 
 788   2          Hotkey_Queue[2] = '0';
 789   2        }     
 790   1        else if ((keycode >= CHAR_1) && (keycode <= CHAR_9))
 791   1        { 
 792   2          Hotkey_Queue[2] = '1'+(keycode-CHAR_1);           
 793   2        }     
 794   1        else if (keycode == CHAR_0)
 795   1        { 
 796   2          Hotkey_Queue[2] = '0';
 797   2        }     
 798   1        else if ((keycode >= CHAR_A) && (keycode <= CHAR_Z))
 799   1        { 
 800   2          Hotkey_Queue[2] = 'A'+(keycode-CHAR_A);
 801   2        } 
 802   1        
 803   1        return Hotkey_Queue[2];
 804   1      }
