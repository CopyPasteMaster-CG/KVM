 238          /** ----------------------------------------------------------------------------
 239           * Function Name: KM_SYNC_KB_Led_Send(U8_T port,U8_T led_id)
 240           * Purpose:
 241           * Params:
 242           * Returns:
 243           * Note:
 244           * ----------------------------------------------------------------------------*/
 245          void KM_SYNC_KB_Led_Send(U8_T port,U8_T led_id)
 246          {
 247   1        U8_T i;
 248   1        
 249   1        for (i=0; i < 3; i++)
 250   1        {
 251   2          if (led_id & BIT_MASK[i])
 252   2          { 
 253   3            switch (BIT_MASK[i])
 254   3            { 
 255   4              case KVM_LED_NUM_LOCK:
 256   4                //printf("Number LED Toggle\n\r");
 257   4                KM_SYNC_Send_KB_Hid_Key(port,CHAR_NUM_LOCK);
 258   4                //DATAST_Keyboard_Send(port,HID_USAGE_PAGE_07_MAKE,CHAR_NUM_LOCK);
 259   4                //DATAST_Keyboard_Send(port,HID_USAGE_PAGE_07_BREAK,CHAR_NUM_LOCK);       
 260   4                break;
 261   4              case KVM_LED_CAPS_LOCK:
 262   4                //printf("CAPS LED Toggle\n\r");
 263   4                KM_SYNC_Send_KB_Hid_Key(port,CHAR_CAPS_LOCK);
 264   4                //DATAST_Keyboard_Send(port,HID_USAGE_PAGE_07_MAKE,CHAR_CAPS_LOCK);
 265   4                //DATAST_Keyboard_Send(port,HID_USAGE_PAGE_07_BREAK,CHAR_CAPS_LOCK);        
 266   4                break;
 267   4              case KVM_LED_SCROLL_LOCK:
 268   4                //printf("Scroll LED Toggle\n\r");
 269   4                KM_SYNC_Send_KB_Hid_Key(port,CHAR_SCROLL_LOCK);
 270   4                //DATAST_Keyboard_Send(port,HID_USAGE_PAGE_07_MAKE,CHAR_SCROLL_LOCK);
 271   4                //DATAST_Keyboard_Send(port,HID_USAGE_PAGE_07_BREAK,CHAR_SCROLL_LOCK);        
 272   4                break;
 273   4            } 
 274   3          }         
 275   2        }   
 276   1      } 
 277          /**----------------------------------------------------------------------------
 278           * Function Name: KM_SYNC_Start(U8_T led,U8_T port)
 279           * Purpose: 
 280           * Params:
 281           * Returns:
 282           * Note:
 283           * ---------------------------------------------------------------------------*/
 284          void KM_SYNC_Start(U8_T port)
 285          { 
 286   1        U8_T i;
 287   1        
 288   1        //1.Check current LED setting
 289   1        //printf("SYNC LED,Set=%02bx,Port=%bu,Led=%02bx\n\r",KM_SYNC_KbLed_Set_State,port,KVM_HostLed[port]);
C51 COMPILER V9.60.7.0   KM_SYNC                                                           06/23/2026 16:04:47 PAGE 6   

 290   1        if (KVM_Flash.cSystemFlag2 & (SYSTEM_ALL_SYNC_MASK | SYSTEM_KB_SYNC_MASK))
 291   1        {      
 292   2          if ((KM_SYNC_KbLed_Set_State & BIT_MASK[port]) == 0x00) // not in LED set state
 293   2          {
 294   3            //printf("Init0:%02bx",KM_SYNC_Init_Led);
 295   3            if (KVM_HostLed[port] != KM_SYNC_Init_Led) // only Numner LED is on       
 296   3            {                           
 297   4              for (i=0; i < 3; i++)
 298   4              {
 299   5                if (KM_SYNC_Init_Led & BIT_MASK[i])
 300   5                {             
 301   6                  if ((KVM_HostLed[port] & BIT_MASK[i]) == 0)
 302   6                  {
 303   7                    KM_SYNC_KB_Led_Send(port,BIT_MASK[i]);
 304   7                  }
 305   6                } 
 306   5                else
 307   5                {
 308   6                  if (KVM_HostLed[port] & BIT_MASK[i])
 309   6                  {
 310   7                    KM_SYNC_KB_Led_Send(port,BIT_MASK[i]);
 311   7                  }
 312   6                }           
 313   5              }           
 314   4            }     
 315   3          } 
 316   2          KM_SYNC_KbLed_Set_State |= BIT_MASK[port]; //setting done
 317   2          //KM_SYNC_System_Ready_Led();
 318   2        } 
 319   1      }
