 879   2          if (Hotkey_Queue[0] == CHAR_PAD_STAR)
 880   2          { 
 881   3            if (KM_SYNC_Hotkey_Function[0] != KB_HOTKEY_ROAMING_MAP2)
 882   3              KM_SYNC_Hotkey_Function[0] = KB_HOTKEY_JUMP_MODE;
 883   3          }
 884   2          else if (Hotkey_Queue[0] == CHAR_PAD_PLUS)
 885   2          { 
 886   3            KM_SYNC_Hotkey_Function[0] = KB_HOTKEY_SYNC_PORT_ADD_MODE;
 887   3          }
 888   2          else if (Hotkey_Queue[0] == CHAR_PAD_MINUS)
 889   2          { 
 890   3            KM_SYNC_Hotkey_Function[0] = KB_HOTKEY_SYNC_PORT_CLEAR_MODE;
