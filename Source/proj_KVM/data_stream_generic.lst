1594          void DATAST_PS2_MS_Convert2_USB(U8_T *ps2_msdata) 
1595          {
1596   1        U8_T temp1;
1597   1        
1598   1        temp1 =  (ps2_msdata[3] & 0xf0 ) >> 1;
1599   1        ps2_msdata[0] = (ps2_msdata[0] & 0x07) | temp1;    // prepare the 4,5 buttons
1600   1        ps2_msdata[2] = ~ps2_msdata[2]+1 ;                  // 3rd Mouse Data
1601   1        ps2_msdata[3] = ~( ps2_msdata[3] & 0x0f)+1;        // 4th Mouse Data
1602   1        if ( ps2_msdata[3] <= 0xf7 )
1603   1        {
1604   2          ps2_msdata[3] &= 0x0f;
1605   2        }
1606   1      }
