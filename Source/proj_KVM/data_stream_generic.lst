 237          #ifdef SYNC
 238          void DATAST_Keyboard_Send(U8_T port,U8_T usb_keytype,U8_T usb_keycode)
 239          { 
 240   1        //printf("S1");
 241   1        if (KVM_Check_KB_Skip_Condition()==0)
 242   1        {   
 243   2          //printf("S2:%02bx",TASK_DATAST_PS2_Generic_KB_ActiveFlag);
 244   2          DATAST_Append_Generic_KB_In_Queue(port,usb_keytype,usb_keycode);
 245   2          if ((TASK_DATAST_PS2_Generic_KB_ActiveFlag & BIT_MASK[port]) == 0)
 246   2          {
 247   3            //printf("S3");
 248   3            if (DATAST_Generic_KB_IN_WP[port] != DATAST_Generic_KB_IN_RP[port]) // check if there is data needed pr
             -ocessed
 249   3            {
 250   4              //printf("p:%bu,task\n\r",port);
 251   4              TASK_DATAST_PS2_Generic_KB_ActiveFlag |= BIT_MASK[port];
 252   4              TASK_Active(TASK_TYPE_EVENT,TASK_DATAST_PS2_Generic_KB_ID,0,port,0,0); // now aticev the Generic KB Ou
             -tput Handle
 253   4            }
 254   3          }
 255   2        }   
 256   1      }
 257          #else
              void DATAST_Keyboard_Send(U8_T port,U8_T usb_keytype,U8_T usb_keycode)
              {
                port = 0;
                if (KVM_Check_KB_Skip_Condition()==0)
                {   
                  DATAST_Append_Generic_KB_In_Queue(usb_keytype,usb_keycode);
                  if (TASK_DATAST_PS2_Generic_KB_ActiveFlag  == 0)
                  {
                    if (DATAST_Generic_KB_IN_WP != DATAST_Generic_KB_IN_RP) // check if there is data needed processed
                    {
                      TASK_DATAST_PS2_Generic_KB_ActiveFlag =1;
                      TASK_Active(TASK_TYPE_EVENT,TASK_DATAST_PS2_Generic_KB_ID,0,0,0,0); // now aticev the Generic KB Outpu
             -t Handle
                    }
                  }
                }   
              } 
