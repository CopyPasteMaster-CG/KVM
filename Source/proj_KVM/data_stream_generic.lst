 592          //****************************************************************************************************
 593          //* Program Name : DATAST_Adjust_Generic_USBKB_Q
 594          //* Parameter    : index, the current index 
 595          //* Description  : addjust the byte after the index, this is no effect in windows system, but will fit for
 596          //                 Sun micro System
 597          //****************************************************************************************************
 598          #ifdef  SYNC
 599          void DATAST_Adjust_Generic_USBKB_Q(U8_T port,U8_T index)
 600          {
 601   1        U8_T i;
 602   1      
 603   1        for (i=index ; i < 7 ; i++ )
 604   1        {
 605   2          DATAST_Generic_USB_KB_Queue[port][i] = DATAST_Generic_USB_KB_Queue[port][i+1];
 606   2        }
 607   1        DATAST_Generic_USB_KB_Queue[port][7] = 0; // the last byte
 608   1      }
 609          #else
              void DATAST_Adjust_Generic_USBKB_Q(U8_T index)
              {
                U8_T i;
              
                for (i=index ; i < 7 ; i++ )
                {
                  DATAST_Generic_USB_KB_Queue[i] = DATAST_Generic_USB_KB_Queue[i+1];
                }
                DATAST_Generic_USB_KB_Queue[7] = 0; // the last byte
              }
              #endif 
