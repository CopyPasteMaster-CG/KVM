 667          //* Description  : Add the usb code into the USB output queue
 668          //****************************************************************************************************
 669          #ifdef SYNC
 670          void DATAST_Append_Generic_USBKB_Q(U8_T port,U8_T keycode)
 671          {
 672   1        U8_T i;
 673   1      
 674   1        if (keycode == CHAR_REPEAT)
 675   1        { 
 676   2          memcpy(DATAST_Generic_USB_KB_Queue[port],KM_SYNC_Sync_KB_HID_RepeatTableMake[port],8);
 677   2          goto DATAST_Append_Generic_USBKB_Q_Valid;
 678   2        }
 679   1          
 680   1        i = DATAST_Search_Generic_USBKB_Q(port,keycode);
 681   1      
 682   1        if (i != GENERIC_KB_NOT_FOUND) // is the code in buffer already?
 683   1        {
 684   2          return;
 685   2        }
 686   1        
 687   1        i = DATAST_Search_Generic_USBKB_Q(port,0x00); // find out the first byte for 0x00
 688   1      
 689   1        if (i == GENERIC_KB_NOT_FOUND)      // where is the first 0 byte position
 690   1        {
 691   2          DATAST_Adjust_Generic_USBKB_Q(port,2);
 692   2          i = 7; // the last byte
 693   2        }
 694   1        DATAST_Generic_USB_KB_Queue[port][i] = keycode; 
 695   1      DATAST_Append_Generic_USBKB_Q_Valid:
 696   1        DATAST_Generic_KB_Change_Flag = 1;
 697   1      #if (SYSTEM_PS2_HOST_ENABLE)
                //cPS2_KB_PressCnt++;
              #endif  
 700   1      }
 701          #else
              void DATAST_Append_Generic_USBKB_Q(U8_T keycode)
              {
                U8_T i;
              
                i = DATAST_Search_Generic_USBKB_Q(keycode);
              
                if (i != GENERIC_KB_NOT_FOUND) // is the code in buffer already?
C51 COMPILER V9.60.7.0   DATA_STREAM_GENERIC                                               06/23/2026 16:04:43 PAGE 13  

                {
                  return;
                }
                
                i = DATAST_Search_Generic_USBKB_Q(0x00); // find out the first byte for 0x00
              
                if (i == GENERIC_KB_NOT_FOUND)      // where is the first 0 byte position
                {
                  DATAST_Adjust_Generic_USBKB_Q(2);
                  i = 7; // the last byte
                }
                DATAST_Generic_USB_KB_Queue[i] = keycode; 
                DATAST_Generic_KB_Change_Flag = 1;
              #if (SYSTEM_PS2_HOST_ENABLE)
                cPS2_KB_PressCnt++;
              #endif  
              }
              #endif
