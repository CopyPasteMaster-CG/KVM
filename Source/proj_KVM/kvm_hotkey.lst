 609          #if (SYSTEM_PS2_HOST_ENABLE)
              U8_T HOTKEY_Check_PS2_Key_Break(U8_T buftype)
              {
                if (buftype == KB_TYPE_BREAK_F0)
                {
                  return 1;
                }
              
                if (buftype == KB_TYPE_BREAK_E0) 
                {
                  return 2;
                }
              
                if (buftype == KB_TYPE_BREAK_E1) 
                {
                  return 3;
                }
              
                return 0;
