 672          /*
 673           *--------------------------------------------------------------------------------
 674           * U8_T hotkey_KeyCodeMatch(U8_T keyCode, U8_T matchCode)
 675           * Purpose : 
 676           * Params  : 
 677           *           
 678           * Returns : 
 679           * Note    : None.
 680           *--------------------------------------------------------------------------------
 681           */
 682          static U8_T hotkey_KeyCodeMatch(U8_T keyCode, U8_T matchCode)
 683          {
 684   1        if ((matchCode >= CHAR_1) && (matchCode <= CHAR_0))
 685   1        {
 686   2          if (keyCode == matchCode)
 687   2            return 1;
 688   2          else if (keyCode == (matchCode+0x3B))
 689   2            return 1;
 690   2        }
 691   1        else if ((matchCode >= CHAR_PAD_1_END) && (matchCode <= CHAR_PAD_0_INSERT))
 692   1        {
 693   2          if (keyCode == matchCode)
 694   2            return 1;
 695   2          else if (keyCode == (matchCode-0x3B))
 696   2            return 1;
 697   2        }
 698   1        else if (keyCode == matchCode)
 699   1          return 1;
 700   1      
 701   1        return 0;
 702   1      }
