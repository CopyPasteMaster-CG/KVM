 630          /*
 631           *--------------------------------------------------------------------------------
 632           * U8_T HOTKEY_Check_Numeric_Key(U8_T keycode,U16_T *value)
 633           * Purpose : check usb keycode, wheither is numeric key or keypad numeric key
 634           * Params  : $keycode-USB Scan Code
 635           *           $*value- USB scan code to a digit
 636           * Returns : 0/1- 1->is numeric key
 637           * Note    : None.
 638           *--------------------------------------------------------------------------------
 639           */
 640          U8_T HOTKEY_Check_Numeric_Key(U8_T keycode,U16_T *value)
 641          {
 642   1        U8_T  keyvalue=0, newvalue;
 643   1      
 644   1        newvalue = *value;
 645   1        if ((keycode >= CHAR_1) && (keycode <= CHAR_0))
 646   1        {
 647   2          if (keycode < CHAR_0)
 648   2          {
 649   3            keyvalue = (keycode - CHAR_1) + 1;
 650   3          }
 651   2      
 652   2          goto NumericKeyChange;
 653   2        }
 654   1        else if ((keycode >= CHAR_PAD_1_END) && (keycode <= CHAR_PAD_0_INSERT))
 655   1        {
 656   2          if (keycode < CHAR_PAD_0_INSERT)
 657   2          {
C51 COMPILER V9.60.7.0   KVM_HOTKEY                                                        06/18/2026 14:01:43 PAGE 12  

 658   3            keyvalue = (keycode - CHAR_PAD_1_END) + 1;
 659   3          }
 660   2      
 661   2          goto NumericKeyChange;
 662   2        }
 663   1      
 664   1        return 0;
 665   1      
 666   1      NumericKeyChange:
 667   1      
 668   1        *value = (newvalue << 3)+(newvalue << 1)+keyvalue; // value = value * 10 + value
 669   1        return 1;
 670   1      }
