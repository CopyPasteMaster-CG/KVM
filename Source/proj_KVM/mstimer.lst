  47          void SWTIMER_Init(void)
  48          {
  49   1        SWTIMER_Counter = 0;
  50   1        SWTIMER_ScCheckTimer256ms = 0;
  51   1        SWTIMER_ScCheckTimerMinutes = 0;
  52   1        SWTIMER_ScCheckTimerHours = 0;
  53   1      
  54   1      } /* End of SWTIMER_Init */
  55          
  56          /*
  57           * ----------------------------------------------------------------------------
  58           * void SWTIMER_Start(void)
  59           * Purpose: Enable the interrupt and start software timer.
  60           * Params : None.
  61           * Returns: None.
  62           * Note   : None.
  63           * ----------------------------------------------------------------------------
  64           */
  65          void SWTIMER_Start(void)
  66          {
  67   1        U8_T XDATA  temp[2];
  68   1      
  69   1        /* set software timer */
  70   1        temp[1] = (U8_T)SWTIMER_INTERVAL;
  71   1        temp[0] = (U8_T)(SWTIMER_INTERVAL >> 8) + SWTIMER_START + SWTIMER_INT_ENABLE;
  72   1        DMA_RegWrite(SWTIMER_REG, temp, 2);
  73   1      
  74   1        EXTINT5_ENABLE; /* Enable INT5 interrupt for software timer. */
  75   1      
  76   1      } /* End of SWTIMER_Start */
