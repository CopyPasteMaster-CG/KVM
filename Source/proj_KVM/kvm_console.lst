1474          /*
1475           *--------------------------------------------------------------------------------
1476           * void KVM_CONSOLE_Vga_Control(U8_T port,U8_T led_control)
1477           * Purpose : Control the current VGA Port
1478           * Params  : NONE
1479           * Returns : None.
1480           * Note    : None.
1481           *--------------------------------------------------------------------------------
1482           */
1483          void KVM_CONSOLE_Vga_Control(U8_T port,U8_T vga_control)
1484          {
1485   1      #ifdef KMLOG
                vga_control = port = 0;
              #else 
1488   1        #ifdef KM104U 
                  port = 0;
                  vga_control = 0;
                #else 
1492   1          #ifdef KMLOG
                  port = 0;
                  vga_control = 0;
                  
                  #else //none KMLOG
1497   1          #ifdef MCU_TYPE_AX68002   
                    GPIO_SetOneBit(VGA_CONTROL_PORT[0],GPIO_Pin_4,0);
                    GPIO_SetOneBit(VGA_CONTROL_PORT[1],GPIO_Pin_5,0);  
                  #else
1501   1            U8_T  index;
1502   1            
1503   1            //1.Clear All the VGA port
1504   1            for (index = 0; index < KVM_MAX_PORT; index++)
1505   1            {
1506   2              GPIO_SetOneBit(VGA_CONTROL_PORT[index],VGA_CONTROL_PIN[index],1);
1507   2            }
1508   1          #endif
