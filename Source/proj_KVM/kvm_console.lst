 510          {
 511   1        U8_T  base_byte, search_bit;
 512   1      
 513   1        base_byte = index >> 3; //8 bit as unit
 514   1        search_bit = 0x01 << (index & 0x07);  //the compare bit
 515   1      
 516   1        if (table[base_byte] & search_bit)
 517   1        {
 518   2          return 1;
 519   2        }
 520   1        return 0;
 521   1      }
 522          /*
 523           *--------------------------------------------------------------------------------
 524           * void KVM_GetNextConnect(U8_T currenthost,U8_T *nexthost)
 525           * Purpose : 
 526           * Params  : NONE
 527           * Returns : None.
 528           * Note    : None.
 529           *--------------------------------------------------------------------------------
 530           */
 531          U8_T KVM_GetNextConnect(U8_T currenthost,U8_T *nexthost)
 532          {
 533   1        U8_T  index;
 534   1      
 535   1        // look backward
 536   1        for (index = (currenthost+1); index < KVM_MAX_PORT; index++)
 537   1        {
 538   2          if (USBDC_UpPortState[index] & USBDC_ROOTHUB_ATTACHED_MASK)
C51 COMPILER V9.60.7.0   KVM_CONSOLE                                                       06/23/2026 16:04:44 PAGE 10  

 539   2          {
 540   3            *nexthost = index;
 541   3            return 1;
 542   3          }
 543   2        }
 544   1      
 545   1        // look forward
 546   1        for (index = 0; index < currenthost; index++)
 547   1        {
 548   2          if (USBDC_UpPortState[index] & USBDC_ROOTHUB_ATTACHED_MASK)
 549   2          {
 550   3            *nexthost = index;
 551   3            return 1;
 552   3          }
 553   2        }
 554   1      
 555   1        *nexthost = currenthost;
 556   1        return 0;
 557   1      }
