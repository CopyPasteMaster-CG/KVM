1797          U8_T KVM_Power_Jump_Check(U8_T pid,U8_T checknext) 
1798          {
1799   1        U8_T port_attached;
1800   1          
1801   1        if (KVM_Flash.cSystemFlag0 & SYSTEM_JUMP_MODE_MASK) //jump by power
1802   1        {     
1803   2          port_attached = USBDC_UpPortState[pid] & USBDC_ROOTHUB_ATTACHED_MASK;   
1804   2          if (checknext)
1805   2          { 
1806   3            if ((port_attached == 0x00) && (pid == KVM_CurrentHost))
1807   3            {
1808   4              KVM_Jump_Next_Power_Port(pid);                        
1809   4            }
1810   3            }
1811   2            else
1812   2            {
1813   3              if (port_attached == 0)
1814   3              {
1815   4      #if (KVM_BUZZER_SUPPORT)
1816   4              BUZZER_Script_Active(Error_Sound);
1817   4      #endif //#if (KVM_BUZZER_SUPPORT)   
1818   4              }           
1819   3              return port_attached;
1820   3            } 
C51 COMPILER V9.60.7.0   KVM_CONSOLE                                                       06/23/2026 16:04:44 PAGE 31  

1821   2          return 0;
1822   2        }
1823   1        else
1824   1        {
1825   2          return 1;
1826   2        }     
1827   1      } 
