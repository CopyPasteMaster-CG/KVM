 559          /*
 560           *--------------------------------------------------------------------------------
 561           * void KVM_GetNextAutoScanHost(U8_T currenthost,U8_T *nexthost)
 562           * Purpose : 
 563           * Params  : NONE
 564           * Returns : None.
 565           * Note    : None.
 566           *--------------------------------------------------------------------------------
 567           */
 568          U8_T KVM_GetNextAutoScanHost(U8_T currenthost,U8_T *nexthost)
 569          {
 570   1        /* if Free Scan Mode */
 571   1        if ((KVM_Flash.cSystemFlag0 & SYSTEM_AUTOSCAN_MODE_MASK) == SYSTEM_AUTOSCAN_MODE_FREE)
 572   1        {
 573   2          *nexthost = currenthost+1;
 574   2          if (*(nexthost) >= KVM_MAX_PORT)
 575   2          {
 576   3            *nexthost = 0;
 577   3          }
 578   2          return 1;
 579   2        }
 580   1        /* if Scan Mode with Power status */
 581   1        if ((KVM_Flash.cSystemFlag0 & SYSTEM_AUTOSCAN_MODE_MASK) == SYSTEM_AUTOSCAN_MODE_POWER)
 582   1        {
 583   2          if (KVM_GetNextConnect(currenthost,nexthost))
 584   2          {
 585   3            return 1;
 586   3          }
 587   2        }
 588   1        return 0;
 589   1      }
