 593           * void TASK_KVM_Autoscan_Event_Control(void)
 594           * Purpose : Handle the hotkey mode deactive control
 595           * Params  : NONE
 596           * Returns : None.
 597           * Note    : None.
 598           *--------------------------------------------------------------------------------
 599           */
 600          void TASK_KVM_Autoscan_Event_Control(void)
C51 COMPILER V9.60.7.0   KVM_CONSOLE                                                       06/23/2026 16:04:44 PAGE 11  

 601          {
 602   1        if (KVM_Control_Status & KVM_AUTOSCAN_MASK)
 603   1        {
 604   2          iAutoScanSecCnt++;
 605   2          if ((iAutoScanSecCnt >> 1) >= KVM_Flash.AutoScanInterval)
 606   2          {
 607   3            //1.Changed the LED status
 608   3            iAutoScanSecCnt = 0; // reset the autoscan second counter
 609   3            if (KVM_GetNextAutoScanHost(cAutoScanCurrentHost,&cAutoScanNextHost))
 610   3            {
 611   4              KVM_Select_Led_Control(cAutoScanCurrentHost,LED_OFF);
 612   4              cAutoScanCurrentHost = cAutoScanNextHost;
 613   4              KVM_Select_Led_Control(cAutoScanCurrentHost,LED_ON);
 614   4              KVM_CONSOLE_Vga_Control(cAutoScanCurrentHost,VGA_ON);
 615   4            }
 616   3          }
 617   2          else
 618   2          {
 619   3            if (iAutoScanSecCnt & 0x01)
 620   3            {
 621   4              KVM_Select_Led_Control(cAutoScanCurrentHost,LED_OFF);
 622   4            }
 623   3            else
 624   3            {
 625   4              KVM_Select_Led_Control(cAutoScanCurrentHost,LED_ON);
 626   4            }
 627   3          }
 628   2        }
 629   1        else
 630   1        {
 631   2          KVM_Select_Led_Control(cAutoScanCurrentHost,LED_OFF);
 632   2          if ((KVM_Control_Status & KVM_PORT_SW_MASK) == 0x00) // if not in autoscan stop & jump mode
 633   2          {
 634   3            KVM_Select_Led_Control(KVM_CurrentHost,LED_ON);
 635   3            KVM_CONSOLE_Vga_Control(KVM_CurrentHost,VGA_ON);
 636   3            
 637   3      #if (KVM_BUZZER_SUPPORT)
 638   3            BUZZER_Script_Active(AutoScan_Sound_Stop);
 639   3      #endif
 640   3          }
 641   2          TASK_Destory_Current();
 642   2        }
 643   1      }
