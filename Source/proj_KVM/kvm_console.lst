 441           * Params  : NONE
 442           * Returns : None.
 443           * Note    : None.
 444           *--------------------------------------------------------------------------------
 445           */
 446          void KVM_Autoscan_KB_Handle(U8_T codetype,U8_T keycode)
 447          {
 448   1        bit result = 0;
 449   1      
 450   1        if (KVM_Control_Status & KVM_AUTOSCAN_MASK)
 451   1        {
 452   2          if ((codetype & 0x01)) // key break type
 453   2          {
 454   3            if (KVM_Flash.AutoScanStop_JumpCode && (KVM_Flash.AutoScanStop_JumpCode == keycode))
 455   3            {
 456   4              KVM_AutoscanStop_Jump(1,cAutoScanCurrentHost);
 457   4              result = 1;
 458   4            }
 459   3            else
 460   3            {
 461   4              if ((KVM_Flash.AutoScanStopCode & keycode) == keycode)
 462   4              {
 463   5                result = 1;
 464   5              }
 465   4            }
 466   3            
 467   3            if (result)
 468   3            {
 469   4              KVM_Autoscan_Mode_Contorl(0);
 470   4              //KVM_Control_Status &= ~KVM_AUTOSCAN_MASK; // clear the autoscan flag
 471   4              //Task_Active_Table[TASK_KVM_AUTOSCAN_ACTIVE_ID].Task_Interval.w = 1; //wait for 1 ms
 472   4            }
 473   3          }
 474   2        }
 475   1      }
