1753          /*--------------------------------------------------------------------------------
1754           * U8_T KVM_Jump_Next_Power_Port(U8_T pid)
1755           * Purpose : This function will check the port vbus status
1756           * Params  : NONE
1757           * Returns : None.
1758           * Note    : None.
C51 COMPILER V9.60.7.0   KVM_CONSOLE                                                       06/23/2026 16:04:44 PAGE 30  

1759           *-------------------------------------------------------------------------------*/
1760          void KVM_Jump_Next_Power_Port(U8_T pid)
1761          { 
1762   1        U8_T newport;
1763   1        
1764   1        if (KVM_Flash.cSystemFlag0 & SYSTEM_JUMP_MODE_MASK) //jump by power
1765   1        { 
1766   2          newport = KVM_Power_Status_Check(pid+1,KVM_MAX_PORT);
1767   2          if (newport) //check backward
1768   2          {
1769   3            KVM_Port_Jump(newport-1);
1770   3          }             
1771   2          else
1772   2          {
1773   3            newport = KVM_Power_Status_Check(0,pid); //check forward
1774   3            if (newport)
1775   3            {
1776   4              KVM_Port_Jump(newport-1);           
1777   4            }
1778   3          }
1779   2        }
1780   1        else
1781   1        {
1782   2          KVM_NextHost = pid+1;
1783   2          if (KVM_NextHost >= KVM_MAX_PORT)
1784   2            KVM_NextHost = 0;       
1785   2          KVM_Port_Jump(KVM_NextHost);          
1786   2        }   
1787   1      }
