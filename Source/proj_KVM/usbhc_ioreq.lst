 425   1        //3-0.Actual Byte
 426   1        td_header->Byte0_Actual_Byte = 0;
 427   1        //2-2.(1)Toggle=>Data0
 428   1        //    (2)Active=>1
 429   1        //    (3)Complete code=>0x0f
 430   1        inf_id  = HC_IsoTransfer_Table[intt_id].InterfaceIdx;
 431   1        endp_id = HC_IsoTransfer_Table[intt_id].EndpIdx & USBHC_PDEV_ENDPIDX_MASK;
 432   1        td_header->Byte2_MaxPKT_Size = (USB_PDevice[devinx].EndpSize[inf_id][endp_id] & 0x00ff);
 433   1        td_header->Byte3 = (USB_PDevice[devinx].EndpSize[inf_id][endp_id] & 0x0300) >> 8;
 434   1        //2-3.(1)Speed
 435   1        //    (2)Endpoint Number
 436   1        endpaddr = (USB_PDevice[devinx].EndpAddr[inf_id][endp_id] & ~0x80) & 0x0f;
 437   1        endpaddr = endpaddr << 4;
 438   1        td_header->Byte3 |= (endpaddr); //ISO
 439   1        if (USB_PDevice[devinx].InterfaceNum & USBHC_DEVICE_SPEED_MASK) // Low Speed Device
 440   1          td_header->Byte3 |= TD_SPEED_LOW;
 441   1      
 442   1        //2-5.(1)Error Count(ingore)
 443   1        //    (2)Dir Token
 444   1        if (USB_PDevice[devinx].EndpAddr[inf_id][endp_id] & 0x80) // Isochronous IN
 445   1        {
 446   2          td_header->Byte5 &= ~TD_DIR_TOKEN_MASK;
 447   2          td_header->Byte5 |= TD_DIR_TOKEN_IN;
 448   2        }
 449   1        else
 450   1        {
 451   2          td_header->Byte5 &= ~TD_DIR_TOKEN_MASK;
 452   2          td_header->Byte5 |= TD_DIR_TOKEN_OUT;
 453   2        }
 454   1        //2-6.(1)Device Address
 455   1        td_header->Byte6_Function_Address = USB_PDevice[devinx].Addr & USBHC_DEVICE_ADDR_MASK;
 456   1        
 457   1        //2-7.(1)Starting frame
 458   1        td_header->Byte7 = 1; // This is the interval
 459   1        
 460   1        // Final Step
 461   1        //2-1.(1)Toggle=>Data0
 462   1        //    (2)Active=>1
 463   1        //    (3)Complete code=>0x0f
 464   1      //  if ((HC_IntTransfer_Table[intt_id].Control & USBHC_INTT_CON_TOGGLE_MASK) == USBHC_INTT_CON_DATA1)
 465   1      //  {
 466   1      //    td_header->Byte1 = TD_TOGGLE_DATA1; // the first bit
 467   1      //  }
 468   1      //  else
 469   1        {
 470   2          td_header->Byte1 = TD_TOGGLE_DATA0; // the first bit
 471   2        }
 472   1        td_header->Byte1 |= COMPLETEION_CODE_MASK;
 473   1      
 474   1        return USBH_OK;
C51 COMPILER V9.60.7.0   USBHC_IOREQ                                                       06/23/2026 16:04:46 PAGE 9   

 475   1      }
 476          
 477          /**
 478            * @brief  usbhc_Total_Byte_Fix(U8_T devinx,U16_T length)
 479            *         Used fixed Control TD TotalByte, must equal the
 480            *         max package size times factor. 
 481            *
 482            * @retval Status. 
 483            */
 484          static U16_T usbhc_Total_Byte_Fix(U8_T devinx, U16_T length)
 485          {
 486   1        U8_T  remain;
 487   1        U16_T total_byte_fix;
 488   1      
 489   1        if (length <= (U16_T)USB_PDevice[devinx].Hc.Control.EpN_MaxSize)
 490   1        {
 491   2          return ((U16_T)USB_PDevice[devinx].Hc.Control.EpN_MaxSize);
 492   2        }
 493   1          
 494   1        remain = (U8_T)(length % (U16_T)USB_PDevice[devinx].Hc.Control.EpN_MaxSize);
 495   1      
 496   1        if (remain)
 497   1        {
 498   2          total_byte_fix = (length - remain) + USB_PDevice[devinx].Hc.Control.EpN_MaxSize;
 499   2        }
 500   1        else
 501   1        {
 502   2          total_byte_fix = length;
 503   2        }
 504   1        
 505   1        return total_byte_fix;
 506   1      }
