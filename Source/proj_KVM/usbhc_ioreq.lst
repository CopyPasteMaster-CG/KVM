  28          /**
  29            * @brief  USBHC_CtlReq
  30            *         USBHC_CtlReq active a control task   
  31            * @param  devinx: Selected device
  32            * @param  td_id : Selected host channel  
  33            * @retval Status
  34            */
  35          USBH_Status USBHC_CtlReq (U8_T  devinx,U8_T td_id)
  36          {
  37   1        USB_PDevice[devinx].Hc.Control.State = CTRL_SETUP;
  38   1        TASK_Active(TASK_TYPE_USB,TASK_USBHC_Handle_Control_ID,td_id,devinx,0,0); // Generate the Setup Send comm
             -and
  39   1        return USBH_OK;
  40   1      }
  41          
