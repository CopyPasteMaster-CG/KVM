  42          /**
  43            * @brief  usbhc_Ctrl_TD_Header
  44            *         copy TD header 8 bytes for Host Hannel & Device Table
  45            * @param  devinx: Selected device
  46            * @param  td_id : Selected host channel
  47            * @retval td_offet
  48            */ 
  49          static U8_T usbhc_Ctrl_TD_Header(U8_T devinx,U8_T td_id)
  50          {
  51   1        USBHC_TD_Header_Typedef *td_header;
  52   1        U8_T          td_offset;
  53   1      
  54   1        td_offset = USBHC_CORE_TD_Offset(td_id);
  55   1      
  56   1        //1.Get td_header address
  57   1        td_header = (USBHC_TD_Header_Typedef *) &(HCTD_Table.ATL[td_offset].TD);
  58   1        //2.Fill up TD Header Content -------------------------------------------------------------
  59   1        //2-0.Actual Byte
  60   1        td_header->Byte0_Actual_Byte = 0;
  61   1        //2-1.(1)Toggle=>Data0
  62   1        //    (2)Active=>1
  63   1        //    (3)Complete code=>0x0f
  64   1        
  65   1        //2-2.(1)Toggle=>Data0
  66   1        //    (2)Active=>1
  67   1        //    (3)Complete code=>0x0f
  68   1        td_header->Byte2_MaxPKT_Size = HCTD_Channel_Table[td_id].Endp_Size;
  69   1        //2-3.(1)Speed
  70   1        //    (2)Endpoint Number
  71   1        td_header->Byte3 = (HCTD_Channel_Table[td_id].Attri & CHANNEL_ATRI_ENDPADDR_MASK) << 4;
  72   1        if (USB_PDevice[devinx].InterfaceNum & USBHC_DEVICE_SPEED_MASK) /* low speed device check */
  73   1          td_header->Byte3 |= TD_SPEED_LOW;
  74   1        //2-4.(1)Total Bytes
  75   1        td_header->Byte4_Total_Byte = HCTD_Channel_Table[td_id].TD_Length;
  76   1        //2-5.(1)Error Count(ingore)
  77   1        //    (2)Dir Token
  78   1        //    (3)Total Byte MSD
  79   1        td_header->Byte5  = ((HCTD_Channel_Table[td_id].TD_Length & 0x0300) >>8) | TD_DIR_TOKEN_SETUP;
  80   1        //2-6.(1)Device Address
  81   1        td_header->Byte6_Function_Address = USB_PDevice[devinx].Addr & USBHC_DEVICE_ADDR_MASK;
  82   1        //2-7.(1)Starting frame
  83   1        td_header->Byte7 = 0xff; // Nake Count
  84   1        
  85   1        td_header->Byte1 = COMPLETEION_CODE_MASK | TD_ACTIVED_MASK;
  86   1        return td_offset;
  87   1      }
  88          
  89          /**
  90            * @brief  usbhc_Ctrl_TD_Submit
  91            *         Submit the TD by setting SkipMap,DoneMap,ATLATV registers
  92            * @param  td_offet : Selected ATL TD offset number
  93            * @retval None
  94            */
  95          static void usbhc_Ctrl_TD_Submit(U8_T td_offset)
  96          {
  97   1        //1.Reset the DoneMap Flag
  98   1        USBHC_CORE_Clear_TD_DoneMap(USBHC_TD_ATL,td_offset);
  99   1        //2.Clear skip bit
 100   1        USBHC_CORE_Set_TD_SkipMap(USBHC_TD_ATL,td_offset,0x00); // clear the skip map
 101   1      }
