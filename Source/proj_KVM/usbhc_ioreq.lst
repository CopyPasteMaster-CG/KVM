 104            * @brief  USBHC_CtlSendSetup
 105            *         Sends the Setup Packet to the Device
 106            * @param  pdev: Selected device
 107            * @param  buff: Buffer pointer from which the Data will be send to Device
 108            * @param  hc_num: Host channel Number
 109            * @retval Status
 110            */
 111          void USBHC_CtlSendSetup(U8_T devinx,U8_T td_id)
 112          { 
 113   1        U8_T  td_offset, index;
 114   1      
 115   1        //1.Fill up TD Header & get TD offset
 116   1        td_offset = usbhc_Ctrl_TD_Header(devinx,td_id);
 117   1      
 118   1        //2.Copy setup command into data payload
 119   1        for (index=0; index < USBHC_SETUP_PKT_SIZE ; index++)
 120   1        {
 121   2          HCTD_Table.ATL[td_offset].Buf[index] = USB_PDevice[devinx].Hc.Control.Setup.d8[index];
 122   2        }
 123   1      
 124   1        //3.Sumbit the TD operation
 125   1        usbhc_Ctrl_TD_Submit(td_offset);
 126   1      }
