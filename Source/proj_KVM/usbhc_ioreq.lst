 128          /**
 129            * @brief  USBHC_CtlSendData
 130            *         Sends a data Packet to the Device
 131            * @param  pdev: Selected device
 132            * @param  buff: Buffer pointer from which the Data will be sent to Device
 133            * @param  length: Length of the data to be sent
 134            * @param  hc_num: Host channel Number
 135            * @retval Status
 136            */
 137          USBH_Status USBHC_CtlSendData (U8_T devinx,U8_T td_id,U16_T length)
 138          {
 139   1        U8_T  td,index;
 140   1        USBHC_TD_Header_Typedef *td_header;
 141   1      
 142   1        //1.Get the TD address
 143   1        td = USBHC_CORE_TD_Offset(USB_PDevice[devinx].Hc.Control.TdNum);
 144   1      
 145   1        td_header = (USBHC_TD_Header_Typedef *) &(HCTD_Table.ATL[td].TD);
 146   1        //2.Fill up TD Header Content
 147   1        //2-0.Actual Byte
 148   1        td_header->Byte0_Actual_Byte = 0;
 149   1        //2-2.(1)Toggle=>Data0
 150   1        //    (2)Active=>1
 151   1        //    (3)Complete code=>0x0f
 152   1        //td_header->Byte2_MaxPKT_Size = USBHC_SETUP_PKT_SIZE;
 153   1        td_header->Byte2_MaxPKT_Size = HCTD_Channel_Table[td_id].Endp_Size;
 154   1        //2-3.(1)Speed
 155   1        //    (2)Endpoint Number
 156   1        td_header->Byte3 = USBHC_EP0_EP_NUM;
 157   1        if (USB_PDevice[devinx].InterfaceNum & USBHC_DEVICE_SPEED_MASK) // Low Speed Device
 158   1          td_header->Byte3 |= TD_SPEED_LOW;
 159   1        //2-4.(1)Total Bytes
 160   1        if (length > USBHC_MAX_PACKET_SIZE)
 161   1          length = USBHC_MAX_PACKET_SIZE;
 162   1      
 163   1        td_header->Byte4_Total_Byte = (length & 0x00ff);
 164   1        td_header->Byte5 = (length & 0x0300) >>8;
 165   1        //2-5.(1)Error Count(ingore)
C51 COMPILER V9.60.7.0   USBHC_IOREQ                                                       06/23/2026 16:04:46 PAGE 4   

 166   1        //    (2)Dir Token
 167   1        td_header->Byte5 |= TD_DIR_TOKEN_OUT;
 168   1        //2-6.(1)Device Address
 169   1        td_header->Byte6_Function_Address = USB_PDevice[devinx].Addr & USBHC_DEVICE_ADDR_MASK;
 170   1        //2-7.(1)Starting frame
 171   1        td_header->Byte7 = 0xff; // next first frame
 172   1        //3.Copy setup command into data payload
 173   1        for (index=0;index < length ; index++)
 174   1        {
 175   2          HCTD_Table.ATL[td].Buf[index] = USB_PDevice[devinx].Hc.Control.Buf[USB_PDevice[devinx].Hc.Control.Curren
             -t_Length+index];
 176   2        }
 177   1        /* Final Step */ 
 178   1        //2-1.(1)Toggle=>Data0
 179   1        //    (2)Active=>1
 180   1        //    (3)Complete code=>0x0f
 181   1        if (length == 0)
 182   1          td_header->Byte1 = COMPLETEION_CODE_MASK | TD_ACTIVED_MASK | TD_TOGGLE_DATA1;
 183   1        else
 184   1          td_header->Byte1 |= COMPLETEION_CODE_MASK | TD_ACTIVED_MASK;
 185   1        //4.Reset the DoneMap Flag
 186   1        USBHC_CORE_Clear_TD_DoneMap(USBHC_TD_ATL,td);
 187   1        //4-1.Clear skip bit 
