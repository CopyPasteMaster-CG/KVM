 442          /*
 443           *--------------------------------------------------------------------------------
 444           * void HSUR_Setup(U16_T divisor, U8_T lCtrl, U8_T intEnb, U8_T fCtrl, U8_T mCtrl)
 445           * Purpose: Use this function can initialize the UART2 basic mode. It will configure
 446           *          the baudrate, data bus type, interrupt source, FIFO setup and modem status.
 447           * Params : divisor : A 16-bit Divisor Latch value to calaulate the baudrate.
 448           *          lCtrl : A value to Line Control Register.
 449           *          intEnb : The interrupt source type of Interrupt Enable Register.
 450           *          fCtrl : A value to FIFO Control Register.
 451           *          mCtrl : A value to Modem Control Register.
 452           * Returns: None.
 453           * Note   : None.
 454           *--------------------------------------------------------------------------------
 455           */
 456          void HSUR2_Setup(U16_T divisor, U8_T lCtrl, U8_T intEnb, U8_T fCtrl, U8_T mCtrl)
 457          {
 458   1        U8_T  lineCtrl, dll, dlh;
 459   1      
 460   1        hsur2IntrEnbType = intEnb;
 461   1        /* Set UART2 Baudrate */
 462   1        lineCtrl = HSLCR_DLAB_ENB;
 463   1        HSUR2_RegWrite(HSLCR, &lineCtrl, 1);
 464   1        dll = (U8_T)(divisor & 0x00FF);
 465   1        dlh = (U8_T)((divisor & 0xFF00) >> 8);
 466   1        HSUR2_RegWrite(HSDLLR, &dll, 1);
 467   1        HSUR2_RegWrite(HSDLHR, &dlh, 1);
 468   1        lineCtrl &= ~HSLCR_DLAB_ENB;
 469   1        HSUR2_RegWrite(HSLCR, &lineCtrl, 1);
 470   1        /* Set Line Control Register */
 471   1        lCtrl &= ~HSLCR_DLAB_ENB;
 472   1        HSUR2_RegWrite(HSLCR, &lCtrl, 1);
 473   1        /* Set FIFO Control Register */
 474   1        //hsur2FifoCtrl = fCtrl | HSFCR_RSTOP; // Enable the RSTOP bit to stop the data characters into RX FIFO.
 475   1        hsur2FifoCtrl = fCtrl; // Enable the RSTOP bit to stop the data characters into RX FIFO.
C51 COMPILER V9.60.7.0   HSUART_DRIVER                                                     06/18/2026 10:50:21 PAGE 9   

 476   1        hsur2FifoCtrl &= ~(HSFCR_RFR | HSFCR_TFR);
