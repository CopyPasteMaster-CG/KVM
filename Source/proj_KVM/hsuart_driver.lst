 207          /*
 208           *--------------------------------------------------------------------------------
 209           * BOOL HSUR2_RegWrite(U8_T addr, U8_T *ptData, U8_T dataLen)
 210           * Purpose: Write data bytes into a register with interrupt locked.
 211           * Params : addr:An index address to UART2 register.
 212           *          ptData:A pointer to indicate the register data.
 213           *          dataLen:A number of bytes to indicate how many bytes will be written.
 214           * Returns: TRUE (1) is success ; FALSE (0) is failure.
 215           * Note   : None.
 216           *--------------------------------------------------------------------------------
 217           */
 218          BOOL HSUR2_RegWrite(U8_T addr, U8_T *ptData, U8_T dataLen)
 219          {
 220   1        U8_T  oldEintBit = EINT4;
 221   1      
 222   1        EINT4 = 0;
 223   1        while (dataLen--)
 224   1        {
 225   2          UR2DR = *(ptData + dataLen);
 226   2        }
 227   1        UR2CIR = addr;
C51 COMPILER V9.60.7.0   HSUART_DRIVER                                                     06/18/2026 10:50:21 PAGE 5   

 228   1        EINT4 = oldEintBit;
 229   1      
 230   1        return TRUE;
 231   1      }
 232          
 233          /*
 234           *--------------------------------------------------------------------------------
 235           * BOOL HSUR2_RegRead(U8_T addr, U8_T *ptData, U8_T dataLen)
 236           * Purpose: Read data bytes from a register with interrupt locked.
 237           * Params : addr:An index address to UART2 register.
 238           *          ptData:A pointer to indicate the register data.
 239           *          dataLen:A number of bytes to indicate how many bytes will be read.
 240           * Returns: TRUE (1) is success ; FALSE (0) is failure.
 241           * Note   : None.
 242           *--------------------------------------------------------------------------------
 243           */
 244          BOOL HSUR2_RegRead(U8_T addr, U8_T *ptData, U8_T dataLen)
 245          {
 246   1        U8_T  oldEintBit = EINT4;
 247   1      
 248   1        EINT4 = 0;
 249   1        UR2CIR = addr;
 250   1        while (dataLen--)
 251   1        {
 252   2          *(ptData + dataLen) = UR2DR;
 253   2        }
 254   1        EINT4 = oldEintBit;
 255   1      
 256   1        return TRUE;
 257   1      }
 258          /*
 259           *--------------------------------------------------------------------------------
 260           * static void hsur_ReadLsr(void)
 261           * Purpose: Read the Line Status Register to record the error events in a counter.
 262           *          And begin the error recovering if happening many errors.
 263           * Params : None.
 264           * Returns: None.
 265           * Note   : None.
 266           *--------------------------------------------------------------------------------
 267           */
 268          static void hsur2_ReadLsr(void)
 269          {
 270   1        U8_T  lineStatus;
 271   1        U8_T  fifoCtrl;
 272   1        U16_T reg16b;
 273   1        
 274   1        UR2CIR = HSLSR;
 275   1        lineStatus = UR2DR;
 276   1      
 277   1        if (lineStatus & HSLSR_OE_OVER)
 278   1        {
 279   2          hsur2ErrCount ++;
 280   2          // Overrun Error
 281   2        }
 282   1        else if (lineStatus & HSLSR_PE_ERROR)
 283   1        {
 284   2          hsur2ErrCount ++;
 285   2          // Parity Error
 286   2        }
 287   1        else if (lineStatus & HSLSR_FE_ERROR)
 288   1        {
 289   2          hsur2ErrCount ++;
C51 COMPILER V9.60.7.0   HSUART_DRIVER                                                     06/18/2026 10:50:21 PAGE 6   

 290   2          // Framing Error
 291   2        }
 292   1        else if (lineStatus & HSLSR_BI_INT)
 293   1        {
 294   2          hsur2ErrCount ++;
 295   2          // Break Interrupt Occured
 296   2        }
 297   1        else if (lineStatus & HSLSR_FERR_ERROR)
 298   1        {
 299   2          hsur2ErrCount ++;
 300   2          // Mixing Error
 301   2        }
 302   1        /* For Error handling before data synchrony */
 303   1        if (hsur2ErrCount)
 304   1        {
 305   2          /* Enable the Receiver FIFO STOP (RSTOP) bit to stop data characters transfer into RX FIFO.
 306   2             And Reset Rx FIFO and TX FIFO */
 307   2          fifoCtrl = (hsur2FifoCtrl | HSFCR_RSTOP | HSFCR_RFR | HSFCR_TFR);
 308   2          UR2DR = fifoCtrl;
 309   2          UR2CIR = HSFCR;
 310   2          /* Read the error data pointer */
 311   2          UR2CIR = HSRBDEP;
 312   2          reg16b = (U16_T)UR2DR;
 313   2          reg16b |= (U16_T)UR2DR << 8;
 314   2          /* Flush all characters in the RX buffer ring by HSRBRP = HSRBWP when UART2 is in DMA mode */
 315   2          /*
 316   2          UR2CIR = HSRBWP;
 317   2          reg16b = (U16_T)UR2DR;
 318   2          reg16b |= (U16_T)UR2DR << 8;
 319   2          UR2DR = (U8_T)reg16b;
 320   2          UR2DR = (U8_T)(reg16b >> 8);
 321   2          UR2CIR = HSRBRP;
 322   2          ptHsur2RxDmaRingSwRead = (U8_T XDATA*)reg16b;
 323   2          */
 324   2          /* Disable the Receiver FIFO STOP (RSTOP) bit to re-start RX FIFO */
 325   2          fifoCtrl = (hsur2FifoCtrl | HSFCR_RFR | HSFCR_TFR);
 326   2          fifoCtrl &= ~HSFCR_RSTOP;
 327   2          UR2DR = fifoCtrl;
 328   2          UR2CIR = HSFCR;
 329   2      
 330   2          if (hsur2ErrCount >= 100)
 331   2          {
 332   3      //      hsur2ErrBlocking = 1;
 333   3            /* Disable the UART2 interrupt */
 334   3            UR2DR = 0;
 335   3            UR2CIR = HSIER;
 336   3          }
 337   2        }
 338   1      }
 339          
 340          /*
 341           * ----------------------------------------------------------------------------
 342           * void HSUR2_IntrEntryFunc(void)
 343           * Purpose : HSUART interrupt service routine. For sending out, it puts data
 344           *           from software buffer into hardware serial buffer register (SBUF0).
 345           *           For receiving, it gets data from hardware serial buffer register
 346           *           (SBUF0) and stores into software buffer.
 347           * Params  : none
 348           * Returns : none
 349           * Note    : none
 350           * ----------------------------------------------------------------------------
 351           */
C51 COMPILER V9.60.7.0   HSUART_DRIVER                                                     06/18/2026 10:50:21 PAGE 7   

 352          void HSUR2_IntrEntryFunc(void)
 353          { 
 354   1        U8_T  intrStatus;
 355   1        U8_T  ur2DmaIntrStatus;
 356   1        U16_T temp16b = 0;
 357   1      //  U8_T  temp8b[2];
 358   1      
 359   1        UR2CIR = HSIIR;
 360   1        intrStatus = UR2DR; 
 361   1        intrStatus &= 0x1F; 
 362   1        
 363   1        if ((intrStatus & HSIIR_RLS_INTR) == HSIIR_RLS_INTR)
 364   1        {
 365   2          hsur2_ReadLsr();
 366   2          return;
 367   2        }
 368   1        //else if (intrStatus == HSIIR_DMAS_INTR)
 369   1        if (intrStatus == HSIIR_DMAS_INTR)
 370   1        { /* DMA interrupt flag */
 371   2          UR2CIR = HSDSR;
 372   2          ur2DmaIntrStatus = UR2DR;
 373   2          
 374   2          //Assing to ISR handle 
 375   2          ISR_FIFO[ISR_FIFO_Wp].ISR_Type = ISR_HUART;
 376   2          ISR_FIFO[ISR_FIFO_Wp].Data = ur2DmaIntrStatus;        
 377   2          
 378   2          ISR_FIFO_Wp++;
 379   2          if (ISR_FIFO_Wp >= ISR_FIFO_DEPTH)
 380   2            ISR_FIFO_Wp = 0;      
 381   2          return;
 382   2        } 
 383   1        //else if ((intrStatus == HSIIR_RD_TI_INTR) || (intrStatus == HSIIR_RD_TRIG_INTR))  
 384   1        if ((intrStatus & HSIIR_RD_TI_INTR) == HSIIR_RD_TRIG_INTR)  
 385   1        { /* Receiver Timeout */    
 386   2          // Assing to ISR handle     
 387   2          UR2CIR = HSRBR;               
 388   2          hsuart_RxBuf[hsuart_RxTail] = UR2DR;
 389   2          
 390   2          hsuart_RxTail++;
 391   2          hsuart_RxTail &= MAX_RX_HSUART_MASK;
 392   2          ISR_FIFO[ISR_FIFO_Wp].ISR_Type = ISR_UART1;
 393   2          //ISR_FIFO[ISR_FIFO_Wp].Data = intrStatus;
 394   2          if (++ISR_FIFO_Wp >= ISR_FIFO_DEPTH)
 395   2          {
 396   3            ISR_FIFO_Wp = 0;
 397   3          } 
 398   2        }
 399   1        
 400   1        if ((intrStatus & HSIIR_TFE_INTR) == HSIIR_TFE_INTR)
 401   1        { /* Transmitte complete */       
 402   2          if (hsuart_TxCount > 0)
 403   2          {
 404   3            hsuart_TxTail++;
 405   3            hsuart_TxTail &= MAX_TX_HSUART_MASK;    
 406   3            hsuart_TxCount--;
 407   3            if (hsuart_TxCount > 0)     
 408   3            { 
 409   4              UR2DR = hsuart_TxBuf[hsuart_TxTail];
 410   4              UR2CIR = HSTHR;           
 411   4            }
 412   3            else
 413   3            {
C51 COMPILER V9.60.7.0   HSUART_DRIVER                                                     06/18/2026 10:50:21 PAGE 8   

 414   4              hsuart_TxFlag = 0;
 415   4            }       
 416   3          }
 417   2          else
 418   2          { 
 419   3            hsuart_TxFlag = 0;
 420   3          } 
 421   2        }
 422   1      }
