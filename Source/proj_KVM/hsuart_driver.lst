 424          /*
 425           *--------------------------------------------------------------------------------
 426           * void HSUR2_Start(void)
 427           * Purpose: Start function will enable the interrupt sources that be configured
 428           *          in the setup function. This function should be closely called before
 429           *          running application tasks.
 430           * Params : None.
 431           * Returns: None.
 432           * Note   : None.
 433           *--------------------------------------------------------------------------------
 434           */
 435          void HSUR2_Start(void)
 436          {
 437   1        /* Enable the UART2 interrupt */
 438   1        //HSUART_PutStr("IER=%02x\r",(U16_T)hsur2IntrEnbType);
 439   1        HSUR2_RegWrite(HSIER, &hsur2IntrEnbType, 1);
 440   1      }
