 487          /*
 488           * ----------------------------------------------------------------------------
 489           * S8_T HSUART_PutChar(S8_T c)
 490           * Purpose : HSUART output function. This function puts one byte data into the
 491           *           software character buffer.
 492           * Params  : c - one byte character.
 493           * Returns : c - one byte character.
 494           * Note    : none
 495           * ----------------------------------------------------------------------------
 496           */
 497          S8_T HSUART_PutChar(S8_T c)
 498          {
 499   1        U16_T count = 0;  
 500   1        
 501   1        do
 502   1        { 
 503   2          count = hsuart_TxCount;     
 504   2        } while (count == MAX_TX_HSUART_MASK);    
 505   1        hsuart_TxBuf[hsuart_TxHead] = c;  
 506   1        hsuart_TxCount++;   
 507   1        hsuart_TxHead++;
 508   1        hsuart_TxHead &= MAX_TX_HSUART_MASK;
 509   1      
 510   1        if (!hsuart_TxFlag)
 511   1        { 
 512   2          hsuart_TxFlag = 1;
 513   2          EINT4 = 0;  
 514   2          UR2DR = hsuart_TxBuf[hsuart_TxTail];; 
 515   2          UR2CIR = HSTHR; 
 516   2          EINT4 = 1;  
 517   2        } 
 518   1        return c;
 519   1      }
 520          
 521          /*
 522           * ----------------------------------------------------------------------------
 523           * S8_T *HSUART_PutStr(S8_T *format,...)  
 524           * Purpose : HSUART initial function. It will call a real initial function
 525           *           corresponding to the used HSUART port.
 526           * Params  : none
 527           * Returns : none
 528           * Note    : none
 529           * ----------------------------------------------------------------------------
 530           */
 531          BOOL HSUART_PutStr(char *str)
 532          {               
 533   1          while(*str != 0x00) 
 534   1          {          
 535   2              HSUART_PutChar(*str);
 536   2          str++;
 537   2          }      
C51 COMPILER V9.60.7.0   HSUART_DRIVER                                                     06/18/2026 10:50:21 PAGE 10  

 538   1        
 539   1        return 1;
 540   1      }    
