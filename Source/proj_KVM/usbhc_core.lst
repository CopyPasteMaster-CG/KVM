2546          /*-------------------------------------------------------------------------------------------
2547           * void USBHC_CORE_Build_ISTL_Polling(U8_T devinx)
2548           * Purpose : build the istl tranfer table & ISTL0 relative setting
C51 COMPILER V9.60.7.0   USBHC_CORE                                                        06/23/2026 16:04:46 PAGE 43  

2549           * Params  :  
2550           * Returns : none
2551           * Note    : none
2552           *-------------------------------------------------------------------------------------------*/
2553          void USBHC_CORE_Build_ISTL_Polling(U8_T devinx)
2554          {
2555   1        U8_T  inf_index,end_index,td_id,interfacenum;
2556   1      
2557   1        interfacenum = USB_PDevice[devinx].InterfaceNum & USBHC_DEVICE_INTERFACENUM_MASK;
2558   1        for (inf_index=0; inf_index < interfacenum; inf_index++) // Check Eache Interface
2559   1        {
2560   2          for (end_index=0; end_index < USB_PDevice[devinx].EndpNum[inf_index]; end_index++) // Check all the endp
             -oint in this interface
2561   2          {
2562   3            if ((USB_PDevice[devinx].EndpType[inf_index][end_index] & USB_EP_TYPE_MASK) == USB_EP_TYPE_ISOC) //if e
             -ndpoint is interrupt transfer
2563   3            {
2564   4              /* Check out endpoint direction */
2565   4              if (USB_PDevice[devinx].EndpAddr[inf_index][end_index] & USB_EP_DIR_IN) // IN
2566   4              {
2567   5                td_id = 1; // ISTL[1] td for IN direction
2568   5              }
2569   4              else
2570   4              {       
2571   5                td_id = 0; // ISTL[0] td for OUT direction
2572   5              }
2573   4              
2574   4              /* Request an isochornous software table */
2575   4              if (USBHC_CORE_QueryAlloc_IsoTransfer_Table(td_id) == FALSE)
2576   4              {
2577   5                //printf("No free ISTL can used\n\r");
2578   5                return;
2579   5              }
2580   4      
2581   4              /* Fill the table */
2582   4              HC_IsoTransfer_Table[td_id].Used_DeviceID |= devinx;
2583   4              HC_IsoTransfer_Table[td_id].InterfaceIdx = inf_index;
2584   4              HC_IsoTransfer_Table[td_id].EndpIdx = end_index;
2585   4              HC_IsoTransfer_Table[td_id].EndpAddr = USB_PDevice[devinx].EndpAddr[inf_index][end_index];            
             -    
2586   4              /* Keep the table id in USB_PDevice[] */
2587   4              USB_PDevice[devinx].EndpType[inf_index][end_index] |= (td_id & 0x1f);
2588   4              
2589   4              /* Fill the ISTL TD */
2590   4              USBHC_Istl_ReqData(devinx, td_id);
2591   4      
2592   4              /* Clear the DoneMap */
2593   4              USBHC_CORE_Clear_TD_DoneMap(USBHC_TD_ISTL, td_id);
2594   4            }
2595   3          }
2596   2        }
2597   1      }
