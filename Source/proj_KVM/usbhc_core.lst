                if (!(int_state & HC_INT_STATE_SUS_MASK))
                {
                  PowerSavingInhibitFlag = 1;
                }
               #endif
              #endif
 349   1      
 350   1        //Check SOF Interrupt
 351   1        usbhc_IntrStateFlag = (int_state & ~(HC_INT_STATE_SOF_SET | HC_INT_STATE_ISTL0_SET));
C51 COMPILER V9.60.7.0   USBHC_CORE                                                        06/23/2026 16:04:46 PAGE 7   

 352   1      
