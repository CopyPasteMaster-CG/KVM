 362   2          USBHC_ISR_FIFO[USBHC_ISRQ_Wp].OP_ISR_State = op_state;
 363   2      
 364   2          //2.Check Operation Interrupt Status
 365   2          if (op_state & HC_OPINT_STATE_RHSC_MAP_MASK)
 366   2          {
 367   3            //1.Check Port0 status changed condition
 368   3            portmask = HC_ROOTHUB_STATUSCHANGED_PORT0_MASK;
 369   3            for (portindex = 0; portindex < USB_HC_MAX_PORT; portindex++)
 370   3            {
 371   4              if (op_state & portmask)
