1965          /** ----------------------------------------------------------------------------
1966           * void USBHC_CORE_Clear_TD_Register(U8_T td_id)
1967           * Purpose: After plug off form hc, clear the relative register in TD
1968           * Params:  NONE
1969           * Returns: NONE
1970           * Note:
1971           * ----------------------------------------------------------------------------*/
1972          void USBHC_CORE_Clear_TD_Register(U8_T td_id)
1973          {
1974   1        U8_T td;
1975   1        
1976   1        // Calculate the position in the td buffer table
1977   1        if (td_id < USB_HC_ISTL_MAX)
1978   1        {
1979   2          // clear ISTL TD
1980   2          USBHC_CORE_Set_TD_SkipMap(USBHC_TD_ISTL, td_id, 0x01);
1981   2        }
1982   1        else if (td_id < (USB_HC_ISTL_MAX + USB_HC_INTL_MAX))
1983   1        {
1984   2          // clear INTL TD
1985   2          td = td_id - USB_HC_ISTL_MAX; // this is the real td id
1986   2      
1987   2          //1.Set ATL skip table on
1988   2          USBHC_CORE_Set_TD_SkipMap(USBHC_TD_INTL, td, 0x01);
1989   2        }
1990   1        else
1991   1        {
1992   2          // clear ATL TD
1993   2          td = td_id - (USB_HC_ISTL_MAX + USB_HC_INTL_MAX); // this is the real td id
1994   2      
1995   2          //1.Set ATL skip table on
1996   2          USBHC_CORE_Set_TD_SkipMap(USBHC_TD_ATL, td, 0x01);
1997   2        }
1998   1      }
