1582          void USBHC_CORE_SetBit(U8_T *tab,U8_T index,U8_T value)
1583          {
1584   1        U8_T byte,targetbit;
1585   1        
1586   1        byte = index >> 3; // every byte 8 bits
1587   1        targetbit = 0x01 << (index & 0x07);
1588   1        if (value)   // bet bit
1589   1        {
1590   2          tab[byte] |= targetbit;
1591   2        }
1592   1        else
1593   1        {
1594   2          tab[byte] &= ~targetbit;
1595   2        }
1596   1      }
