 181          /**
 182          * @brief  USBHC_Classreq_GetHubDesc
 183          *         Issue Get Hub Descriptor command to the device. Once the response 
 184          *         received, parse the report descriptor and update the status.
 185          * @param  pdev   : Selected device
 186          * @param  Length : HUB Descriptor Table Length
 187          * @retval USBHC_Status : Response for USB HID Get Report Descriptor Request
 188          */
 189          USBH_Status USBHC_Classreq_GetHubDesc (U8_T devinx,U8_T td_id,U16_T length)
 190          {
 191   1        //1.TD Parameter
 192   1        HCTD_Channel_Table[td_id].TD_Length = USBHC_SETUP_PKT_SIZE;
 193   1        HCTD_Channel_Table[td_id].Total_Length = length; // no data stage
 194   1        HCTD_Channel_Table[td_id].Current_Length = 0;
 195   1        //2.Descriptor Read
 196   1        return USBHC_GetDescriptor(devinx,
 197   1                       td_id,
 198   1                       USB_REQ_RECIPIENT_DEVICE | USB_REQ_TYPE_CLASS,
 199   1                       0x2900,
 200   1                       0x00,
 201   1                       length);
 202   1      }
