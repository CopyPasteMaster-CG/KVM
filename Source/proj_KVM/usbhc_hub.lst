 611          {
 612   1        U8_T  index;
 613   1      
 614   1        for (index=0; index < 8 ; index++)
 615   1        {
 616   2          if (_ValBit(usbhc_Address_Table, index) == 0x00)
 617   2          {
 618   3            return index + 8;
 619   3          }
 620   2        }
 621   1        return 0;
 622   1      }
