 680           *          
 681           * Params  : none
 682           * Returns : RESULT
 683           * Note    : none
 684           * ----------------------------------------------------------------------------*/
 685          void TASK_USBHC_HUB_RemoveDevinx(void)
 686          {
 687   1        U8_T  devinx,hubports,hubdevinx,index,addr;
 688   1      
 689   1        devinx = TASK_Register0;
 690   1        TASK_Destory_Current();
 691   1        
 692   1        if ((devinx < USBDC_VIRTUAL_DEVINX) ||
 693   1          (devinx >= (USB_HC_MAX_DEVICE+USB_HC_MAX_HUB)) ||
 694   1          !(USB_PDevice[devinx].Addr & USBHC_DEVICE_USED_MASK)) // this should not happened
 695   1        {
