 204          /*----------------------------------------------------------------------------
 205           * CTRL_State USBHC_Class_GetHubDesc(U8_T devinx,U8_T td_id)
 206           * Purpose : Perform the set address operation of enumearation
 207           * Params  : none
 208           * Returns : none
 209           * Note    : none
 210           * ----------------------------------------------------------------------------*/
 211          RESULT USBHC_Class_GetHubDesc(U8_T devinx,U8_T td_id)
 212          {
 213   1        RESULT          Result=USB_ERROR;
 214   1        U8_T          buf_len;
 215   1        USBHC_HUBDec_Typedef  *phubdec;
 216   1        
 217   1        if (USB_PDevice[devinx].Hc.Control.State == CTRL_IDLE)
 218   1        {
 219   2          if (USBHC_Control_TD_Init(devinx,&td_id) == USBH_OK)
 220   2          {
 221   3            //1.Get dynamic buffer memory
 222   3            USB_PDevice[devinx].Hc.Control.Buf = m_malloc(9,13); /* allocate 9 bytes */
 223   3            HCTD_Channel_Table[td_id].Buf = USB_PDevice[devinx].Hc.Control.Buf; // also assign to host channel buff
             -er
 224   3            if (USB_PDevice[devinx].Hc.Control.Buf == NULL)
 225   3            {
C51 COMPILER V9.60.7.0   USBHC_HUB                                                         06/23/2026 16:04:46 PAGE 5   

 226   4              USBHC_CORE_Free_TD(td_id);
 227   4              USBHC_Memory_Fail_Msg(0x04);
 228   4              USB_PDevice[devinx].Hc.HUB_EnumState = HUB_ENUM_FAIL;
 229   4            }
 230   3            else
 231   3            {
 232   4              //Send out Setup Control Token
 233   4              USBHC_Classreq_GetHubDesc(devinx,td_id,0x08);
 234   4              Result=USB_BUSY;
 235   4            }
 236   3          }
 237   2          else
 238   2          {
 239   3            //printf("Hub: Failed to allocate TD\r\n");
 240   3            TASK_Wait_Current();
 241   3          }
 242   2        }
 243   1        else
 244   1        {
 245   2          //parser descri_ptor
 246   2          if ((USB_PDevice[devinx].Hc.Control.State == CTRL_COMPLETE) ||
 247   2          (USB_PDevice[devinx].Hc.Control.State == CTRL_STALLED))
 248   2          {
 249   3            //Copy HUB Descriptor into PUSB Table
 250   3            USB_PDevice[devinx].Desc[HUB_DESC].Len = 9; // store the length
 251   3            USB_PDevice[devinx].Desc[HUB_DESC].Ptr = USB_PDevice[devinx].Hc.Control.Buf;
 252   3            USB_PDevice[devinx].Desc[HUB_DESC].Ptr[8] = 0xFF;
 253   3            USB_PDevice[devinx].Hc.Control.Buf = NULL;
 254   3            //Parser Hub Descriptor
 255   3            phubdec = (USBHC_HUBDec_Typedef *)USB_PDevice[devinx].Desc[HUB_DESC].Ptr;
 256   3            USB_PDevice[devinx].Hub_NbrPorts |= phubdec->bNbrPorts;
 257   3            buf_len = sizeof(USBHC_HubReportTypeDef) * phubdec->bNbrPorts;
 258   3            USB_PDevice[devinx].HUB.ReportState = m_malloc(buf_len,14);
 259   3            memset((U8_T *)USB_PDevice[devinx].HUB.ReportState,0x00,buf_len);
 260   3            //Prepare next enumeration operation.
 261   3            USBHC_HUB_Feature = PORT_POWER;
 262   3            USBHC_HUB_FeatureType= SET_FEATURE;
 263   3            usbhc_HUB_Port = 0;
 264   3            USB_PDevice[devinx].HUB.HubStatus = HUB_INIT_POWER;
 265   3            USB_PDevice[devinx].Hc.HUB_EnumState = HUB_SET_FEATURE;
 266   3            USB_PDevice[devinx].Hc.Control.State = CTRL_IDLE;
 267   3            Result=USB_SUCCESS;
 268   3          }
 269   2          else
 270   2          {
 271   3            //Due to have to release the buffer, so need put the satement here
 272   3            //proces alos if the State is not COMPLETE
 273   3            malloc_free(USB_PDevice[devinx].Hc.Control.Buf);
 274   3            USB_PDevice[devinx].Hc.Control.Buf = 0;
 275   3          }
 276   2        }
 277   1        return Result;
 278   1      }
