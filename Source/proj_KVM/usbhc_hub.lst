 697   2          return;
 698   2        }
 699   1        printf("> KVM:Devinx=%bx Class %bx,CLEAR register ..\n\r", devinx, USB_PDevice[devinx].DevClass); 
 700   1        if (USB_PDevice[devinx].DevClass == USB_HUB_CLASS)
 701   1        {
 702   2          hubports = USB_PDevice[devinx].Hub_NbrPorts & USBHC_HUBPORT_MASK;
 703   2          /*record every devinx in the hub*/
 704   2          for (index=0; index < hubports; index++)
 705   2          {
 706   3            hubdevinx = (USB_PDevice[devinx].HUB.ReportState+index)->Devinx;
 707   3            if (hubdevinx >= USBDC_VIRTUAL_DEVINX)
 708   3            {
 709   4              (USB_PDevice[devinx].HUB.ReportState+index)->Devinx = 0;
 710   4              TASK_USBHC_HUB_RemoveDevinx_Fork(hubdevinx);
 711   4              addr = USB_PDevice[hubdevinx].Addr & USBHC_DEVICE_ADDR_MASK;
 712   4              USBHC_HUB_ReleaseAddress(addr);
