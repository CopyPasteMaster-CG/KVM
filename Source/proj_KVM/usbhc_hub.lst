 358          /*----------------------------------------------------------------------------
 359           * void USBHC_HUB_StatusChangeHandle(U8_T devinx,U8_T inttid)
 360           * Purpose : Handle the HUB Status Changed Interrupt responsed
 361           * Params  : none
 362           * Returns : none
 363           * Note    : none
 364           * ----------------------------------------------------------------------------*/
 365          void USBHC_HUB_StatusChangeHandle(U8_T devinx,U8_T intt_id)
 366          {
 367   1        U8_T  hub_status_change;
 368   1        U8_T  maxport,td_id;
 369   1        U8_T  index;
 370   1        U8_T  portbit = 0x01;
 371   1        U8_T  enubit;
 372   1      
 373   1        hub_status_change = HCTD_Table.INTL[intt_id].Buf[0];
 374   1        maxport = USB_PDevice[devinx].Hub_NbrPorts & USBHC_HUBPORT_MASK;
 375   1        for (index=0; index < maxport; index++)
 376   1        {
 377   2          portbit <<= 1;
 378   2          if (hub_status_change & portbit) // indicate the port status changed
 379   2          {
 380   3            if (USB_PDevice[devinx].Hub_Enu_Port_Id)
 381   3            {
 382   4              enubit = (0x01 << USB_PDevice[devinx].Hub_Enu_Port_Id);
 383   4              if (enubit != portbit)
 384   4              {
 385   5                continue;
 386   5              }
 387   4            }
 388   3            //Prepare next enumeration operation.
 389   3            usbhc_HUB_Control_Prepare(devinx,index,GET_STATUS,0x00);
 390   3            USB_PDevice[devinx].Hc.HUB_EnumState = HUB_GET_PORT_STATUS;
 391   3            if (USBHC_Control_TD_Init(devinx,&td_id) == USBH_OK)
 392   3            {
 393   4              USB_PDevice[devinx].HUB.HC_qt_Bk = USB_PDevice[devinx].Hc.gState;
 394   4              USB_Hub_Class_Enumerate_Fork(devinx);
 395   4            }
 396   3            break;
 397   3          }
 398   2        }
 399   1      }
