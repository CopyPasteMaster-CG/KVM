 354          /*******************************************************************************
 355          * Function Name  : USBDC_VHub_Update_StatusChange.
 356          * Description    : Move the Hub Status Change Report data into endp buffer 
 357          * Input          :  
 358          * Output         : None.
 359          * Return         : None
 360          *******************************************************************************/
 361          void USBDC_VHub_Update_StatusChange(U8_T devinx,U8_T startport,U8_T end_port,U8_T resume)
 362          {
 363   1        U8_T  port;
 364   1        U8_T  hubport;
 365   1        bit   status_changed;
 366   1        
 367   1        for (port = startport; port <= end_port ; port++)
 368   1        {
 369   2          //1. status change
 370   2          if (resume)
 371   2          { 
 372   3            USBDC_WakeupUpstreamHost(port);
 373   3          }
 374   2          
 375   2          USBDC_Device[devinx].VHub->HubChanged[port] = 0;
 376   2          status_changed = 0;
 377   2          for (hubport = 0; hubport < USBDC_VHUB_PORT_NUM; hubport++)
 378   2          {
 379   3            if (USBDC_Device[devinx].VHub->PortStatus[port][hubport].wPortChangeL)
 380   3            {
 381   4              status_changed = 1;
 382   4              USBDC_Device[devinx].VHub->HubChanged[port] |= (0x01 << (hubport+1));
 383   4            }
 384   3          }
 385   2          
 386   2          if (status_changed) 
 387   2          {
 388   3            USBDC_VHub_Hub_Status_Change_Report_Ack(devinx,port);
 389   3          }
 390   2          else
 391   2          {
 392   3            USBDC_VHub_Hub_Status_Change_Report_Nak(devinx,port);
 393   3          }
 394   2        }
 395   1      }
