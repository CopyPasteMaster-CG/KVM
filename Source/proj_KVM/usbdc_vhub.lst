 429          /*******************************************************************************
 430          * Function Name  : USBDC_VHub_UpPort_Reset.
 431          * Description    : Move the Hub Status Change Report data into endp buffer 
 432          * Input          :  
 433          * Output         : None.
 434          * Return         : None
 435          *******************************************************************************/
 436          void USBDC_VHub_UpPort_Reset(U8_T devinx,U8_T pid)
 437          {
 438   1        U8_T index;
 439   1        U8_T hubport = USBDC_VHUB_PORT_NUM;
 440   1        U8_T hubdev; // start for DC root hub
 441   1        U8_T DownStreamMap[7];
 442   1        U8_T map = 0;
 443   1        U8_T current_map = 0; // max 5 hub device
 444   1        
 445   1        //Clear Current Upstream Port
 446   1      RESCAN_DOWNSTREAM_PORT:
 447   1        for (index = 0; index < hubport; index++)
 448   1        {
 449   2          memset(&USBDC_Device[devinx].VHub->PortStatus[pid][index],0x00,(sizeof(USBDC_VHubReportTypeDef)-1));
 450   2          hubdev = USBDC_Device[devinx].VHub->PortStatus[pid][index].Devinx;
 451   2          if (hubdev)  // if the donwstream port is connect with HUB
 452   2          {
 453   3            if (USB_PDevice[hubdev].DevClass == USB_HUB_CLASS) // if hub class,then clear status
 454   3            {
 455   4              DownStreamMap[map] = hubdev;
 456   4              map++;
 457   4            }
 458   3          }
 459   2        }
C51 COMPILER V9.60.7.0   USBDC_VHUB                                                        06/18/2026 10:50:18 PAGE 9   

 460   1        USBDC_Device[devinx].VHub->HubChanged[pid] = 0x00;
 461   1        
 462   1        if (current_map != map)
 463   1        {
 464   2          devinx = DownStreamMap[current_map];
 465   2          current_map++;
 466   2          
 467   2          hubport = USB_PDevice[devinx].Hub_NbrPorts & USBHC_HUBPORT_MASK;
 468   2          goto RESCAN_DOWNSTREAM_PORT;
 469   2        }
 470   1      }
