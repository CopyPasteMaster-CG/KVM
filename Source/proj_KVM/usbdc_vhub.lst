 194          RESULT USBDC_VHub_Port_ClearFeature(U8_T devinx,U8_T port,U8_T feature,U8_T hubport)  //Operation,PowerNum
             -ber
 195          {
 196   1        U8_T vdevinx;
 197   1      
 198   1        hubport--;
 199   1        if (feature == PORT_ENABLE) // port to clear the enable, so disalbe the port now
 200   1        {
 201   2          vdevinx = USBDC_Device[devinx].VHub->PortStatus[port][hubport].Devinx;
 202   2      
 203   2          if (vdevinx)
 204   2          {
 205   3            USBDC_HAL_Address_Active(port, vdevinx, RESET);
 206   3          }
 207   2          USBDC_Device[devinx].VHub->PortStatus[port][hubport].wPortStatusL &= ~L_PortStatus_Enable;
 208   2        }
 209   1      
 210   1        if (feature >= 16 && feature <= 20)
 211   1        {
 212   2          feature -= 16;
 213   2          USBDC_Device[devinx].VHub->PortStatus[port][hubport].wPortChangeL &= ~VHub_Port_Changed_Bit[feature];
 214   2        }
 215   1        USBDC_VHub_Update_StatusChange(devinx,port,port,0);
 216   1        return USB_SUCCESS;
 217   1      }
