 511          void USBDC_VHub_Resume_Port(U8_T port,U8_T target_devinx)
 512          {
 513   1        U8_T upperdevinx;
 514   1        U8_T upperhubport;
 515   1        
 516   1        if (USB_PDevice[target_devinx].Addr & USBHC_DEVICE_USED_MASK)
 517   1        { 
 518   2          if (USBDC_Device[target_devinx].Feature[port] & FEATURE_SUSPEND)//this device go suspend                               
 519   2          {
 520   3            //check upper layer devinx & class
 521   3            //upperdevinx = USB_PDevice[target_devinx].UpperHubDevinx;
C51 COMPILER V9.60.7.0   USBDC_VHUB                                                        06/18/2026 10:50:18 PAGE 10  

 522   3            //upperhubport = USBDC_Virtual_Hub_Map[target_devinx].Devinx_HubPort;
 523   3            USBHC_Get_Upper_Device_Info(target_devinx,&upperdevinx,&upperhubport);
 524   3            USBDC_Device[target_devinx].Feature[port] &= ~FEATURE_SUSPEND;//this device go suspend                                
             -         
 525   3            USBDC_Device[upperdevinx].VHub->PortStatus[port][upperhubport].wPortChangeL |= L_PortChange_Suspend;      
 526   3            USBDC_VHub_Update_StatusChange(upperdevinx,port,port,1);
 527   3          }
 528   2        }        
 529   1      }
