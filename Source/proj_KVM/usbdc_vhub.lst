 473          /*******************************************************************************
 474          * void USBDC_VHub_Reset_Attribute(U8_T port,U8_T devinx)
 475          * Description    : This function will check all the device protocol setting
 476          *                  value,if different with initial state,then reset to 0
 477          * Input          :  
 478          * Output         : None.
 479          * Return         : None
 480          *******************************************************************************/
 481          void USBDC_VHub_Reset_Attribute(U8_T port,U8_T devinx)
 482          {
 483   1        U8_T inf_inx,inf_bit;
 484   1        
 485   1        /* Reset the Protcol,Configuration & Alternateing setting */
 486   1        USBDC_VIRTUAL_Port_Clear(port,devinx,devinx+1);
 487   1        if (port == KVM_CurrentHost)  // only port is in active then check the protocol setting
 488   1        {
 489   2          for (inf_inx=0 ; inf_inx < USB_PDevice[devinx].InterfaceNum ;inf_inx++)
 490   2          {
 491   3            inf_bit = 0x01 << inf_inx;
 492   3            if (USB_PDevice[devinx].InfClass[inf_inx] == USB_HID_CLASS) // if it is hid class
 493   3            {       
 494   4              if ((USB_PDevice[devinx].Current_Protocol & inf_bit) != 0) //if in boot protocol, then reset it
 495   4              {                 
 496   5                USBHC_Set_Dev_Inf_Protocol(devinx,inf_inx,0,1);
 497   5              }
 498   4            }
 499   3          }
 500   2        }
 501   1      }
