 100          BOOL DMA_CheckStatus(void)
 101          {
 102   1        U8_T XDATA  temp;
 103   1      
 104   1        while (1)
C51 COMPILER V9.60.7.0   DMA                                                               06/18/2026 10:50:21 PAGE 3   

 105   1        {
 106   2          DMA_RegRead(SW_DMA_STATUS_REG, &temp, 1);
 107   2          if (temp & DMA_ERROR_STU)
 108   2          {
 109   3            return FALSE;
 110   3          }
 111   2          else if (temp & DMA_COMPLETE_STU)
 112   2            break;
 113   2        }
 114   1        return TRUE;
 115   1      
 116   1      } /* End of DMA_CheckStatus */
