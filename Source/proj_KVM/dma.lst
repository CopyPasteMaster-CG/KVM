 118          /*
 119           * ----------------------------------------------------------------------------
 120           * BOOL DMA_DataToProgram(U32_T addrDest, U32_T addrSour, U16_T length)
 121           * Purpose: This function is responsible to copy data from external data memory
 122           *          to program memory. It will check DMA status automatically
 123           *          after DMA begin copying.
 124           * Params : addrDest¡GThe destination address in program memory.
 125           *          addrSour¡GThe source address in external data memory.
 126           *          length¡GThe total length that S/W DMA has need to copy.
 127           * Returns: 0 : DMA error had happened
 128           *      1 : DMA had completed.
 129           * Note   :
 130           * ----------------------------------------------------------------------------
 131           */
 132          BOOL DMA_DataToProgram(U32_T addrDest, U32_T addrSour, U16_T length)
 133          {
 134   1        U32_T cmd32b = 0;
 135   1        U8_T  cmd8b = 0;
 136   1      
 137   1          if (length == 0)
 138   1              return FALSE;
 139   1      
 140   1        cmd32b = (U32_T)addrSour << 8;
 141   1        DMA_RegWrite(SW_DMA_SOURCE_ADDR_REG, (U8_T *)&cmd32b, 3);
 142   1      
 143   1        cmd32b = (U32_T)addrDest << 8;
 144   1        DMA_RegWrite(SW_DMA_TARGET_ADDR_REG, (U8_T *)&cmd32b, 3);
 145   1      
 146   1        DMA_RegWrite(SW_DMA_BYTE_COUNT_REG, (U8_T *)&length, 2);
 147   1      
 148   1        cmd8b = (DMA_CMD_GO | DMA_TA_IN_PROG_MEM);
 149   1        DMA_RegWrite(SW_DMA_CMD_REG, (U8_T *)&cmd8b, 1);
 150   1      
 151   1        return (DMA_CheckStatus());
 152   1      }
