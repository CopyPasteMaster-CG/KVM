C51 COMPILER V9.60.7.0   DMA                                                               06/18/2026 10:50:21 PAGE 2   

  43          void DMA_RegRead(U8_T regaddr, U8_T XDATA* pbuf, U8_T length)
  44          {
  45   1        dma_isr = EA;
  46   1        EA = 0;
  47   1        DCIR = regaddr;
  48   1        while (length--)
  49   1          pbuf[length] = DDR;
  50   1        EA = dma_isr;
