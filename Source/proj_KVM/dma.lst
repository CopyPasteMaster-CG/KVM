 170          BOOL DMA_GrantXdata(U8_T XDATA* pdest, U8_T XDATA* psour, U16_T length)
 171          {
 172   1        volatile U8_T XDATA temp[3];
 173   1        U16_T XDATA*    ptempshort = (U16_T XDATA*)&temp[1];
 174   1      //  U8_T        dmatype = 0;
 175   1        U8_T        bitEa, result;
 176   1      
 177   1        if (!length || pdest == psour)
 178   1        {
 179   2          return FALSE;
 180   2        }
 181   1      
 182   1        bitEa = EA;
 183   1        EA = OFF;
 184   1      
 185   1        /* set source address indirect register */
 186   1        *ptempshort = psour;
 187   1        DDR = temp[2];
 188   1        DDR = temp[1];
 189   1        DDR = 0; /* temp[0] is always 0 */
 190   1        DCIR = SW_DMA_SOURCE_ADDR_REG;
 191   1      
 192   1        /* set target address indirect register */
 193   1        *ptempshort = pdest;
 194   1        DDR = temp[2];
 195   1        DDR = temp[1];
 196   1        DDR = 0; /* temp[0] is always 0 */
 197   1        DCIR = SW_DMA_TARGET_ADDR_REG;
 198   1      
 199   1        /* set length */
 200   1        *ptempshort = length;
 201   1        DDR = temp[2];
 202   1        DDR = temp[1];
 203   1        DCIR = SW_DMA_BYTE_COUNT_REG;
 204   1      
 205   1        DDR = DMA_CMD_GO;
 206   1        DCIR = SW_DMA_CMD_REG;
 207   1      
