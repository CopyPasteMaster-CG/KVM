  65          void DMA_RegWrite(U8_T regaddr, U8_T XDATA* pbuf, U8_T length)
  66          {
  67   1        dma_isr = EA;
  68   1        EA = 0;
  69   1        while (length--)
  70   1          DDR = pbuf[length];
  71   1        DCIR = regaddr;
  72   1        EA = dma_isr;
