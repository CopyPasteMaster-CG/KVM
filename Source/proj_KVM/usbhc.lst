2262   2            Result = USBHC_SCM_SetProtocol(devinx,td_id,intf_id,mode);
2263   2            break;
2264   2          case SCMD_SET_CONFIGURATION:
2265   2            Result = USBHC_SCM_SetConfiguration(devinx,td_id,para2);
2266   2            break;
2267   2          case SCMD_SET_INTERFACE:
2268   2            Result = USBHC_SCM_SetInterface(devinx,td_id,para2);
2269   2            break;
2270   2          case SCMD_SET_HUB_FEATURE:      
2271   2            Result = USBHC_SCM_SetHubFeature(devinx,td_id,para2);
2272   2            break;
2273   2          case SCMD_CLEAR_HUB_FEATURE:      
2274   2            Result = USBHC_SCM_ClearHubFeature(devinx,td_id,para2);
2275   2            break;
2276   2          case SCMD_CLEAR_FEATURE:
2277   2            break;
2278   2          case SCMD_SET_IDLE:
2279   2            Result = USBHC_SCM_SetIdle(devinx,td_id,para2);
2280   2            break;
2281   2        }
2282   1      
2283   1        if (Result == USB_SUCCESS)
2284   1        {
