 821          /**
 822          * @brief  Big_Endian_16_Convert 
 823          *         Displays the message on LCD for device descriptor
 824          * @param  DeviceDesc : device descriptor
 825          * @retval None
 826          */
 827          U16_T Big_Endian_16_Convert(U16_T big_edin)
 828          {
 829   1        return (((big_edin & 0xff00) >> 8) + ((big_edin & 0x00ff) << 8));
 830   1      }
C51 COMPILER V9.60.7.0   USBHC                                                             06/18/2026 10:50:18 PAGE 15  

 831          
 832          #if ((SYSTEM_USB_PEN_DRIVE_SUPPORT) || (SYSTEM_MSC_DEVICE_SUPPORT) || (SYSTEM_EXTENDER_MSC_SUPPORT))
              /**
              * @brief  Big_Endian_32_Convert 
              *         Convert the samll_endian U32_T to big endian U32_T
              * @param  DeviceDesc : device descriptor
              * @retval None
              */
              U32_T Endian_32_Convert(U32_T endian)
              {
                U32_T convert;
                
                convert = ((endian & 0xff000000) >> 24);
                convert += ((endian & 0x00ff0000) >>  8);
                convert += ((endian & 0x0000ff00) <<  8);
                convert += ((endian & 0x000000ff) << 24);
                
                return convert;
              }
              #endif /* (SYSTEM_USB_PEN_DRIVE_SUPPORT) || (SYSTEM_MSC_DEVICE_SUPPORT) */
