  20           * -------------------------------------------------------------------------------
  21           *               Standard Request(bRequest)
  22           *               [v].Get Status(0x00)
  23           *               [v].Clear Feature(0x01)
  24           *               [v].Set Feature(0x03)
  25           *               [v].Set Address(0x05)               wValueH
  26           *               [v].Get Descriptor(0x06)----------> [v].Device(0x01)
  27           *               [v].Set Descriptor(0x07)            [v].Config(0x02)
  28           *               [v].Get Config(0x08)                [v].String(0x03)
  29           *               [v].Set Config(0x09)                [v].HID(0x021)  
  30           *               [v].Get Interface(0x0A)             [v].Report(0x22)
  31           *               [v].Set Interface(0x0B)             [ ].Physical(0x23)
  32           *               [ ].Sync Frame
  33           *               [v].Stall
  34           *================================================================================
  35           */
