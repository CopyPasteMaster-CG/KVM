2188          /**
2189          * @brief  TASK_USBHC_Scm_Handle
2190          *         USB Host core singole command state machine process
2191          * @param  None 
2192          * @retval None
2193          */
2194          void TASK_USBHC_Scm_Handle_Start(void)
2195          {
2196   1        U8_T  devinx, td_id, para2;
2197   1      
2198   1        devinx = TASK_Register0;
2199   1        para2 = TASK_Register1;
2200   1        
2201   1        /* Skip task if the device is gone */
2202   1        if ((USB_PDevice[devinx].Addr & USBHC_DEVICE_USED_MASK) == 0x00)  // Device is gone  
2203   1        { 
2204   2          return;
2205   2        }
2206   1        
2207   1        /* Check if HC state machine not idle now */  
2208   1        if (USBHC_State_Machine_Busy_Check(devinx))
2209   1        {
2210   2          TASK_Wait_Current();
2211   2          return;
2212   2        }
2213   1        
2214   1        /* Get Free TD of ATL */
2215   1        if (USBHC_Control_TD_Init(devinx,&td_id) != USBH_OK)
2216   1        {
2217   2          TASK_Wait_Current();
2218   2          return;
2219   2        }
2220   1      
2221   1        /* Now Occupy the SCM State Machine */
2222   1        USB_PDevice[devinx].Hc.ScmdState = USB_PDevice[devinx].Hc.ScmdStep;
2223   1        USB_PDevice[devinx].Hc.gState = HOST_SCM;
2224   1        TASK_Active(TASK_TYPE_USB, TASK_USBHC_Scm_Handle_ID, 0, devinx, para2, 0); //Generate the task, for next 
             -Event check
2225   1      }
