2162   2        }
2163   1        
2164   1        if (USB_PDevice[devinx].Hc.HUB_EnumState)
2165   1        {
2166   2          return 4;
2167   2        }
2168   1        
2169   1        if (USB_PDevice[devinx].Hc.ScmdState)
