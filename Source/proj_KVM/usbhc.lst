 179          */
 180          void TASK_USBHC_Process(void)
 181          {
 182   1        U8_T  devinx = TASK_Register0;
 183   1      
 184   1        //Skip task if the device is gone
 185   1        if ((USB_PDevice[devinx].Addr & USBHC_DEVICE_USED_MASK) == 0x00)  // Device is gone  
 186   1        {
 187   2          return;
 188   2        }
 189   1      
 190   1      TASK_USBHC_Process_Restart:
 191   1        switch (USB_PDevice[devinx].Hc.gState)
 192   1        {
 193   2          case HOST_DEV_RESET: // Root hub port reset:Hub Port Status Changed
 194   2            //Check Port enable & connect
 195   2            break;
 196   2          case HOST_DEV_RESET_WAIT: // Root hub port reset:Hub Port Status Changed
 197   2            //Check Port enable & connect
 198   2            break;
 199   2          case HOST_DEV_ATTACHED: // Device attached in root hub downstream port
 200   2            // Next step go for enumeration.
 201   2            USB_PDevice[devinx].Hc.gState = HOST_ENUMERATION; // start do Enumeration operation
 202   2            //USB_PDevice[devinx].Hc.EnumState = ENUM_SET_ADDR; // Do set addressing
 203   2            USB_PDevice[devinx].Hc.EnumState = ENUM_START; 
 204   2            USB_PDevice[devinx].Hc.Control.State = CTRL_IDLE;
 205   2      
 206   2          case HOST_ENUMERATION:
 207   2            if (USB_PDevice[devinx].Hc.EnumState == ENUM_IDLE) // Do set addressing
 208   2            {
 209   3              if ( USB_PDevice[devinx].Hc.Control.State == CTRL_FAIL)
 210   3              {
 211   4                printf("@@ENU@@ ERROR:Devinx:%bd,Skip Next Class Enumerate\n\r", devinx);
 212   4                USBHC_RootHub_Bus_Occupy_Flag = 0; //unlock the root hub connection enumeration
 213   4                USBHC_HUB_ReleaseEnumerateOperation();
 214   4                USB_PDevice[devinx].Hc.EnumState = HID_ENUM_IDLE;
 215   4                USB_PDevice[devinx].Hc.Control.State = CTRL_IDLE;
 216   4                USBHC_Remove_Device(devinx, 0); //remove the device
 217   4              }
 218   3              else
 219   3              {
 220   4                USB_PDevice[devinx].Hc.gState = HOST_HID_CLASS_ENUMERATION;
 221   4                goto TASK_USBHC_Process_Restart;
 222   4              }
 223   3            }
 224   2            else
 225   2            {
