2241   1      
2242   1        //Skip task if the device is gone
2243   1        if ((USB_PDevice[devinx].Addr & USBHC_DEVICE_USED_MASK) == 0x00)  // Device is gone  
2244   1        { 
2245   2          return; 
2246   2        }
2247   1        
2248   1        switch (USB_PDevice[devinx].Hc.ScmdStep)
2249   1        {
2250   2          case SCMD_SET_LED_REPORT:
2251   2            Result = USBHC_SCM_SetLedReport(devinx,td_id);
2252   2            break;
2253   2          case SCMD_SET_UNIFYING_REPORT:
2254   2            Result = USBHC_SCM_SetUnifyingReport(devinx,td_id,para2);
2255   2            break;
2256   2          case SCMD_SET_UNIFYING_HID: //HID++ mode or HID mode
2257   2            Result = USBHC_SCM_SetUnifyingHID(devinx,td_id,para2);
