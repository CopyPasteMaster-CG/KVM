 565          /*
 566           * -------------------------------------------------------------------------------------------
 567           * void TASK_USBHC_RootHub_PowerON(void)
 568           * Purpose : Will do the Root hub initial process after the hc controller reset
 569           * Params  :   
 570           * Returns : none
 571           * Note    : 
 572           *           root hub power on flow:
 573           *           Power Power On => generate a interrupt of port chagned
 574           * ISR       root hub state:0x61,0x01 => Connect Change+Power On status
 575           *           Port Reset=> need 30ms (generate a interrupt of port chagned)
 576           * ISR       root hub state:0x63,0x10 => Reste Complete,Power On+Connect+Enable
 577           * -------------------------------------------------------------------------------------------
 578           */
 579          void TASK_USBHC_RootHub_PowerON(void)
 580          {
 581   1        U8_T port;
 582   1      
 583   1        for (port=0; port < USB_HC_MAX_PORT; port++)
 584   1        {
 585   2          if (USBHC_Port_Power_On_State & RootHubPortID[port])
 586   2          {
 587   3            USBHC_RootHub_PowerON(port);
 588   3            USBHC_Port_Power_On_State &= ~RootHubPortID[port];
 589   3          }
 590   2        }
 591   1        TASK_Destory_Current();
 592   1      } 
