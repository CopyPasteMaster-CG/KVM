 594          /*
 595           * -------------------------------------------------------------------------------------------
C51 COMPILER V9.60.7.0   USBHC_ROOTHUB                                                     06/23/2026 16:04:47 PAGE 11  

 596           * void TASK_USBHC_RootHub_Reset(void)
 597           * Purpose : Monitor the Will do the Root hub housekeeping maintain process
 598           * Params  :  
 599           * Returns : none
 600           * Note    : none
 601           * -------------------------------------------------------------------------------------------
 602           */
 603          void TASK_USBHC_RootHub_Reset(void)
 604          {
 605   1        U8_T rhpid,reg[2];
 606   1      
 607   1        reg[0] = TASK_Event & TASK_EVENT_SERIAL_MASK;  // get Port ID
 608   1        rhpid  = TASK_Register0;  // get Port ID
 609   1          
 610   1        if (reg[0] != USBHC_RootHub_ResetTaskSerial[rhpid])
 611   1        { 
 612   2          TASK_Destory_Current();
 613   2          return;
 614   2        }
 615   1        
 616   1        if ((USBHC_RootHub_State_Hold[rhpid] & HC_RH_STATE_CCS_MASK) == HC_RH_STATE_CCS_SET) // if device still c
             -onnected
 617   1        {
 618   2          if (USBHC_RootHub_Bus_Occupy_Flag == 0) // wait for other port reset complete
 619   2          {
 620   3            if (USBHC_HUB_Enumerate_Occupy_Flag == 0) /*if no other hub port in enumearation opeartion */
 621   3            {
 622   4              //1.Fill Up root hub port reset register        
 623   4              USBHC_RootHub_Bus_Occupy_Flag = 1;
 624   4              USBHC_RootHub_Bus_Occupy_ID = rhpid;
 625   4      
 626   4              //Port Reset
 627   4              reg[0] = HC_RH_CON_SPR_SET;
 628   4              reg[1] = 0;
 629   4              USBHC_Write_Regs(USBHC_RootHub_Cmd_Reg[rhpid],reg,2);
 630   4              USBHC_RootHub_ResetCnt=1;
 631   4      #if (USBHC_ROOTHUB_DEBUG_MODE)
 632   4              printf("0USBHC:Port(%d),Reset %d Times..\n\r",(U16_T)rhpid,(U16_T)USBHC_RootHub_ResetCnt);
 633   4      #endif
 634   4            }
 635   3          }
 636   2          else
 637   2          {
 638   3            if (USBHC_RootHub_Bus_Occupy_ID == rhpid) // this is second time to get 
 639   3            {
 640   4              USBHC_RootHub_ResetCnt++;
 641   4      #if (USBHC_ROOTHUB_DEBUG_MODE)
 642   4              printf("1USBHC:Port(%d),Reset %d Times..\n\r",(U16_T)rhpid,(U16_T)USBHC_RootHub_ResetCnt);
 643   4      #endif
 644   4              //Port Reset
 645   4              if (USBHC_RootHub_ResetCnt == ROOT_HUB_RESET_COUNTER)
 646   4              {
 647   5                reg[0] = HC_RH_CON_SPR_SET;
 648   5                reg[1] = 0;
 649   5                USBHC_Write_Regs(USBHC_RootHub_Cmd_Reg[rhpid],reg,2);
 650   5              }
 651   4      
 652   4              if (USBHC_RootHub_ResetCnt >= ROOT_HUB_RESET_COUNTER)
 653   4              {
 654   5                TASK_Destory_Current(); // terminiate now
 655   5              }
 656   4            }
C51 COMPILER V9.60.7.0   USBHC_ROOTHUB                                                     06/23/2026 16:04:47 PAGE 12  

 657   3          }
 658   2        }
 659   1        else
 660   1        {
 661   2      #if (USBHC_ROOTHUB_DEBUG_MODE)    
 662   2          printf("USBHC:Cancel reset for device disconnected\n\r");   
 663   2      #endif    
 664   2          if (USBHC_RootHub_Bus_Occupy_ID == rhpid) // this is second time to get 
 665   2          {
 666   3            USBHC_RootHub_Bus_Occupy_Flag = 0;
 667   3          } 
 668   2          TASK_Destory_Current();
 669   2        }
 670   1      }
