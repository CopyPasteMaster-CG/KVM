 672          /** -------------------------------------------------------------------------------------------
 673           * void TASK_USBHC_RootHub_OverCurrent(void)
 674           * Purpose : After the overcurrent status happenied, need software to set power on, and check
 675           *           the ovrecurrent release condition.
 676           * Params  :  
 677           * Returns : none
 678           * Note    : none
 679           * -------------------------------------------------------------------------------------------*/
 680          void TASK_USBHC_RootHub_OverCurrent(void)
 681          {
 682   1      #if USBHC_OC_FORCE_SW_RESET
                CPU_SoftReboot();
                TASK_Destory_Current();
              #else
 686   1        /* Check hardware TD activity */
 687   1        if (USBHC_RootHub_HcTdActivityRecord == USBHC_TD_Activity_Cnt)
 688   1        {
 689   2          /* TD not activity, record fail count */
 690   2          if (++USBHC_RootHub_HcTdActivityFailCnt >= 3)
 691   2          {
 692   3            /* HC is deadlock, do software reset */
 693   3            USBHC_RootHub_HcTdActivityFailCnt = 0;
 694   3            TASK_Destory_Current();
 695   3            //printf("Do software reset\n\r");
 696   3            CPU_SoftReboot();
 697   3            return;
 698   3          }
 699   2          /* Wait for the checking next time */
 700   2        }
 701   1        else
 702   1        {
 703   2          /* HC is still alived, destroy current task */
 704   2          //printf("HC TD still alived!!\n\r");
 705   2          TASK_Destory_Current();
 706   2        }
 707   1      #endif
 708   1      }
