 203          /*
 204           *--------------------------------------------------------------------------------
 205           * void CPU_MscRegRead(U8_T regIndex, U8_T *pRegData, U8_T regLen)
 206           * Purpose: Read data bytes from a register with interrupt locked.
 207           * Params : regIndex:An index address to register.
 208           *          pRegData:A pointer to indicate the register data.
 209           *          regLen:A number of bytes to indicate how many bytes will be read.
 210           * Returns: TRUE (1) is success ; FALSE (0) is failure.
 211           * Note   : None.
 212           *--------------------------------------------------------------------------------
 213           */  
 214          void CPU_MscRegRead(U8_T regIndex, U8_T *pRegData, U8_T regLen)
 215          {
 216   1        cpu_isr = EA;
 217   1        EA = 0;
 218   1        MCIR = regIndex;
 219   1        while (regLen --)
 220   1        {
 221   2          *(pRegData + regLen) = MDR;
 222   2        }
 223   1        EA = cpu_isr;
 224   1      }
