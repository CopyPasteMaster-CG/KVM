  87   2            CKCON = 0x00;
  88   2            FDR = 0x00;
  89   2            FCIR = FLH_FWATR;
  90   2            MDR = 0x00;
  91   2            MDR = 0x5D;
  92   2            MDR = 0x00;
  93   2            MCIR = MISC_C12MSTBR;
  94   2            break;
  95   2          case SCS_96M :
  96   2          default :
  97   2            CPU_SysClk = SCS_96M;
  98   2            WTST = 0x03;
  99   2            CKCON = 0x00;
 100   2            FDR = 0x00;
 101   2            FCIR = FLH_FWATR;
