1226   1      #if (SYSTEM_USBAUDIO_DEVICE_SUPPORT)
                U8_T reg;
              #endif  
1229   1      
1230   1        if (USBDC_UpPortState[pid] & (USBDC_ROOTHUB_SUSPEND_MASK | USBDC_ROOTHUB_RESUME_MASK))
1231   1        {
1232   2          USBDC_UpPortState[pid] &= ~(USBDC_ROOTHUB_SUSPEND_MASK|USBDC_ROOTHUB_RESUME_MASK);
1233   2          USBDC_VIRTUAL_Port_Status_Control(pid,FEATURE_RESUME|FEATURE_SUSPEND,RESET);
1234   2      
1235   2      #if (SYSTEM_USBAUDIO_DEVICE_SUPPORT)
                  if (pid == KVM_CurrentUSBAudio)
                  {
                    if (HC_IsoTransfer_Table[USB_HC_ISTL_OUT_MAX].Used_DeviceID & USBHC_DEVICE_USED_MASK)
                    {
                      EXTINT3_DISABLE;
                      USBHC_AUDIO_In_Start();
                      EXTINT3_ENABLE;
                    }
                  
                    if (HC_IsoTransfer_Table[0].Used_DeviceID & USBHC_DEVICE_USED_MASK)
                    {
                      reg = (KVM_CurrentUSBAudio & 0x03);
                      USBHC_Write_Regs(HC_SOF_SELECT_REG, &reg, 1);
                      reg = HC_SOF_SELECT_USPSE_SET | (KVM_CurrentUSBAudio & 0x03);
                      USBHC_Write_Regs(HC_SOF_SELECT_REG, &reg, 1);
                    }
                  }
              #endif
1254   2          
1255   2          #ifdef KMLOG
                  KMLog_Send_Host_State();
                  #endif
1258   2        } 
1259   1      }
