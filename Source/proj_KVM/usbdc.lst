1936   3            {
1937   4              if (esmr & DC_IESMR_BAVA1) // Buffer is empty, then skip
1938   4              {
1939   5                return (2|buf_cnt) ;
1940   5              }
1941   4            }
1942   3            else 
1943   3            { 
1944   4              if (esmr & DC_IESMR_BAVA0)
1945   4              {
1946   5                return (1|buf_cnt);
1947   5              }
1948   4            }
1949   3          }
1950   2          else
1951   2          {
1952   3            if (buf_cnt == (DC_IESMR_BAVA0|DC_IESMR_BAVA1))
1953   3              return 0;
1954   3      
1955   3            if (buf_cnt == 0x00)
1956   3              buf_cnt = 2;
1957   3            else
1958   3              buf_cnt = 1;
1959   3      
1960   3            buf_cnt <<= 4;
1961   3            if (esmr & DC_IESMR_CBUF) //Buffer 1 avaiable
1962   3            {
1963   4              if ((esmr & DC_IESMR_BAVA1) == 0x00) // Buffer is empty, then skip
1964   4              {
1965   5                return ((buf_cnt|2)) ;
1966   5              }
1967   4            }
1968   3            else 
1969   3            {
1970   4              if ((esmr & DC_IESMR_BAVA0) == 0x00)
1971   4              {
1972   5                return ((buf_cnt|1));
1973   5              }
1974   4            }
1975   3          }
1976   2        }
1977   1        else
1978   1        {
1979   2          if (dir == DA_EP_CFGR_DIR_OUT)
1980   2          {
1981   3            if ((esmr & DC_IESMR_BAVA0) == 0x00)
1982   3            {
1983   4              return 0x00;
1984   4            }
1985   3            else
1986   3              return 0x11;
1987   3          }
1988   2          else
1989   2          {
1990   3            if ((esmr & DC_IESMR_BAVA0) == 0x00)
1991   3            {
1992   4              return 0x11;
1993   4            }
1994   3            else
C51 COMPILER V9.60.7.0   USBDC                                                             06/18/2026 10:50:18 PAGE 34  

1995   3              return 0x00;
1996   3          }
1997   2        }
1998   1        return 0;
