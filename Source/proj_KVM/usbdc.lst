2001          /**----------------------------------------------------------------------------
2002           * U8_T USBDC_Get_Endp_Interval(U8_T port,U8_T devinx,U8_T endpinx)
2003           * Purpose: Calculate the endpoint interval time base on interval0, interval1
2004           * Params : NONE
2005           * Returns: 
2006           * Note:
2007           *----------------------------------------------------------------------------*/
2008          U8_T USBDC_Get_Endp_Interval(U8_T port,U8_T devinx,U8_T endpinx)
2009          {
2010   1        U8_T interval,interval0,interval1;
2011   1      
2012   1        interval0 = USBDC_Device[devinx].EndpInterval0[port][endpinx];
2013   1        interval1 = USBDC_Device[devinx].EndpInterval1[port][endpinx];
2014   1      
2015   1        if (interval0 > interval1)
2016   1        {
2017   2          interval = (0xff - interval0) + interval1 + 1;
2018   2        }
2019   1        else
2020   1        {
2021   2          interval = interval1 - interval0;
2022   2        }
2023   1      
2024   1        return interval;
2025   1      }
