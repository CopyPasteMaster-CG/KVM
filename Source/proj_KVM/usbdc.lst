1638   4              USBDC_Device[devinx].VHub->PortStatus[pinx][vhub_port].wPortStatusH &= ~(H_PortStatus_HighSpeed|H_Port
             -Status_LowSpeed);  //Force Full Speed device /*Importtant*/
