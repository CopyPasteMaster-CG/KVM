1907          U8_T USBDC_Check_Endp_Buffer_Valid(U8_T port,U8_T devinx,U8_T endpinx)
1908          {
1909   1        U8_T esmr,buf_cnt=0,daepcfgr[2];
1910   1        U8_T double_buf,dir;
1911   1             
1912   1        //1.Check the Double Buffer
1913   1        esmr = DA_EP_CFGR[devinx]+(endpinx << 1);
1914   1        USBDC_Read_Regs(port,esmr,&daepcfgr,2);
1915   1        double_buf  = daepcfgr[0] & DA_EP_CFGR_DBUF_MASK;
1916   1        dir     = daepcfgr[0] & DA_EP_CFGR_DIR_MASK;
1917   1        
1918   1        //2.Check the Buffer valid id
1919   1        USBDC_Read_Regs(port,DA_EP_SR[devinx][endpinx],&esmr,1);
1920   1      
1921   1        if (double_buf)
1922   1        {
1923   2          buf_cnt = esmr & (DC_IESMR_BAVA0|DC_IESMR_BAVA1);
1924   2          if (dir == DA_EP_CFGR_DIR_OUT)
1925   2          {
1926   3            if (buf_cnt == 0x00)
1927   3              return 0;
1928   3      
1929   3            if (buf_cnt == (DC_IESMR_BAVA0|DC_IESMR_BAVA1))
1930   3              buf_cnt = 2;
1931   3            else
1932   3              buf_cnt = 1;
