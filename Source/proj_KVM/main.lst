 541           * void malloc_free(void)
 542           * Purpose : free the malloc memory
 543           * Params  : None 
 544           * Returns : None
 545           * Note    : The length can not large than 0xff
 546           *--------------------------------------------------------------------------------*/
 547          void malloc_free(void xdata *buf)
 548          {
 549   1        if (buf != 0)
 550   1        {
 551   2          if (buf >= USB_Dynamic_Memory &&
 552   2            buf < (USB_Dynamic_Memory + USB_DYNAMIC_MEMORY_SIZE))
 553   2          {
 554   3            free(buf);
 555   3            //printf("m-(%lx)\n\r",(U32_T)buf);
 556   3          }
 557   2        }
 558   1      }
