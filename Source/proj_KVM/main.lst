 494          /*--------------------------------------------------------------------------------
 495           * void ISR_Init(void)
 496           * Purpose : Initial the ISR Fifo Table
 497           * Params  : $ *p  => Address
 498           *           $ len => display length
 499           * Returns : None
 500           * Note    : The length can not large than 0xff
 501           *--------------------------------------------------------------------------------*/
 502          void ISR_Init(void)
 503          {
 504   1        memset(ISR_FIFO,0x00,sizeof(ISR_FIFO));
 505   1        ISR_FIFO_Rp = 0;
 506   1        ISR_FIFO_Wp = 0;
 507   1      }
 508          
 509          /*--------------------------------------------------------------------------------
 510           * void malloc_free(void)
 511           * Purpose : free the malloc memory
 512           * Params  : None 
 513           * Returns : None
 514           * Note    : The length can not large than 0xff
 515           *--------------------------------------------------------------------------------*/
 516          void malloc_free(void xdata *buf)
 517          {
 518   1        if (buf != 0)
 519   1        {
 520   2          if (buf >= USB_Dynamic_Memory &&
 521   2            buf < (USB_Dynamic_Memory + USB_DYNAMIC_MEMORY_SIZE))
 522   2          {
 523   3            free(buf);
 524   3            //printf("m-(%lx)\n\r",(U32_T)buf);
 525   3          }
 526   2        }
 527   1      }
