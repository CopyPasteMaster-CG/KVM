 169          S8_T UART0_PutChar(S8_T c)
 170          {
 171   1        U16_T count = 0;
 172   1      
 173   1        do
 174   1        {
 175   2          ES0 = 0;
 176   2          count = uart0_TxCount;
 177   2          ES0 = 1;
 178   2        } while (count == MAX_TX_UART0_BUF_SIZE);
 179   1        uart0_TxBuf[uart0_TxHead] = c;
 180   1        ES0 = 0;
 181   1        uart0_TxCount++;
 182   1        ES0 = 1;
 183   1        uart0_TxHead++;
 184   1        uart0_TxHead &= MAX_TX_UART0_MASK;
 185   1      
 186   1        if (!uart0_TxFlag)
 187   1        {
 188   2          uart0_TxFlag = 1;
 189   2          SBUF0 = uart0_TxBuf[uart0_TxTail];
 190   2        }
 191   1      
 192   1        return c;
 193   1      }
