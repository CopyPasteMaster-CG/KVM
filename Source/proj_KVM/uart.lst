  48          /*
  49           * ----------------------------------------------------------------------------
  50           * static void uart_ISR(void)
  51           * Purpose : UART0 interrupt service routine. For sending out, it puts data
  52           *           from software buffer into hardware serial buffer register (SBUF0).
  53           *           For receiving, it gets data from hardware serial buffer register
  54           *           (SBUF0) and stores into software buffer.
  55           * Params  : none
  56           * Returns : none
  57           * Note    : none
  58           * ----------------------------------------------------------------------------
  59           */
  60          static void uart0_ISR(void) interrupt UR0_VECTOR
  61          {
  62   1        if (RI0)
  63   1        {
  64   2          //if (uart0_RxCount != MAX_RX_UART0_BUF_SIZE) 
  65   2          {
  66   3            uart0_RxBuf[uart0_RxTail] = SBUF0;
  67   3            //uart0_RxCount++;
  68   3            uart0_RxTail++;
  69   3            uart0_RxTail &= MAX_RX_UART0_MASK;
  70   3            ISR_FIFO[ISR_FIFO_Wp].ISR_Type = ISR_UART0;
  71   3            //ISR_FIFO[ISR_FIFO_Wp].Data = cpu_Gpio0IntrStatus;
  72   3            if (++ISR_FIFO_Wp >= ISR_FIFO_DEPTH)
  73   3            {
  74   4              ISR_FIFO_Wp = 0;
  75   4            } 
  76   3          }
  77   2          RI0 = 0;
  78   2        } /* End of if(RI0) */
  79   1      
  80   1        if (TI0)
  81   1        {
  82   2          uart0_TxTail++;
  83   2          uart0_TxTail &= MAX_TX_UART0_MASK;
  84   2          uart0_TxCount--;
  85   2          if (uart0_TxCount > 0)
  86   2          {
  87   3            SBUF0 = uart0_TxBuf[uart0_TxTail];
  88   3          }
  89   2          else
  90   2            uart0_TxFlag = 0;
  91   2      
  92   2          TI0 = 0;
  93   2        } /* End of if(TI0) */
  94   1      }
