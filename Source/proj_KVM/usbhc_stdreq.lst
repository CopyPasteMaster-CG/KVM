 111          /**
 112          * @brief  USBHC_Stdreq_GetDevDesc
 113          *         Issue Get Device Descriptor command to the device. Once the response 
 114          *         received, it parses the device descriptor and updates the status.
 115          * @param  pdev: Selected device
 116          * @param  dev_desc: Device Descriptor buffer address
 117          * @param  pdev->host.Rx_Buffer: Receive Buffer address
 118          * @param  length: Length of the descriptor
 119          * @retval Status
 120          */
 121          USBH_Status USBHC_Stdreq_GetDevDesc(U8_T devinx,U8_T td_id,U16_T length)
 122          {
 123   1        //1.Host Channel Paramter
 124   1        HCTD_Channel_Table[td_id].TD_Length = USBHC_SETUP_PKT_SIZE; //receive the length this time
 125   1        HCTD_Channel_Table[td_id].Current_Length = 0; // no data stage
 126   1        HCTD_Channel_Table[td_id].Total_Length = length; // data stage yes
 127   1        
 128   1        return USBHC_GetDescriptor(devinx,td_id,
 129   1        USB_REQ_RECIPIENT_DEVICE | USB_REQ_TYPE_STANDARD,USB_DESC_DEVICE,0,length);
 130   1      }
