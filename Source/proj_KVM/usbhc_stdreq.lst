  11          /*================================================================================
  12           * Module Name : usbhc_stdreq.c
  13           * Purpose     : The handler of HC interface standard request 
  14           * Author      : Jack Wang
  15           * Date        :
  16           * Notes       :
  17           *               Standard Request(bRequest)
  18           *               [ ].Get Status(0x00)
  19           *               [ ].Clear Feature(0x01)
  20           *               [ ].Set Feature(0x03)
  21           *               [v].Set Address(0x05)               wValueH
  22           *               [v].Get Descriptor(0x06)----------> [v].Device(0x01)
  23           *               [ ].Set Descriptor(0x07)            [v].Config(0x02)
  24           *               [ ].Get Config(0x08)                [v].String(0x03)
  25           *               [v].Set Config(0x09)                [v].HID(0x021)  
  26           *               [ ].Get Interface(0x0A)             [v].Report(0x22)
  27           *               [ ].Set Interface(0x0B)             [ ].Physical(0x23)
  28           *               [ ].Sync Frame
  29           *               [ ].Stall
  30           * no message
  31           *
  32           *================================================================================
  33           */
