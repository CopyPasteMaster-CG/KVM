  46          /**
  47          * @brief  USBH_SetAddress
  48          *         This command sets the address to the connected device
  49          * @param  pdev: Selected device
  50          * @param  DeviceAddress: Device address to assign
  51          * @retval Status
  52          */
  53          USBH_Status USBHC_Stdreq_SetAddress(U8_T devinx,U8_T td_id,U8_T DeviceAddress)
  54          {
  55   1        //1.Fill up Host Channel Table
  56   1        HCTD_Channel_Table[td_id].TD_Length = USBHC_SETUP_PKT_SIZE;
  57   1        HCTD_Channel_Table[td_id].Total_Length = 0; // no data stage
  58   1        HCTD_Channel_Table[td_id].Current_Length = 0;
  59   1        HCTD_Channel_Table[td_id].Endp_Size = USBHC_MAX_PACKET_SIZE;
  60   1        
  61   1        //2.Fill up Device Table Control Transfer relative field
  62   1        USB_PDevice[devinx].Hc.Control.EpN_MaxSize = USBHC_SETUP_PKT_SIZE;
  63   1        USB_PDevice[devinx].Hc.Control.Setup.b.bmRequestType = USB_H2D | USB_REQ_RECIPIENT_DEVICE | USB_REQ_TYPE_
             -STANDARD;
  64   1        USB_PDevice[devinx].Hc.Control.Setup.b.bRequest = USB_REQ_SET_ADDRESS;
  65   1        USB_PDevice[devinx].Hc.Control.Setup.b.wValue.w = Big_Endian_16_Convert(DeviceAddress);
  66   1        USB_PDevice[devinx].Hc.Control.Setup.b.wIndex.w = 0;
  67   1        USB_PDevice[devinx].Hc.Control.Setup.b.wLength.w = 0;
  68   1        
  69   1        return USBHC_CtlReq(devinx,td_id);
  70   1      }
  71          
  72          /**
  73          * @brief  USBH_GetDescriptor
  74          *         Issues Descriptor command to the device. Once the response received,
  75          *         it parses the descriptor and updates the status.
  76          * @param  pdev: Selected device
  77          * @param  req_type: Descriptor type
  78          * @param  value_idx: wValue for the GetDescriptr request
  79          * @param  buff: Buffer to store the descriptor
  80          * @param  length: Length of the descriptor
  81          * @retval Status
  82          */
  83          USBH_Status USBHC_GetDescriptor(U8_T devinx,U8_T td_id,U8_T req_type,U16_T value_idx,U16_T interface,U16_T
             - length)
  84          {
  85   1        U16_T index;
  86   1        
  87   1        //2.Setup Token Parameter
  88   1        USB_PDevice[devinx].Hc.Control.Setup.b.bmRequestType = USB_D2H | req_type;
  89   1        USB_PDevice[devinx].Hc.Control.Setup.b.bRequest = USB_REQ_GET_DESCRIPTOR;
  90   1        USB_PDevice[devinx].Hc.Control.Setup.b.wValue.bw.lsb = value_idx & 0x00ff;
  91   1        USB_PDevice[devinx].Hc.Control.Setup.b.wValue.bw.msb = (value_idx & 0xff00) >> 8;
  92   1        if ((value_idx & 0xff00) == USB_DESC_STRING)
  93   1        {
  94   2          if ((value_idx & 0x00ff) == 0x00)
  95   2            index = 0x00;
  96   2          else
  97   2            index = 0x0409;
  98   2        }
  99   1        else
 100   1        {
 101   2          index = interface;
 102   2        }
C51 COMPILER V9.60.7.0   USBHC_STDREQ                                                      06/23/2026 16:04:46 PAGE 3   

 103   1        USB_PDevice[devinx].Hc.Control.Setup.b.wIndex.bw.lsb = index & 0x00ff;
 104   1        USB_PDevice[devinx].Hc.Control.Setup.b.wIndex.bw.msb = (index & 0xff00) >> 8;
 105   1        USB_PDevice[devinx].Hc.Control.Setup.b.wLength.bw.lsb = length & 0x00ff;
 106   1        USB_PDevice[devinx].Hc.Control.Setup.b.wLength.bw.msb = (length & 0xff00) >> 8;
 107   1      
 108   1        return USBHC_CtlReq(devinx,td_id);
 109   1      }
