 107          void USBDC_Write_Regs(U8_T port,U8_T dccir,U8_T *dcdr,U8_T len)
 108          {
 109   1        U8_T index;
 110   1        U8_T int3_bk;
 111   1        
 112   1        int3_bk = EINT3;
 113   1      #if (SYSTEM_MSC_DEVICE_SUPPORT)
                EXTINT5_DISABLE;
              #endif
 116   1        
 117   1        USBDC_INT_DISABLE;
 118   1        
 119   1      #if (SYSTEM_USBAUDIO_DEVICE_SUPPORT)
                EXTINT2_DISABLE;
              #endif
 122   1        switch (port)
 123   1        {
 124   2          case 0:
 125   2            for (index=0; index < len ;index++)
 126   2              _USBDC_DC0DR_SFR(dcdr[index]);
 127   2            
 128   2            _USBDC_DC0CIR_SFR(dccir);
 129   2            break;
 130   2          case 1:
 131   2            for (index=0; index < len ;index++)
 132   2              _USBDC_DC1DR_SFR(dcdr[index]);
 133   2      
 134   2            _USBDC_DC1CIR_SFR(dccir);
 135   2            break;
 136   2          case 2:
 137   2            for (index=0; index < len ;index++)
 138   2              _USBDC_DC2DR_SFR(dcdr[index]);
 139   2      
 140   2            _USBDC_DC2CIR_SFR(dccir);
 141   2            break;
 142   2          case 3:
 143   2            for (index=0; index < len ;index++)
 144   2              _USBDC_DC3DR_SFR(dcdr[index]);
 145   2      
 146   2            _USBDC_DC3CIR_SFR(dccir);
 147   2            break;
 148   2        }
 149   1        
 150   1        /*Enable the HC interrupt */
 151   1      #if (SYSTEM_USBAUDIO_DEVICE_SUPPORT)
                EXTINT2_ENABLE;
              #endif
 154   1        
 155   1        EINT3 = int3_bk;
 156   1        
 157   1      #if (SYSTEM_MSC_DEVICE_SUPPORT)
                EXTINT5_ENABLE;
              #endif
 160   1      }
