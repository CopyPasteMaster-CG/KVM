 226          void USBDC_REGS_Address_Write(U8_T port,U8_T devinx,U8_T address)
 227          {
 228   1        U8_T reg;
C51 COMPILER V9.60.7.0   USBDC_REGS                                                        06/18/2026 10:50:18 PAGE 5   

 229   1        U8_T cir;
 230   1        
