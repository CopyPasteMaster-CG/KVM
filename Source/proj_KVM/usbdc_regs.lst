 362          /* ----------------------------------------------------------------------------
 363           * ----------------------------------------------------------------------------
 364           * void USBDC_REGS_Endp_ControlSet(U8_T port,U8_T devinx,U8_T endpinx,U8_T flag)
 365           * Purpose : When Endp has get a Out transaction, then get the buffer content
 366           * Params  : none
 367           * Returns : none
 368           * Note    : none
 369           * ----------------------------------------------------------------------------
 370           * ----------------------------------------------------------------------------
 371           */
 372          void USBDC_REGS_Endp_ControlSet(U8_T port,U8_T devinx,U8_T endpinx,U8_T flag)
 373          {
 374   1        U8_T reg;
 375   1        U8_T stall_flag = 0x00;
 376   1      
 377   1        //1.Get Control Register content_0x90
 378   1        if (endpinx)
 379   1        {
 380   2          USBDC_Read_Regs(port,DA_EP_SR[devinx][endpinx],&reg,1);
 381   2          if (reg & DA_EP_STALL) // if the endp is stalled
 382   2          {
 383   3            stall_flag = DA_CR_STALL_SET;
 384   3          }
 385   2        }
 386   1        
 387   1        //2.Update the content
 388   1        reg = (flag | (endpinx &0x07) | stall_flag);
 389   1        //3.Write back the register
 390   1        USBDC_Write_Regs(port,DA_CR[devinx],&reg,1);
 391   1      } 
