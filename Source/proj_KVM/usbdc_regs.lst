 321          /* ----------------------------------------------------------------------------
 322           * ----------------------------------------------------------------------------
 323           * void USBDC_REGS_Endp_ControlClear(U8_T port,U8_T devinx,U8_T endpinx,U8_T flag)
 324           * Purpose : When Endp has get a Out transaction, then get the buffer content
 325           * Params  : none
 326           * Returns : none
 327           * Note    : none
 328           * ----------------------------------------------------------------------------
 329           * ----------------------------------------------------------------------------
 330           */
 331          void USBDC_REGS_Endp_ControlClear(U8_T port,U8_T devinx,U8_T endpinx,U8_T flag)
 332          {
 333   1        idata U8_T reg;
 334   1        idata U8_T stall_flag = 0x00;
 335   1        
 336   1        //1.Get Endpoint Stall Status (0xa0)
 337   1        if (endpinx)
 338   1        {
 339   2          USBDC_Read_Regs(port,DA_EP_SR[devinx][endpinx],&reg,1);
 340   2          if (reg & DA_EP_STALL) // if the endp is stalled
 341   2          {
 342   3            stall_flag = DA_CR_STALL_SET;
 343   3          }
 344   2        }
 345   1        
 346   1        //2.Update the content
 347   1        reg = endpinx | stall_flag;
 348   1        
 349   1        if (flag & DA_CR_STALL_SET)
 350   1          reg &= ~DA_CR_STALL_SET;
 351   1      
 352   1        if (flag & DA_CR_SCLR_MASK)
C51 COMPILER V9.60.7.0   USBDC_REGS                                                        06/18/2026 10:50:18 PAGE 7   

 353   1          reg |= DA_CR_SCLR_MASK;
 354   1        
 355   1        if (flag & DA_CR_BCLR_MASK)
 356   1          reg |= DA_CR_BCLR_MASK;
 357   1        
 358   1        //3.Write back the register
 359   1        USBDC_Write_Regs(port,DA_CR[devinx],&reg,1);
 360   1      } 
