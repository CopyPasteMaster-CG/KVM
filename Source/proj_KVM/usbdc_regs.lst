 240          /*******************************************************************************
 241          * Function Name  : USBDC_REGS_Address_Active(U8_T port,U8_T devinx,U8_T address)
 242          * Description    : Assing the device Address
 243          * Input          : None.
 244          * Output         : None.
 245          * Return         : None.
 246          *******************************************************************************/
 247          void USBDC_REGS_Address_Active(U8_T port,U8_T devinx,FlagStatus state)
 248          {
 249   1        U8_T reg;
 250   1        U8_T cir;
 251   1        
 252   1        cir = DA_ID_CFGR[devinx]; 
 253   1        USBDC_Read_Regs(port,cir,&reg,1);
 254   1        
 255   1        if (state == RESET)
 256   1          reg &= ~DA_ID_CFGR_ADRACT_MASK;
 257   1        else
 258   1          reg |= DA_ID_CFGR_ADRACT_MASK;
 259   1        
 260   1        USBDC_Write_Regs(port,cir,&reg,1);
 261   1      #if ((SYSTEM_MSC_DEVICE_SUPPORT || SYSTEM_EXTENDER_MSC_SUPPORT) && (SYSTEM_USB_HC_BURST))
              #if (SYSTEM_EXTENDER_TRANSMITTER)
                if ((state == SET) && (devinx == EXTENDER_MSC_Devinx))
              #else
                if ((state == SET) && (devinx == USBHC_MSC_Devinx))
              #endif //#if (SYSTEM_EXTENDER_TRANSMITTER)
                {
                  cir = DA_CR[devinx];
                  reg = DA_CR_BCLR_SET + USB_PDevice[devinx].MSC->Out_Endpinx;
                  USBDC_Write_Regs(port,cir,&reg,1);
                }
              #endif
 273   1      }
