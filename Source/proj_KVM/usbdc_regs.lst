  71          *******************************************************************************/
  72          U8_T USBDC_REGS_Get_Pkt_Size(U8_T ep_iso,U16_T epsize)
  73          {
  74   1        if (ep_iso == DA_EP_CFGR_ISOCH_SET)
  75   1        {
  76   2          if (epsize <= 16)
  77   2            return ISO_ENDP_PKT_SIZE_16;
  78   2          else if(epsize <=64)  
  79   2            return ISO_ENDP_PKT_SIZE_64;
  80   2          else if(epsize <=128)
  81   2            return ISO_ENDP_PKT_SIZE_128;
  82   2          else if(epsize <=192)
  83   2            return ISO_ENDP_PKT_SIZE_192;
  84   2        }
  85   1        else
  86   1        {
  87   2          if (epsize <= 8)
  88   2            return ENDP_PKT_SIZE_8;
  89   2          else if(epsize <=16)  
  90   2            return ENDP_PKT_SIZE_16;
  91   2          else if(epsize <=32)  
  92   2            return ENDP_PKT_SIZE_32;
  93   2          else if(epsize <=64)  
  94   2          return ENDP_PKT_SIZE_64;
  95   2        }
  96   1      
  97   1        return ENDP_PKT_SIZE_8;
  98   1      }
