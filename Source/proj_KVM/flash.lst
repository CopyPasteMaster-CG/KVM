 158          /*
 159           *--------------------------------------------------------------------------------
 160           * BOOL FLASH_InfoWordRead8Byte(U32_T addr, U8_T *pData)
 161           * Purpose : Flash interrupt server routine for programming and erasing.
 162           * Params  :
 163           * Returns :
 164           * Note    :
 165           *--------------------------------------------------------------------------------
 166           */
C51 COMPILER V9.60.7.0   FLASH                                                             06/23/2026 16:04:43 PAGE 4   

 167          BOOL FLASH_InfoWordRead8Byte(U32_T addr, U8_T *pData)
 168          {
 169   1        U16_T i, addrRealFlash;
 170   1        U8_T  reg8b;
 171   1      
 172   1        /* Check the Flash address must be a word mode address (1 word = 8 bytes) */
 173   1        if (addr & 0x07)
 174   1        {
 175   2          return FALSE;
 176   2        }
 177   1        
 178   1        /* Convert the byte mode address to the word mode address.
 179   1        /* A word address 0x0000 indicates a byte address 0x0000~0x0007, 0x0001 for 0x0008~0x000F. */
 180   1        addrRealFlash = (U16_T)(addr / FLASH_WORD_LEN);
 181   1        FLASH_RegWrite(FLH_FAR, (U8_T *)&addrRealFlash, 2);
 182   1        
 183   1        /* Trigger the GO bit to read Flash */
 184   1        reg8b = (FCCR1_FC_GO | FCCR1_FCMD_WORD_READ | FCCR1_INFO_PAGE);
 185   1        FLASH_RegWrite(FLH_FCCR1, &reg8b, 1);
 186   1        
 187   1        /* Check the Flash status */
 188   1        if (FLASH_CheckCmdComplete() == FALSE)
 189   1        {
 190   2          return FALSE;
 191   2        }
 192   1      
 193   1        /* Fill a page data 256 bytes into the Flash HW buffer */
 194   1        flash_isr = EA;
 195   1        EA = 0;
 196   1        for (i = 0 ; i < FLASH_WORD_LEN ; i ++)
 197   1        {
 198   2          *(pData + i) = FCDP;
 199   2        }
 200   1        EA = flash_isr;
 201   1        return TRUE;
 202   1      }
