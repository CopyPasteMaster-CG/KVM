 104           * Params  : 
C51 COMPILER V9.60.7.0   FLASH                                                             06/23/2026 16:04:43 PAGE 3   

 105           * Returns : TRUE (1) is success ; FALSE (0) is failure with error.
 106           * Note    :
 107           *--------------------------------------------------------------------------------
 108           */
 109          BOOL FLASH_CheckCmdComplete(void)
 110          {
 111   1        U8_T  reg8b;
 112   1      
 113   1        /* Check the Flash status */
 114   1        while (1)
 115   1        {
 116   2          FLASH_RegRead(FLH_FCSR, &reg8b, 1);
 117   2          if (reg8b & FCSR_FC_CS)
 118   2            break;
 119   2        }
 120   1        if (reg8b & FCSR_ERROR_OCCURRED)
 121   1          return FALSE;
 122   1        
 123   1        return TRUE;
 124   1      }
