  53          /*
  54           *--------------------------------------------------------------------------------
  55           * void FLASH_RegWrite(U8_T addr, U8_T *ptData, U8_T dataLen)
  56           * Purpose: Write data bytes into a register with interrupt locked.
  57           * Params : addr: an index address to Flash register.
  58           *          ptData: a pointer to indicate the register data.
  59           *          dataLen:A number of bytes to indicate how many bytes will be written.
  60           * Returns: TRUE (1) is success ; FALSE (0) is failure.
  61           * Note   : None.
  62           *--------------------------------------------------------------------------------
  63           */
  64          void FLASH_RegWrite(U8_T addr, U8_T *ptData, U8_T dataLen)
  65          {
  66   1        flash_isr = EA;
  67   1        EA = 0;
  68   1        while (dataLen --)
  69   1        {
  70   2          FDR = *(ptData + dataLen);
  71   2        }
  72   1        FCIR = addr;
  73   1        EA = flash_isr;
  74   1      }
  75          
  76          /*
  77           *--------------------------------------------------------------------------------
  78           * void FLASH_RegRead(U8_T addr, U8_T *ptData, U8_T dataLen)
  79           * Purpose: Read data bytes from a register with interrupt locked.
  80           * Params : addr: an index address to Flash register.
  81           *          ptData: a pointer to indicate the register data.
  82           *          dataLen:A number of bytes to indicate how many bytes will be read.
  83           * Returns: TRUE (1) is success ; FALSE (0) is failure.
  84           * Note   : None.
  85           *--------------------------------------------------------------------------------
  86           */
  87          void FLASH_RegRead(U8_T addr, U8_T *ptData, U8_T dataLen)
  88          {
  89   1        flash_isr = EA;
  90   1        EA = 0;
  91   1        FCIR = addr;
  92   1        while (dataLen --)
  93   1        {
  94   2          *(ptData + dataLen) = FDR;
  95   2        }
  96   1      
  97   1        EA = flash_isr;
  98   1      }
