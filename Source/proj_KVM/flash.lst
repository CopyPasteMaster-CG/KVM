 126          /*
 127           *--------------------------------------------------------------------------------
 128           * BOOL FLASH_SectorErase(void)
 129           * Purpose : Erase the flash for a sector.
 130           * Params  : sectAddr: flash address that is a multiple of 0x2000 (8K).
 131           *           sectSize: total sectors to be erased.
 132           * Returns : TRUE (1) is success ; FALSE (0) is failure with error.
 133           * Note    :
 134           *--------------------------------------------------------------------------------
 135           */
 136          BOOL FLASH_SectorErase(void)
 137          {
 138   1        U16_T addrRealFlash;
 139   1        U8_T  reg8b;
 140   1      
 141   1        /* Convert the byte mode address to the word mode address.
 142   1        /* A word address 0x0000 indicates a byte address 0x0000~0x0007, 0x0001 for 0x0008~0x000F. */
 143   1        addrRealFlash = (STORAGE_START_ADDRESS / FLASH_WORD_LEN);
 144   1        FLASH_RegWrite(FLH_FAR, (U8_T *)&addrRealFlash, 2);
 145   1        
 146   1        /* Trigger the GO bit to erase Flash sector */
 147   1        reg8b = (FCCR1_FC_GO | FCCR1_FCMD_SECTOR_ERASE);
 148   1        FLASH_RegWrite(FLH_FCCR1, &reg8b, 1);
 149   1        /* Check the Flash status */
 150   1        if (FLASH_CheckCmdComplete() == FALSE)
 151   1        {
 152   2          return FALSE;
 153   2        }
 154   1      
 155   1        return TRUE;
 156   1      }
