                buf[5] = 0;
                buf[6] = 0;
                buf[7] = 0;
                REMOTE_PutStr(buf,sizeof(Kmlog_Data_Packet_Def));
              }
              
              /**----------------------------------------------------------------------------
               * void KMLog_Send_Keyboard(U8_T *buf,U8_T len)
