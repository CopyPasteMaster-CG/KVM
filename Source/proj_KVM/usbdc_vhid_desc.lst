C51 COMPILER V9.60.7.0   USBDC_VHID_DESC                                                   06/23/2026 16:04:45 PAGE 9   

 477            /*
 478            //Top level collection for use in Single-Touch Digitizer device mode.
 479            //-------------------------------------------------------------------
 480            //Format for single-touch digitizer input reports using this report descriptor:
 481            //byte[0] = Report ID = SINGLE_TOUCH_DATA_REPORT_ID
 482            //byte[1] = contains bit fields for various input information typically generated by an input pen or huma
             -n finger. '1' is the active value (ex: pressed), '0' is the non active value
 483            //    bit0 = Tip switch. At the end of a pen input device would normally be a pressure senstive switch.  As
             -serting this performs an operation analogous to a "left click" on a mouse
 484            //    bit2 = In range indicator.  
 485            //    bit3 though bit 7 = Pad bits.  Values not used for anything.
 486            //byte[2] = Pad byte.  Value not used for anything.
 487            //byte[3] = X coordinate LSB value of contact point
 488            //byte[4] = X coordinate MSB value of contact point
 489            //byte[5] = Y coordinate LSB value of contact point
 490            //byte[6] = Y coordinate MSB value of contact point
 491              0x05, 0x0D,             // USAGE_PAGE (Digitizers)          
 492              0x09, 0x02,             // USAGE (Pen)                      
 493              0xA1, 0x01,             // COLLECTION (Application)         
 494              0x85, SINGLE_TOUCH_DATA_REPORT_ID,  //   REPORT_ID (Pen digitizer/single touch)  //To send a HID input
             - report containing single-touch digitizer data, use the SINGLE_TOUCH_DATA_REPORT_ID report ID
 495              0x09, 0x20,             //   USAGE (Stylus)                 
 496              0xA1, 0x00,             //   COLLECTION (Physical)          
 497              0x09, 0x42,       //     USAGE (Tip Switch)           //(byte[1] bit 0)
 498              0x09, 0x32,       //     USAGE (In Range)             //(byte[1] bit 1)
 499              0x15, 0x00,             //     LOGICAL_MINIMUM (0)          
 500              0x25, 0x01,             //     LOGICAL_MAXIMUM (1)          
 501              0x75, 0x01,             //     REPORT_SIZE (1)              //1-bit   
 502              0x95, 0x02,             //     REPORT_COUNT (2)             //two
 503              0x81, 0x02,       //     INPUT (Data,Var,Abs)         //Makes two, 1-bit IN packet fields (byte[1] bits 0
             --4)) for (USAGE) tip sw, barrel sw, invert sw, in range sw.  Send '1' here when switch is active.  Send '0' when switch 
             -not active.
 504              0x95, 0x0E,       //     REPORT_COUNT (14)            //fourteen
 505              0x81, 0x03,       //     INPUT (Cnst,Var,Abs)         //Makes fourteen, 1-bit IN packet fields (byte[1] b
             -its 5-7, and byte[2] all bits) with no usage.  These are pad bits that don't contain useful data.
 506              0x05, 0x01,             //     USAGE_PAGE (Generic Desktop)
 507              0x26, 0xC0, 0x12,     //       LOGICAL_MAXIMUM (4800)         
 508              0x75, 0x10,           //       REPORT_SIZE (16)             
 509              0x95, 0x01,             //     REPORT_COUNT (1)         //one
 510              0x55, 0x0E,           //       UNIT_EXPONENT (-2)       //10^(-2)           
 511              0x65, 0x33,           //       UNIT (Inches, English Linear)  //But exponent -2, so Physical Maximum i
             -s in 10’s of mils.                 
 512              0x09, 0x30,           //       USAGE (X)                    
 513              0x35, 0x00,           //       PHYSICAL_MINIMUM (0)         
 514              0x46, 0x40, 0x06,     //       PHYSICAL_MAXIMUM (0x640 = 1600)     //1600 * 10^(-2) = 16 inches X-dime
             -nsion        
 515              0x81, 0x02,           //       INPUT (Data,Var,Abs)           //Makes one, 16-bit field for X coordina
             -te info.  Valid values from: 0-4800    
 516              0x26, 0xB8, 0x0B,     //       LOGICAL_MAXIMUM (3000)             //16:10 aspect ratio (X:Y) 
 517              0x46, 0xE8, 0x03,     //       PHYSICAL_MAXIMUM (0x3E8 = 1000)    //1000 * 10^(-2) = 10 inches Y-dimen
             -sion       
 518              0x09, 0x31,           //       USAGE (Y)       
 519              0x81, 0x02,             //     INPUT (Data,Var,Abs)       //Makes one, 16-bit field for Y coordinate in
             -fo.  Valid values from: 0-3000   
 520              0xC0,                   //   END_COLLECTION (Physical)                
 521              0xC0                    // END_COLLECTION (Application) 
 522            */
 523          }; /* VHID_ReportDescriptor */
