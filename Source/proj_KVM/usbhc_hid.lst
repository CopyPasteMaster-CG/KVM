 367          /*----------------------------------------------------------------------------
 368           * CTRL_State usbhc_Class_GetRptDesc(U8_T devinx,U8_T td_id)
 369           * Purpose : Perform the set address operation of enumearation
 370           * Params  : none
 371           * Returns : none
 372           * Note    : none
 373           * ----------------------------------------------------------------------------*/
 374          RESULT usbhc_Class_GetRptDesc(U8_T devinx,U8_T td_id,U8_T inf_id)
 375          {
 376   1        RESULT  Result=USB_ERROR;
 377   1        U16_T rpt_len;
 378   1      
 379   1        if (USB_PDevice[devinx].Hc.Control.State == CTRL_IDLE)
 380   1        {
 381   2          //1.Get dynamic buffer memory
 382   2          rpt_len = USB_PDevice[devinx].HID_Rpt_Len[inf_id];
 383   2          if (rpt_len)
 384   2          {
 385   3            USB_PDevice[devinx].Hc.Control.Buf = m_malloc(rpt_len,16); /* allocate 18 bytes */
 386   3            HCTD_Channel_Table[td_id].Buf = USB_PDevice[devinx].Hc.Control.Buf; // also assign to host channel buff
             -er
 387   3            if (USB_PDevice[devinx].Hc.Control.Buf != NULL)
 388   3            {
 389   4              //2.Set maximum package size
 390   4              USBHC_Classreq_GetRptDesc(devinx,td_id,inf_id,rpt_len);
 391   4              Result=USB_BUSY;
 392   4            }
 393   3            else
 394   3            {
