 203          /**
 204          * @brief  USBH_Get_HID_ReportDescriptor
 205          *         Issue report Descriptor command to the device. Once the response 
 206          *         received, parse the report descriptor and update the status.
 207          * @param  pdev   : Selected device
 208          * @param  Length : HID Report Descriptor Length
 209          * @retval USBH_Status : Response for USB HID Get Report Descriptor Request
 210          */
 211          USBH_Status USBHC_Classreq_GetRptDesc (U8_T devinx,U8_T td_id,U8_T interface,U16_T length)
 212          {
 213   1        //1.TD Parameter
 214   1        HCTD_Channel_Table[td_id].TD_Length = USBHC_SETUP_PKT_SIZE;
 215   1        HCTD_Channel_Table[td_id].Total_Length = length; // no data stage
 216   1        HCTD_Channel_Table[td_id].Current_Length = 0;
 217   1        //2.Descriptor Read
 218   1        return USBHC_GetDescriptor(devinx,
 219   1                       td_id,
 220   1                       USB_REQ_RECIPIENT_INTERFACE | USB_REQ_TYPE_STANDARD,
 221   1                       USB_DESC_HID_REPORT,
 222   1                       interface,
 223   1                       length);
 224   1      }
