 105            * @retval Status
 106            */
 107          void TASK_USBHC_HID_Class_Enumerate(void)
 108          {
 109   1        idata U8_T  devinx,inf_id,td_id;
 110   1        RESULT    Result=USB_ERROR;
 111   1      
 112   1        devinx = TASK_Register0;
 113   1        inf_id = TASK_Event;
 114   1        td_id = USB_PDevice[devinx].Hc.Control.TdNum;
 115   1        TASK_Destory_Current();
 116   1      
 117   1        //Skip task if the device is gone
 118   1        if ((USB_PDevice[devinx].Addr & USBHC_DEVICE_USED_MASK) == 0x00)  // Device is gone  
 119   1        {
 120   2          return;
 121   2        }
 122   1        
 123   1      TASK_USBHC_HID_Enumerate_Handle_Restart:
 124   1        switch (USB_PDevice[devinx].Hc.HID_EnumState)
 125   1        {
 126   2          case HID_ENUM_SET_IDLE: //Start to Get device description
 127   2            Result = usbhc_Class_SetIdle(devinx,td_id,inf_id,0);
 128   2            break;
 129   2          case HID_ENUM_GET_RPT_DESC:
 130   2            Result = usbhc_Class_GetRptDesc(devinx,td_id,inf_id);
 131   2            break;
 132   2      //#ifdef HIKDVR   
 133   2      //    case HID_ENUM_SET_PROTOCOL: //Start to Get device description
 134   2      //      Result = usbhc_Class_SetProtocol(devinx,td_id,inf_id,0);
 135   2      //      break;
 136   2      //#endif    
 137   2          default:
 138   2            break;
 139   2        }
 140   1      
 141   1        if ((USB_PDevice[devinx].Hc.Control.State == CTRL_FAIL) ||
 142   1          (USB_PDevice[devinx].Hc.HID_EnumState == HID_ENUM_IDLE) ||
 143   1          (USB_PDevice[devinx].Hc.HID_EnumState == HID_ENUM_FAIL))
 144   1        {
 145   2          USBHC_CORE_Free_TD(td_id);
 146   2          if (USB_PDevice[devinx].Hc.HID_EnumState == HID_ENUM_IDLE)
 147   2          {
 148   3            //HID Report Parser
 149   3            USBHC_HID_Interface_Check(devinx,inf_id);
 150   3      
 151   3            inf_id++;
 152   3            if (inf_id < (USB_PDevice[devinx].InterfaceNum & USBHC_DEVICE_INTERFACENUM_MASK))
 153   3            {
 154   4              USB_PDevice[devinx].Hc.HID_EnumState = HID_ENUM_SET_IDLE;
 155   4              USB_PDevice[devinx].Hc.Control.InfAddr = inf_id;
 156   4              goto TASK_USBHC_HID_Enumerate_Handle_Restart;
 157   4            }
 158   3          }
 159   2      
 160   2          USB_PDevice[devinx].Hc.HID_EnumState = HID_ENUM_IDLE;
 161   2          USB_PDevice[devinx].Hc.Control.Buf = NULL;
 162   2          USB_PDevice[devinx].Hc.Control.State = CTRL_IDLE;
 163   2          USB_PDevice[devinx].Hc.gState = HOST_CLASS_ENUMERATION; // next go other Class Maintain.
 164   2          TASK_Active(TASK_TYPE_USB,TASK_USBHC_Process_ID,0x00,devinx,0,0); // Generate the task
 165   2          return;
 166   2        }
C51 COMPILER V9.60.7.0   USBHC_HID                                                         06/18/2026 10:50:20 PAGE 4   

 167   1      
 168   1        if (Result == USB_SUCCESS)
 169   1        {
 170   2          goto TASK_USBHC_HID_Enumerate_Handle_Restart;
 171   2        }
 172   1        else if (Result == USB_STALLED_WAIT)
 173   1        {
 174   2          TASK_Active(TASK_TYPE_INTERVAL_MS,TASK_USBHC_HID_Class_Enumerate_ID, inf_id, devinx, 2000, 0);  // Gener
             -ate the task
