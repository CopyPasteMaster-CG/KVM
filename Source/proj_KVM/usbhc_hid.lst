 546          /*----------------------------------------------------------------------------
 547           * CTRL_State USBHC_SCM_SetUnifyingReport(U8_T devinx,U8_T td_id,U8_T mode)
 548           * Purpose : Perform the set address operation of enumearation
 549           * Params  : none
 550           * Returns : none
 551           * Note    : none
 552           * ----------------------------------------------------------------------------*/
 553          RESULT USBHC_SCM_SetUnifyingReport(U8_T devinx,U8_T td_id,U8_T mode)
 554          {
 555   1        RESULT  Result=USB_ERROR;
 556   1        U8_T  *buf;
 557   1        
 558   1        if (USB_PDevice[devinx].Hc.Control.State == CTRL_IDLE)
 559   1        {
 560   2          if (mode == UNIFYING_RPT_MODE_DJ)
 561   2          {
 562   3            buf = UNIFYING_Switch_DJ_Command;
 563   3          }
 564   2          else
 565   2          {
 566   3            buf = UNIFYING_Switch_HID_Command;
 567   3          }
 568   2          USBHC_Classreq_SetReport(devinx,td_id,0x02,0x20,0x02,15,buf);
 569   2          Result=USB_BUSY;
 570   2        }
 571   1        else
 572   1        {
 573   2          if ((USB_PDevice[devinx].Hc.Control.State == CTRL_COMPLETE) || (USB_PDevice[devinx].Hc.Control.State == 
             -CTRL_STALLED))
 574   2          {
 575   3            Result=USB_SUCCESS;
 576   3            USB_PDevice[devinx].DevAttr &= ~UNIFYING_CHANGE_MODE_MASK;
 577   3          }
 578   2          USB_PDevice[devinx].Hc.Control.Buf = NULL; // clear the buffer pointer
 579   2        }
 580   1        return Result;
 581   1      }
