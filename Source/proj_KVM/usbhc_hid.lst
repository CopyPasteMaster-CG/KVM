 495          /*----------------------------------------------------------------------------
 496           * CTRL_State USBHC_SCM_SetLedReport(U8_T devinx,U8_T td_id)
 497           * Purpose : Perform the set address operation of enumearation
 498           * Params  : none
 499           * Returns : none
 500           * Note    : none
 501           * ----------------------------------------------------------------------------*/
 502          RESULT USBHC_SCM_SetLedReport(U8_T devinx,U8_T td_id)
 503          {
 504   1        RESULT  Result=USB_ERROR;
 505   1        U8_T  len,start,inf,pageid;
 506   1      #if defined(HID_PARSER_CORE_KB) 
 507   1        ParserCore_Led_TypeDef *parserled;  
 508   1      #endif
 509   1        
 510   1        if (USB_PDevice[devinx].Hc.Control.State == CTRL_IDLE)
 511   1        {
 512   2          //what is the interface id?
 513   2          inf = (USB_PDevice[devinx].HID_Kb_Buf_InfEndp & 0xf0) >>4;
 514   2          inf = (0x01 << inf);
 515   2      #if defined(HID_PARSER_CORE_KB) 
 516   2          parserled = (ParserCore_Led_TypeDef *) USB_PDevice[devinx].HID_LED_Item;  
 517   2          pageid = parserled->Page_ID;
 518   2      #else
                  pageid = USB_PDevice[devinx].HID_Kb_ParserTable->Attr_PageID & HID_RPT_PAGEID_MASK;
              #endif      
 521   2          if ( pageid && ((USB_PDevice[devinx].Current_Protocol & inf) == 0x00)) //must not in boot protocol
 522   2          {
 523   3            start = 0;  
 524   3            len = 2;
 525   3            USB_PDevice[devinx].HID_Kb_LED_Value[0] = pageid;
 526   3          }
 527   2          else
C51 COMPILER V9.60.7.0   USBHC_HID                                                         06/18/2026 10:50:20 PAGE 10  

 528   2          {
 529   3            start = 1;
 530   3            len = 1;
 531   3          }
 532   2          USBHC_Classreq_SetReport(devinx,td_id,0x00,0x00,0x02,len,&USB_PDevice[devinx].HID_Kb_LED_Value[start]);
 533   2          Result=USB_BUSY;
 534   2        }
 535   1        else
 536   1        {
 537   2          if ((USB_PDevice[devinx].Hc.Control.State == CTRL_COMPLETE) || (USB_PDevice[devinx].Hc.Control.State == 
             -CTRL_STALLED))
 538   2          {
 539   3            Result=USB_SUCCESS;
 540   3          }
 541   2          USB_PDevice[devinx].Hc.Control.Buf = NULL; // clear the buffer pointer
 542   2        }
 543   1        return Result;
 544   1      }
