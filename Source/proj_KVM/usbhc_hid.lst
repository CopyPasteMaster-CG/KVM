 583          /*----------------------------------------------------------------------------
 584           * RESULT USBHC_SCM_SetUnifyingHID(U8_T devinx,U8_T td_id,U8_T mode)
 585           * Purpose : Perform the set address operation of enumearation
 586           * Params  : none
 587           * Returns : none
C51 COMPILER V9.60.7.0   USBHC_HID                                                         06/18/2026 10:50:20 PAGE 11  

 588           * Note    : none
 589           * ----------------------------------------------------------------------------*/
 590          RESULT USBHC_SCM_SetUnifyingHID(U8_T devinx,U8_T td_id,U8_T mode)
 591          {
 592   1        RESULT  Result=USB_ERROR;
 593   1        U8_T  *buf;
 594   1        
 595   1        if (USB_PDevice[devinx].Hc.Control.State == CTRL_IDLE)
 596   1        {
 597   2          if (mode == UNIFYING_RPT_MODE_LONG)
 598   2          {
 599   3            buf = UNIFYING_Switch_HIDPP_Command;
 600   3          }
 601   2          else
 602   2          {
 603   3            buf = UNIFYING_Switch_HID0_Command;
 604   3          }
 605   2          buf[3] |= (USBDC_Device[devinx].Unifying_index & 0xf0) >> 4; //software id
 606   2          buf[1] = USBDC_Device[devinx].Unifying_index & 0x0f; //index
 607   2          USBHC_Classreq_SetReport(devinx,td_id,0x02,0x10,0x02,7,buf);
 608   2          Result=USB_BUSY;
 609   2        }
 610   1        else
 611   1        {
 612   2          if ((USB_PDevice[devinx].Hc.Control.State == CTRL_COMPLETE) || (USB_PDevice[devinx].Hc.Control.State == 
             -CTRL_STALLED))
 613   2          {
 614   3            Result=USB_SUCCESS;  
 615   3            USB_PDevice[devinx].DevAttr &= ~UNIFYING_CHANGE_HID_MASK;
 616   3          }
 617   2          USB_PDevice[devinx].Hc.Control.Buf = NULL; // clear the buffer pointer
 618   2        }
 619   1        return Result;
 620   1      }
