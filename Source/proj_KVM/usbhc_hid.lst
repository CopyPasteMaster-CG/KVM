 178          /**
 179          * @brief  USBHC_Classreq_SetIdle
 180          *         Set Idle State. 
 181          * @param  pdev: Selected device
 182          * @param  duration: Duration for HID Idle request
 183          * @param  reportID : Targetted report ID for Set Idle request
 184          * @retval USBH_Status : Response for USB Set Idle request
 185          */
 186          USBH_Status USBHC_Classreq_SetIdle (U8_T devinx,U8_T td_id,U8_T duration,U8_T reportId,U8_T interface)
 187          {
 188   1        //1.TD Header init
 189   1        HCTD_Channel_Table[td_id].TD_Length = USBHC_SETUP_PKT_SIZE;
 190   1        HCTD_Channel_Table[td_id].Total_Length = 0; // no data stage
 191   1        HCTD_Channel_Table[td_id].Current_Length = 0;
 192   1        HCTD_Channel_Table[td_id].Endp_Size = USBHC_MAX_PACKET_SIZE;
 193   1        //2.Setup Command Buffer prepare
 194   1        USB_PDevice[devinx].Hc.Control.Setup.b.bmRequestType = USB_H2D | USB_REQ_RECIPIENT_INTERFACE |USB_REQ_TYP
             -E_CLASS;
 195   1        USB_PDevice[devinx].Hc.Control.Setup.b.bRequest = USB_HID_SET_IDLE;
 196   1        USB_PDevice[devinx].Hc.Control.Setup.b.wValue.w = Big_Endian_16_Convert((duration << 8 ) | reportId);
 197   1        USB_PDevice[devinx].Hc.Control.Setup.b.wIndex.w = Big_Endian_16_Convert(interface);
 198   1        USB_PDevice[devinx].Hc.Control.Setup.b.wLength.w = 0;
 199   1      
 200   1        return USBHC_CtlReq(devinx,td_id);
 201   1      }
