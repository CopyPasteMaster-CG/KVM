 307          /*----------------------------------------------------------------------------
 308           * CTRL_State usbhc_Class_SetIdle(U8_T devinx,U8_T td_id,U8_T duration))
 309           * Purpose : Perform the set address operation of enumearation
 310           * Params  : none
 311           * Returns : none
 312           * Note    : none
 313           * ----------------------------------------------------------------------------*/
 314          static RESULT usbhc_Class_SetIdle(U8_T devinx,U8_T td_id,U8_T inf_id,U8_T duration)
 315          {
 316   1        RESULT  Result=USB_ERROR;
 317   1        
 318   1        if (USB_PDevice[devinx].Hc.Control.State == CTRL_IDLE)
 319   1        { 
 320   2          if (USB_PDevice[devinx].InfClass[inf_id] == USB_HID_CLASS)  //if has hid report, need to set idle command
             - support
 321   2          {
 322   3            if (USBHC_Control_TD_Init(devinx,&td_id) == USBH_OK)
 323   3            {
 324   4              USBHC_Classreq_SetIdle(devinx,td_id,duration,0,inf_id);
 325   4              Result=USB_BUSY;
 326   4            }
 327   3            else
 328   3            {
 329   4              USB_PDevice[devinx].Hc.HID_EnumState = HID_ENUM_FAIL;
 330   4            }
 331   3          }
 332   2          else
 333   2          {
 334   3            USB_PDevice[devinx].Hc.HID_EnumState = HID_ENUM_IDLE;
 335   3            Result=USB_SUCCESS;
 336   3          }
 337   2        }
 338   1        else
 339   1        {
 340   2          if ((USB_PDevice[devinx].Hc.Control.State == CTRL_COMPLETE) || (USB_PDevice[devinx].Hc.Control.State == 
             -CTRL_STALLED))
 341   2          {
 342   3            if (USB_PDevice[devinx].Hc.Control.State == CTRL_STALLED)
 343   3            {
 344   4              Result=USB_STALLED_WAIT;
C51 COMPILER V9.60.7.0   USBHC_HID                                                         06/18/2026 10:50:20 PAGE 7   

 345   4            }
 346   3            else
 347   3            {
 348   4              if (USB_PDevice[devinx].Hc.Control.State == CTRL_COMPLETE)
 349   4              {
 350   5                USB_PDevice[devinx].Hid_SetIdle_Allow |= (0x01 << inf_id);
 351   5              }
 352   4      
 353   4              Result=USB_SUCCESS;
 354   4            }
 355   3      
 356   3            USB_PDevice[devinx].Hc.HID_EnumState = HID_ENUM_GET_RPT_DESC;
 357   3            USB_PDevice[devinx].Hc.Control.State = CTRL_IDLE;
 358   3          }
 359   2          else
 360   2          {
 361   3            USB_PDevice[devinx].Hc.HID_EnumState = HID_ENUM_FAIL;
 362   3          }
 363   2        }
 364   1        return Result;
 365   1      }
