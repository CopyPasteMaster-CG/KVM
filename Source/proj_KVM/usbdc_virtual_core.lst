1023          RESULT USBDC_Standard_SetInterface(U8_T devinx,U8_T port)
1024          {
1025   1        /*Test if the specified Interface and Alternate Setting are supported by
1026   1        the application Firmware*/
1027   1        if (devinx==0) // check hub first
1028   1        {
1029   2          if ((wIndex_L > 0) || (wValue_L > 0))
1030   2            return USB_UNSUPPORT;
1031   2        }
1032   1      
1033   1        if (wValue_L != USBDC_Device[devinx].Current_AlternateSetting[port][wIndex_L])
1034   1        {
