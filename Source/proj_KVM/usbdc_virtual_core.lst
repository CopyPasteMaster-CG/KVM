 395   2          USBDC_Device[devinx].ControlState[port] = SETUP_COMPLETE;
 396   2      #if (SYSTEM_EXTENDER_TRANSMITTER)
                  if (USB_PDevice[devinx].DevAttr & DEVATTR_REMOTE_DEV_MASK)  //if not extender, then
