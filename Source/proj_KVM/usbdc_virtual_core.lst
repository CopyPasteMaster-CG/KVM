1278          RESULT USBDC_Standard_GetStatus(U8_T devinx,U8_T port)
1279          {
1280   1        U8_T Related_Endpoint;
1281   1        
1282   1        if ((USBDC_Device[devinx].Setup[port].b.wValue.w == 0) &&
1283   1          (USBDC_Device[devinx].Setup[port].b.wLength.w == 0x0002)&& 
