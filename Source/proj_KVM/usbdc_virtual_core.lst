1036   2          
1037   2          if (USB_PDevice[devinx].DevClass == USB_AUDIO_CLASS)
1038   2          {
1039   3            if (port == KVM_CurrentUSBAudio)
1040   3            {
1041   4              USB_PDevice[devinx].Current_AlternateSetting[wIndex_L] = wValue_L;
1042   4              USBHC_Set_Dev_Interface(devinx,wIndex_L,wValue_L); // interface,alternate setting       
1043   4      #if (SYSTEM_USBAUDIO_DEVICE_SUPPORT)
              #if (SYSTEM_EXTENDER_RECEIVER)  || (SYSTEM_KVM)             
                      if ((wIndex_L == HC_IsoTransfer_Table[USB_HC_ISTL_OUT_MAX].InterfaceIdx) &&
                        (wValue_L == 0x01) &&
                        (HC_IsoTransfer_Table[USB_HC_ISTL_OUT_MAX].Used_DeviceID & USBHC_DEVICE_USED_MASK))
                      {
                        EXTINT3_DISABLE;
                        USBHC_AUDIO_In_Start();
                        EXTINT3_ENABLE;
                      }
              #endif  /*  #if (SYSTEM_EXTENDER_RECEIVER) */                 
              #endif  /*  #if (SYSTEM_USBAUDIO_DEVICE_SUPPORT) */   
1055   4            }
1056   3          }
1057   2          else if (port == KVM_CurrentHost) 
1058   2          {
1059   3            USB_PDevice[devinx].Current_AlternateSetting[wIndex_L] = wValue_L;
1060   3            USBHC_Set_Dev_Interface(devinx,wIndex_L,wValue_L); // interface,alternate setting
1061   3          }
1062   2        }
1063   1      
1064   1        return USB_SUCCESS;
1065   1      }
