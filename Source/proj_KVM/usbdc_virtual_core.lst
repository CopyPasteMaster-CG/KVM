 921          /*******************************************************************************
 922          * Function Name  : USBDC_Standard_Feature_Control.
 923          * Description    : Set or Clear a specific feature of Device/Interface/endpoint
 924          * Input          : None.
 925          * Output         : None.
 926          * Return         : - Return USB_SUCCESS, if the request is performed.
 927          *                  - Return USB_UNSUPPORT, if the request is invalid.
 928          *******************************************************************************/
 929          RESULT USBDC_Standard_Feature_Control(U8_T devinx,U8_T port,FlagStatus state)
 930          {
 931   1        RESULT  Result = USB_UNSUPPORT;
 932   1        U8_T  endpidx;
 933   1        U8_T  endpaddr;
 934   1      
 935   1        switch (Type_Recipient)
 936   1        {
 937   2          case DEVICE_RECIPIENT: //0-Device, remote wakeup
 938   2            if (state == SET)
 939   2            {
 940   3              USBDC_Device[devinx].Feature[port] |= FEATURE_REMOTE;
 941   3              USBDC_UpPortState[port] |= USBDC_ROOTHUB_REMOTE_WAKEUP;
 942   3            }
 943   2            else
 944   2            {
 945   3              USBDC_Device[devinx].Feature[port] &= ~FEATURE_REMOTE;
 946   3              USBDC_UpPortState[port] &= ~USBDC_ROOTHUB_REMOTE_WAKEUP;
 947   3            }
 948   2            Result = USB_SUCCESS;
 949   2            break;
 950   2          case ENDPOINT_RECIPIENT: //Endpoint, STALLED
 951   2            USBDC_Search_EndpAddr(devinx,USBDC_Device[devinx].Setup[port].b.wIndex.bw.msb,&endpidx);
 952   2            endpaddr = USBDC_Device[devinx].Setup[port].b.wIndex.bw.msb & ~0x80;
 953   2            if (endpaddr <= 0x07)
 954   2            {
 955   3              if (state == SET)
C51 COMPILER V9.60.7.0   USBDC_VIRTUAL_CORE                                                06/18/2026 10:50:18 PAGE 17  

 956   3              {
 957   4                USBDC_VIRTUAL_Endp_Stall_Control(port,devinx,endpidx,state);
 958   4                USBDC_Device[devinx].Endp_Stall[port] |= (0x01 << endpidx);
 959   4              }
 960   3              else
 961   3              {
 962   4                if ((USBDC_Device[devinx].Endp_Stall[port] & (0x01 << endpidx)) == 0)
 963   4                {
 964   5                  return USB_UNSUPPORT;
 965   5                }
 966   4                USBDC_VIRTUAL_Endp_Stall_Control(port,devinx,endpidx,state);
 967   4                USBDC_Device[devinx].Endp_Stall[port] &= ~(0x01 << endpidx);
 968   4      
 969   4      #if (SYSTEM_USB_PEN_DRIVE_SUPPORT)
                        if (devinx == USBDC_VMSC_DEVINX)
                        {
                          USBDC_MSC_Stall_Clear(devinx);
                        }
              #endif
 975   4              }
 976   3            }
 977   2      #if (SYSTEM_EXTENDER_MSC_SUPPORT)
              #if (SYSTEM_EXTENDER_TRANSMITTER)
                    if ((devinx == EXTENDER_MSC_Devinx) && (USB_PDevice[devinx].DevClass == USB_MSC_CLASS))
                    {
                      Result = USB_WAIT;
                      if ((Request_No == CLEAR_FEATURE) && (USBDC_Device[devinx].Setup[port].b.wValue.w == 0x00))
                      {
                        //should create a IN after passthrough complete
                        if (USB_PDevice[devinx].MSC->BOT_State == MSC_BOT_STALL)
                        {
                          USB_PDevice[devinx].MSC->BOT_State = MSC_BOT_CSW_REQUEST;
                        }
                      }
                    }
                    else
              #endif //#if (SYSTEM_EXTENDER_TRANSMITTER)
              #endif //#if (SYSTEM_EXTENDER_MSC_SUPPORT)
 994   2      #if (SYSTEM_MSC_DEVICE_SUPPORT)
                    if ((devinx == USBHC_MSC_Devinx) && (USB_PDevice[devinx].DevClass == USB_MSC_CLASS))
                    {
                      Result = USB_WAIT;
                      if ((Request_No == CLEAR_FEATURE) && (USBDC_Device[devinx].Setup[port].b.wValue.w == 0x00))
                      {
                        //should create a IN after passthrough complete
                        USBHC_MSC_State |= MSC_STATE_CHECK_BULK_IN;
                      }
                    }
                    else
              #endif
1006   2            {
1007   3              Result = USB_SUCCESS;
1008   3            }
1009   2            break; //Endpoint, STALLED
1010   2        }
1011   1        return Result;
1012   1      }
