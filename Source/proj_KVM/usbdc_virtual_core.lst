1294   1        StatusInfo.w = 0;
1295   1      
1296   1        if (Type_Recipient == (STANDARD_REQUEST | DEVICE_RECIPIENT))
1297   1        {
1298   2          /*Get Device Status */
1299   2          /* Remote Wakeup enabled */
1300   2          if (_ValBit(USBDC_Device[devinx].Feature[port],5))
1301   2          {
1302   3            _SetBit(StatusInfo.bw.lsb, 1);
1303   3          }
1304   2      
1305   2          /* Bus-powered */
1306   2          if (_ValBit(USBDC_Device[devinx].Feature[port],6))
1307   2          {
1308   3            /* Self-powered */
1309   3            _SetBit(StatusInfo.bw.lsb, 0);
1310   3          }
1311   2          else /* Bus-powered */
1312   2          {
1313   3            _ClrBit(StatusInfo.bw.lsb, 0);
1314   3          }
1315   2        }
1316   1        /*Interface Status*/
1317   1        else if (Type_Recipient == (STANDARD_REQUEST | INTERFACE_RECIPIENT))
1318   1        {
1319   2        
1320   2        }
1321   1        /*Get EndPoint Status*/
1322   1        else if (Type_Recipient == (STANDARD_REQUEST | ENDPOINT_RECIPIENT))
1323   1        {
1324   2          Related_Endpoint = (wIndex_L & 0x0f);
1325   2          if (_ValBit(wIndex_L, 7)) 
C51 COMPILER V9.60.7.0   USBDC_VIRTUAL_CORE                                                06/18/2026 10:50:18 PAGE 23  

1326   2          {
