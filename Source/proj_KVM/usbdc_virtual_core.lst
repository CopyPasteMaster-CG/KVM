 162          /*
 163           * ----------------------------------------------------------------------------
 164           * Function Name: USBDC_VIRTUAL_Fill_Device_Reg
 165           * Purpose: Use Device Table, fill up DC Register
 166           * Params:  NONE
 167           * Returns: NONE
 168           * Note:
 169           * ----------------------------------------------------------------------------
 170           */
 171          void USBDC_VIRTUAL_Fill_Device_Reg(U8_T devinx,U8_T active_port,U8_T address)
 172          {
 173   1        U8_T pinx;
 174   1        U8_T ep;
 175   1        U8_T enable_bit;
 176   1        U8_T reg0;
 177   1        U8_T ep_dir;
 178   1        U8_T ep_dbuf=0;
 179   1        U8_T ep_iso;
 180   1        U8_T ep_pksize;
 181   1        U8_T prefetch[USBDC_PORT_MAX];
 182   1        U8_T index;
 183   1      
 184   1        for (pinx = 0; pinx < USBDC_PORT_MAX; pinx++)
 185   1        {
 186   2          prefetch[pinx] = 0;
 187   2          
 188   2          if (active_port & MOUNT_PORT[pinx])
 189   2          {
 190   3            for (ep=0; ep < USBDC_Device[devinx].EndpNum; ep++)
 191   3            {
 192   4              if ((ep == 0) || (USBDC_Device[devinx].EndpAddr[ep] & 0x0f))
 193   4              {
 194   5                //Check Double Buffer Flag
 195   5                if (USBDC_Device[devinx].EndpAddr[ep] & USBDC_TABLE_DOUBF_MASK)
 196   5                {
 197   6                  if (ep != 0) //Control Endp will ingore the double buffer setting
 198   6                  {
 199   7                    ep_dbuf = DA_EP_CFGR_DBUF_SET;
 200   7                  }
 201   6                }
 202   5                else
 203   5                {
 204   6                  ep_dbuf = DA_EP_CFGR_DBUF_RESET;
 205   6                }
 206   5                
 207   5                //Check DIR
 208   5                if (USBDC_Device[devinx].EndpAddr[ep] & USBDC_TABLE_DIR_MASK) //OUT-0,IM-1
 209   5                {
 210   6                  ep_dir = DA_EP_CFGR_DIR_IN;
 211   6                }
 212   5                else
 213   5                {
 214   6                  ep_dir = DA_EP_CFGR_DIR_OUT;
 215   6                  index=ep+1;
 216   6                  if (index < USBDC_Device[devinx].EndpNum)
 217   6                  {
 218   7                    if ((USBDC_Device[devinx].EndpAddr[index] & 0x0f) == (USBDC_Device[devinx].EndpAddr[ep] & 0x0f))
 219   7                    {
 220   8                      continue;
 221   8                    } 
 222   7                  }   
C51 COMPILER V9.60.7.0   USBDC_VIRTUAL_CORE                                                06/18/2026 10:50:18 PAGE 5   

 223   6                }
 224   5                
 225   5                //Check ISO
 226   5                if (USBDC_Device[devinx].EndpAddr[ep] & USBDC_TABLE_ISO_MASK) //OUT-0,IM-1
 227   5                {
 228   6                  ep_iso = DA_EP_CFGR_ISOCH_SET;
 229   6                }
 230   5                else
 231   5                {
 232   6                  ep_iso = DA_EP_CFGR_ISOCH_RESET;
 233   6                }
 234   5      
 235   5                //Check prefetch
 236   5                if ((ep_iso == DA_EP_CFGR_ISOCH_SET) && (ep_dir == DA_EP_CFGR_DIR_IN))
 237   5                {
 238   6                  prefetch[pinx] = DC_IEPPR_ENABLE_SET | (devinx << 4) | (USBDC_Device[devinx].EndpAddr[ep] & 0x0f);
 239   6                }
 240   5      
 241   5                //---------------------------------------------
 242   5                //Test Only if the ISO port enable the endpoint
 243   5                enable_bit = DA_EP_CFGR_EPEN_SET;
 244   5      
 245   5      #if (SYSTEM_USBAUDIO_DEVICE_SUPPORT)
                        if (ep) // not include control endpoint pipe
                        {
                          if (USB_PDevice[devinx].DevClass == USB_AUDIO_CLASS)
                          {
                            if (ep_iso == DA_EP_CFGR_ISOCH_SET)
                            {
                              if (pinx != KVM_CurrentUSBAudio)
                              {
                                enable_bit = DA_EP_CFGR_EPEN_RESET;
                              }
                            }
                          }
                        }
              #endif
 260   5                reg0 = (USBDC_Device[devinx].EndpAddr[ep] & 0x0f) | enable_bit | ep_dbuf | ep_dir | ep_iso;
 261   5                ep_pksize = USBDC_REGS_Get_Pkt_Size(ep_iso,USBDC_Device[devinx].EndpMaxSize[ep]);
 262   5                
 263   5      #if ((SYSTEM_MSC_DEVICE_SUPPORT || SYSTEM_EXTENDER_MSC_SUPPORT) && (SYSTEM_USB_HC_BURST))
                        //Check Burst Mode
                        if (USBDC_Device[devinx].EndpAddr[ep] & USBDC_TABLE_BURST_MASK) //
                        {
                          ep_pksize |= DA_EP_CFGR_BUREN_SET;
                        }
              #endif /* # if ((SYSTEM_MSC_DEVICE_SUPPORT || SYSTEM_EXTENDER_MSC_SUPPORT) && (SYSTEM_USB_HC_BURST)) */
 270   5                
 271   5                //Write into Register
 272   5                USBDC_EPCFGR_Write(pinx,devinx,ep,reg0,ep_pksize);
 273   5                USBDC_REGS_Endp_Reset(pinx, devinx, ep);
 274   5              }
 275   4            }
 276   3            
 277   3            //-------------------------------------------------
 278   3            //2.Assign IDCFGR->Device Address
 279   3            USBDC_REGS_Address_Write(pinx,devinx,address);
 280   3      
 281   3            //-------------------------------------------------
 282   3            //3.Assign DCIEPPR->Prefetch
 283   3            if (prefetch[pinx])
 284   3            {
C51 COMPILER V9.60.7.0   USBDC_VIRTUAL_CORE                                                06/18/2026 10:50:18 PAGE 6   

 285   4              USBDC_Write_Regs(pinx, DCIEPPR, &prefetch[pinx], 1);
 286   4            }
 287   3          }
 288   2          
 289   2          // Check Terminate condition
 290   2          active_port &= ~MOUNT_PORT[pinx];
 291   2          if (active_port == 0)
 292   2          {
 293   3            break;
 294   3          }
 295   2        }
 296   1      }
